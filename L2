# ---------- Profile actions ----------
function ApplyProfile($profile) {
    if(-not (Prepare)){return}
    $targets=@()
    switch($profile){
        "SAFE"       {$targets=@{safe=1}}
        "GAMING"     {$targets=@{gaming=1}}
        "AGGRESSIVE" {$targets=@{aggressive=1}}
        "LARZ1"      {$targets=@{safe=1}}
    }
    $rows=$svcRows
    $total=$rows.Count;$i=0
    foreach($r in $rows){
        $i++
        $s=$r.Data
        if($r.Check.Checked){
            $mode = if($profile -eq "GAMING"){$s[4]}elseif($profile -eq "AGGRESSIVE"){$s[5]}else{$s[3]}
            SetMode $s[0] $mode | Out-Null
        }
        SetStatus "Services $i/$total" ([int](($i/$total)*60))
    }
    if($profile -in @("LARZ1","SAFE","GAMING","AGGRESSIVE")){
        PrivacyTweaks
        GameTweaks
        WindowsTweaks
    }
    SetStatus "เสร็จสิ้น" 100
    AddLog "Profile $profile completed."
    RefreshServices
}
function RefreshServices {
    foreach($r in $svcRows){
        $r.Current.Text="Current: "+(Mode $r.Data[0])
        $r.Target.Text="LARZ1: "+$r.Data[3]
    }
}
function Confirm-Action($title,$message) {
    $r=[Windows.Forms.MessageBox]::Show(
        $message,
        "LARZ1 $title",
        [Windows.Forms.MessageBoxButtons]::YesNo,
        [Windows.Forms.MessageBoxIcon]::Warning
    )
    return ($r -eq [Windows.Forms.DialogResult]::Yes)
}
function RestoreFactoryBaseline {
    $file=Join-Path $BackupRoot "FactoryBaseline.json"
    if(-not(Test-Path $file)){
        [Windows.Forms.MessageBox]::Show(
            "ยังไม่มี Factory Baseline ของเครื่องนี้",
            "LARZ1",
            [Windows.Forms.MessageBoxButtons]::OK,
            [Windows.Forms.MessageBoxIcon]::Information
        )|Out-Null
        return
    }
    if(-not (Confirm-Action "Factory Baseline" "จะคืนค่า StartupType ของ service ที่ LARZ1 เก็บไว้ตอนเปิดโปรแกรมครั้งแรก`n`nดำเนินการต่อหรือไม่?")){return}
    try{$rows=Get-Content $file -Raw|ConvertFrom-Json}catch{AddLog "Factory baseline read failed.";return}
    $n=@($rows).Count;$i=0
    foreach($x in @($rows)){
        $i++;SetMode $x.Name $x.Mode|Out-Null
        SetStatus "Factory restore $i/$n" ([int](($i/$n)*100))
    }
    SetStatus "Factory baseline restored" 100
    AddLog "Factory baseline restored."
    RefreshServices
}
function RestoreLast {
    $dirs=Get-ChildItem $BackupRoot -Directory -ErrorAction SilentlyContinue | Sort-Object Name -Descending
    $file=$null
    foreach($d in $dirs){
        $candidate=Join-Path $d.FullName "services.json"
        if(Test-Path $candidate){$file=$candidate;break}
    }
    if(-not $file){
        [Windows.Forms.MessageBox]::Show("ไม่พบ service backup","LARZ1 Restore",[Windows.Forms.MessageBoxButtons]::OK,[Windows.Forms.MessageBoxIcon]::Information)|Out-Null
        return
    }
    if(-not (Confirm-Action "Restore" "จะคืนค่า StartupType ของ services จาก backup ล่าสุด`n`nดำเนินการต่อหรือไม่?")){return}
    $rows=Get-Content $file -Raw | ConvertFrom-Json
    $n=$rows.Count;$i=0
    foreach($x in $rows){
        $i++;SetMode $x.Name $x.Mode | Out-Null
        SetStatus "Restoring $i/$n" ([int](($i/$n)*100))
    }
    SetStatus "Restore complete" 100
    RefreshServices
}
function ApplySelected {
    if(-not (Prepare)){return}
    $svcTotal=($svcRows|Where-Object{$_.Check.Checked}).Count
    $appTotal=($appChecks|Where-Object{$_.Checked}).Count
    $total=[Math]::Max(1,$svcTotal+$appTotal+5);$i=0
    foreach($r in $svcRows){
        if($r.Check.Checked){
            $i++;SetMode $r.Data[0] $r.Data[3]|Out-Null
            SetStatus "Service $i/$total" ([int](($i/$total)*100))
        }
    }
    foreach($a in $appChecks){
        if($a.Checked){
            $i++;RemoveApp $a.Tag
            SetStatus "App $i/$total" ([int](($i/$total)*100))
        }
    }
    # Registry options
    if($registryChecks[0].Checked){
        RegDword "HKCU:\Software\Microsoft\Windows\CurrentVersion\Explorer\Advanced" "HideFileExt" 0
    } else {
        RegDword "HKCU:\Software\Microsoft\Windows\CurrentVersion\Explorer\Advanced" "HideFileExt" 1
    }
    if($registryChecks[1].Checked){
        RegDword "HKCU:\Software\Microsoft\Windows\CurrentVersion\Explorer\Advanced" "ShowTaskViewButton" 1
    } else {
        RegDword "HKCU:\Software\Microsoft\Windows\CurrentVersion\Explorer\Advanced" "ShowTaskViewButton" 0
    }

    # Privacy options
    if($privacyChecks[0].Checked){PrivacyTweaks}
    if($privacyChecks[2].Checked){SetMode "WerSvc" "Manual"|Out-Null}

    # Gaming options
    if($gamingChecks[0].Checked){GameTweaks}
    if($gamingChecks[1].Checked){
        foreach($r in $svcRows){
            if($r.Check.Checked){SetMode $r.Data[0] $r.Data[4]|Out-Null}
        }
    }

    # Network options
    if($networkChecks[0].Checked){NetworkTweaks}
    SetStatus "เสร็จสิ้น" 100
    AddLog "Selected changes completed."
    RefreshServices
}

