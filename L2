# ---------- Robust mouse wheel ----------
function WheelScroll($panel,$e){
    if(-not $panel.AutoScroll){return}
    $delta=[int]($e.Delta / 2)
    $current=-$panel.AutoScrollPosition.Y
    $target=$current-$delta
    if($target -lt 0){$target=0}
    $max=[Math]::Max(0,$panel.VerticalScroll.Maximum-$panel.VerticalScroll.LargeChange+1)
    if($target -gt $max){$target=$max}
    $panel.AutoScrollPosition=New-Object Drawing.Point(0,$target)
}
$wheelHandler = {
    param($sender,$e)
    WheelScroll $sender $e
    $e.Handled=$true
}
foreach($sp in @($appScroll,$svcScroll)){
    $sp.Add_MouseWheel($wheelHandler)
    foreach($child in $sp.Controls){
        $child.Add_MouseWheel($wheelHandler)
        foreach($grand in $child.Controls){$grand.Add_MouseWheel($wheelHandler)}
    }
}

