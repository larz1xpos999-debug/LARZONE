# ---------- Helpers ----------
function Label($text,$x,$y,$w,$h,$size=10,$color=$C.white) {
    $l = New-Object Windows.Forms.Label
    $l.Text=$text; $l.Location=New-Object Drawing.Point($x,$y)
    $l.Size=New-Object Drawing.Size($w,$h)
    $l.Font=New-Object Drawing.Font($Font,$size)
    $l.ForeColor=$color; $l.BackColor=[Drawing.Color]::Transparent
    return $l
}
function Button($text,$x,$y,$w,$h) {
    $b=New-Object Windows.Forms.Button
    $b.Text=$text; $b.Location=New-Object Drawing.Point($x,$y)
    $b.Size=New-Object Drawing.Size($w,$h)
    $b.FlatStyle="Flat"; $b.FlatAppearance.BorderColor=$C.line
    $b.BackColor=$C.card2; $b.ForeColor=$C.white
    $b.Font=New-Object Drawing.Font($Font,9,[Drawing.FontStyle]::Regular)
    $b.Cursor=[Windows.Forms.Cursors]::Hand
    return $b
}
function AddLog($s) {
    if($script:LogBox){
        $script:LogBox.AppendText("[$(Get-Date -Format HH:mm:ss)] $s`r`n")
        $script:LogBox.SelectionStart=$script:LogBox.TextLength
        $script:LogBox.ScrollToCaret()
    }
}
function SetStatus($s,$pct=-1) {
    if($script:StatusLabel){$script:StatusLabel.Text=$s}
    if($pct -ge 0 -and $script:Progress){$script:Progress.Value=[Math]::Min(100,[Math]::Max(0,$pct))}
    [Windows.Forms.Application]::DoEvents()
}
function Mode($name) {
    try {
        $x=Get-CimInstance Win32_Service -Filter "Name='$name'" -ErrorAction Stop
        switch($x.StartMode){"Auto"{"Automatic";break}"Manual"{"Manual";break}"Disabled"{"Disabled";break}default{$x.StartMode}}
    } catch {"Not Installed"}
}
function State($name) {
    try {(Get-Service -Name $name -ErrorAction Stop).Status.ToString()} catch {"Not Installed"}
}
function SetMode($name,$mode) {
    if($Protected -contains $name){AddLog "SKIP protected: $name";return $false}
    try {
        $svc=Get-Service -Name $name -ErrorAction Stop
        Set-Service -Name $name -StartupType $mode -ErrorAction Stop
        if($mode -eq "Disabled" -and $svc.Status -eq "Running"){Stop-Service -Name $name -Force -ErrorAction SilentlyContinue}
        AddLog "$name -> $mode"
        return $true
    } catch {AddLog "FAILED $name : $($_.Exception.Message)";return $false}
}
function RestorePoint {
    try {
        Enable-ComputerRestore -Drive "$($env:SystemDrive)\" -ErrorAction SilentlyContinue
        Checkpoint-Computer -Description "LARZ1 Debloat" -RestorePointType MODIFY_SETTINGS -ErrorAction Stop
        AddLog "Restore Point created"; return $true
    } catch {AddLog "Restore Point unavailable"; return $false}
}
function BackupServices {
    $stamp=Get-Date -Format "yyyyMMdd_HHmmss"
    $dir=Join-Path $BackupRoot $stamp
    New-Item -ItemType Directory -Path $dir -Force | Out-Null
    $rows=@()
    foreach($s in $Services){
        $n=$s[0]; $m=Mode $n
        if($m -ne "Not Installed"){$rows += [pscustomobject]@{Name=$n;Mode=$m;State=(State $n)}}
    }
    $rows | ConvertTo-Json -Depth 3 | Set-Content (Join-Path $dir "services.json") -Encoding UTF8
    AddLog "Service backup: $dir"
    return $dir
}
function BackupRegistry {
    $stamp=Get-Date -Format "yyyyMMdd_HHmmss"
    $dir=Join-Path $BackupRoot $stamp
    New-Item -ItemType Directory -Path $dir -Force | Out-Null
    $keys=@(
      "HKCU\Software\Microsoft\Windows\CurrentVersion\ContentDeliveryManager",
      "HKCU\Software\Microsoft\Windows\CurrentVersion\GameConfigStore",
      "HKCU\Software\Microsoft\Windows\CurrentVersion\GameDVR",
      "HKCU\Software\Microsoft\Windows\CurrentVersion\Explorer\Advanced",
      "HKLM\SOFTWARE\Policies\Microsoft\Windows\DataCollection",
      "HKLM\SOFTWARE\Policies\Microsoft\Windows\GameDVR"
    )
    foreach($k in $keys){
        $f=Join-Path $dir (($k -replace '[\\:]','_')+".reg")
        & reg.exe export $k $f /y 2>$null | Out-Null
    }
    AddLog "Registry backup: $dir"
}
function Prepare {
    if($script:RequireRestore.Checked){
        if(-not (RestorePoint)){
            [Windows.Forms.MessageBox]::Show("Restore Point สร้างไม่ได้ จึงยกเลิกการเปลี่ยนแปลง","LARZ1 Safety Gate",[Windows.Forms.MessageBoxButtons]::OK,[Windows.Forms.MessageBoxIcon]::Error)|Out-Null
            return $false
        }
    } else { RestorePoint | Out-Null }
    BackupServices | Out-Null
    BackupRegistry
    return $true
}

# ---------- Registry tweaks ----------
function RegDword($path,$name,$value) {
    try{
        if(-not(Test-Path $path)){New-Item $path -Force|Out-Null}
        New-ItemProperty $path $name -PropertyType DWord -Value $value -Force|Out-Null
        AddLog "Registry $name = $value"
    }catch{AddLog "Registry FAILED: $name"}
}
function PrivacyTweaks {
    $p="HKCU:\Software\Microsoft\Windows\CurrentVersion\ContentDeliveryManager"
    foreach($n in @("ContentDeliveryAllowed","OemPreInstalledAppsEnabled","PreInstalledAppsEnabled","PreInstalledAppsEverEnabled","SilentInstalledAppsEnabled","SystemPaneSuggestionsEnabled","SubscribedContent-338388Enabled","SubscribedContent-353694Enabled")){RegDword $p $n 0}
    RegDword "HKLM:\SOFTWARE\Policies\Microsoft\Windows\DataCollection" "AllowTelemetry" 0
}
function GameTweaks {
    RegDword "HKCU:\System\GameConfigStore" "GameDVR_Enabled" 0
    RegDword "HKCU:\Software\Microsoft\Windows\CurrentVersion\GameDVR" "AppCaptureEnabled" 0
    RegDword "HKLM:\SOFTWARE\Policies\Microsoft\Windows\GameDVR" "AllowGameDVR" 0
}
function WindowsTweaks {
    RegDword "HKCU:\Software\Microsoft\Windows\CurrentVersion\Explorer\Advanced" "HideFileExt" 0
    RegDword "HKCU:\Software\Microsoft\Windows\CurrentVersion\Explorer\Advanced" "ShowTaskViewButton" 1
}
function NetworkTweaks {
    RegDword "HKLM:\SYSTEM\CurrentControlSet\Services\Tcpip\Parameters" "Tcp1323Opts" 1
}

# ---------- App removal ----------
function RemoveApp($pattern) {
    try{
        $pkgs=Get-AppxPackage -AllUsers -Name $pattern -ErrorAction SilentlyContinue
        if(-not $pkgs){AddLog "App not installed: $pattern";return}
        foreach($p in $pkgs){
            try{
                Remove-AppxPackage -Package $p.PackageFullName -AllUsers -ErrorAction Stop
                AddLog "Removed: $pattern"
            }catch{AddLog "App remove failed: $pattern"}
        }
    }catch{AddLog "App query failed: $pattern"}
}

