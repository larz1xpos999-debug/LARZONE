function New-Label($text,$x,$y,$w,$h,$size=10,$color=$FG) {
    $l = New-Object Windows.Forms.Label
    $l.Text=$text; $l.Location=New-Object Drawing.Point($x,$y)
    $l.Size=New-Object Drawing.Size($w,$h); $l.ForeColor=$color
    $l.BackColor=[Drawing.Color]::Transparent
    $l.Font=New-Object Drawing.Font("Segoe UI",$size)
    return $l
}

function Add-Log($text) {
    if ($script:logBox) {
        $script:logBox.AppendText("[$(Get-Date -Format HH:mm:ss)] $text`r`n")
        $script:logBox.SelectionStart=$script:logBox.TextLength
        $script:logBox.ScrollToCaret()
    }
}

function Set-Progress($n,$text) {
    $script:progress.Value=[Math]::Max(0,[Math]::Min(100,[int]$n))
    $script:status.Text=$text
    [Windows.Forms.Application]::DoEvents()
}

function Add-RestorePoint {
    try {
        Enable-ComputerRestore -Drive "$($env:SystemDrive)\" -ErrorAction SilentlyContinue
        Checkpoint-Computer -Description "LARZ1 Debloat v0.2" -RestorePointType MODIFY_SETTINGS -ErrorAction Stop
        Add-Log "Restore point created."
    } catch {
        Add-Log "Restore point unavailable: $($_.Exception.Message)"
    }
}

