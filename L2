# ---------- Events ----------
$selectAll.Add_Click({
    foreach ($cb in $checks.Values) { $cb.Checked = $true }
})

$clear.Add_Click({
    foreach ($cb in $checks.Values) { $cb.Checked = $false }
})

$apply.Add_Click({
    $selected = @()
    foreach ($opt in $options) {
        if ($checks[$opt.Id].Checked) { $selected += $opt }
    }

    if ($selected.Count -eq 0) {
        [System.Windows.Forms.MessageBox]::Show(
            "ยังไม่ได้เลือกรายการใด",
            "LARZ1 Debloat",
            [System.Windows.Forms.MessageBoxButtons]::OK,
            [System.Windows.Forms.MessageBoxIcon]::Information
        ) | Out-Null
        return
    }

    $answer = [System.Windows.Forms.MessageBox]::Show(
        "จะใช้การเปลี่ยนแปลง $($selected.Count) รายการ`n`nแนะนำให้สร้าง Restore Point ก่อนดำเนินการ`n`nดำเนินการต่อหรือไม่?",
        "Confirm",
        [System.Windows.Forms.MessageBoxButtons]::YesNo,
        [System.Windows.Forms.MessageBoxIcon]::Warning
    )

    if ($answer -ne [System.Windows.Forms.DialogResult]::Yes) { return }

    $apply.Enabled = $false
    $selectAll.Enabled = $false
    $clear.Enabled = $false

    Add-Log "=== LARZ1 Debloat started ==="
    Add-RestorePoint

    $total = $selected.Count
    $i = 0

    foreach ($opt in $selected) {
        $i++
        $pct = [int](($i - 1) / $total * 100)
        Set-Progress $pct "Applying: $($opt.Name)"
        Add-Log "Applying: $($opt.Name)"

        try {
            & $opt.Action
        } catch {
            Add-Log "FAILED: $($opt.Name) - $($_.Exception.Message)"
        }

        $pct2 = [int]($i / $total * 100)
        Set-Progress $pct2 "Completed: $($opt.Name)"
    }

    Set-Progress 100 "Done"
    Add-Log "=== LARZ1 Debloat completed ==="

    [System.Windows.Forms.MessageBox]::Show(
        "ดำเนินการเสร็จแล้ว`n`nดูรายละเอียดได้จาก Log ด้านล่าง",
        "LARZ1 Debloat",
        [System.Windows.Forms.MessageBoxButtons]::OK,
        [System.Windows.Forms.MessageBoxIcon]::Information
    ) | Out-Null

    $apply.Enabled = $true
    $selectAll.Enabled = $true
    $clear.Enabled = $true
})

# Keep scrolling smooth when mouse is over child controls.
$scroll.Add_MouseWheel({
    param($sender,$e)
    $scroll.AutoScrollPosition = New-Object System.Drawing.Point(
        (-$scroll.AutoScrollPosition.X),
        [Math]::Max(0, (-$scroll.AutoScrollPosition.Y) - $e.Delta)
    )
})

Add-Log "Ready. Select changes and click APPLY SELECTED."
[void]$form.ShowDialog()
