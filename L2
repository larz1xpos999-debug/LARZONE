function Get-ServiceStartMode($name) {
    try {
        $svc = Get-CimInstance Win32_Service -Filter "Name='$name'" -ErrorAction Stop
        switch ($svc.StartMode) {
            'Auto' { return 'Automatic' }
            'Manual' { return 'Manual' }
            'Disabled' { return 'Disabled' }
            default { return $svc.StartMode }
        }
    } catch { return 'N/A' }
}

function Set-ServiceMode($name,$mode) {
    if ($ProtectedServices -contains $name) {
        Add-Log "SKIP protected service: $name"
        return
    }
    $svc = Get-Service -Name $name -ErrorAction SilentlyContinue
    if (-not $svc) { Add-Log "Not installed: $name"; return }

    try {
        Set-Service -Name $name -StartupType $mode -ErrorAction Stop
        if ($mode -eq 'Disabled' -and $svc.Status -eq 'Running') {
            Stop-Service -Name $name -Force -ErrorAction SilentlyContinue
        }
        Add-Log "$name -> $mode"
    } catch {
        Add-Log "FAILED $name -> $mode : $($_.Exception.Message)"
    }
}

# -----------------------------
# Registry helpers
# -----------------------------
function Set-RegDword($path,$name,$value) {
    try {
        if (-not (Test-Path $path)) { New-Item -Path $path -Force | Out-Null }
        New-ItemProperty -Path $path -Name $name -PropertyType DWord -Value $value -Force | Out-Null
        Add-Log "Registry: $name = $value"
    } catch { Add-Log "Registry failed: $name" }
}

function Disable-ConsumerExperiences {
    Set-RegDword "HKCU:\Software\Microsoft\Windows\CurrentVersion\ContentDeliveryManager" "ContentDeliveryAllowed" 0
    Set-RegDword "HKCU:\Software\Microsoft\Windows\CurrentVersion\ContentDeliveryManager" "OemPreInstalledAppsEnabled" 0
    Set-RegDword "HKCU:\Software\Microsoft\Windows\CurrentVersion\ContentDeliveryManager" "PreInstalledAppsEnabled" 0
    Set-RegDword "HKCU:\Software\Microsoft\Windows\CurrentVersion\ContentDeliveryManager" "PreInstalledAppsEverEnabled" 0
    Set-RegDword "HKCU:\Software\Microsoft\Windows\CurrentVersion\ContentDeliveryManager" "SilentInstalledAppsEnabled" 0
    Set-RegDword "HKCU:\Software\Microsoft\Windows\CurrentVersion\ContentDeliveryManager" "SystemPaneSuggestionsEnabled" 0
}

function Disable-GameDVR {
    Set-RegDword "HKCU:\System\GameConfigStore" "GameDVR_Enabled" 0
    Set-RegDword "HKCU:\Software\Microsoft\Windows\CurrentVersion\GameDVR" "AppCaptureEnabled" 0
    Set-RegDword "HKLM:\SOFTWARE\Policies\Microsoft\Windows\GameDVR" "AllowGameDVR" 0
}

function Disable-TelemetryPolicy {
    Set-RegDword "HKLM:\SOFTWARE\Policies\Microsoft\Windows\DataCollection" "AllowTelemetry" 0
}

function Disable-Suggestions {
    Disable-ConsumerExperiences
    Set-RegDword "HKCU:\Software\Microsoft\Windows\CurrentVersion\Explorer\Advanced" "ShowTaskViewButton" 0
}

function Show-Extensions {
    Set-RegDword "HKCU:\Software\Microsoft\Windows\CurrentVersion\Explorer\Advanced" "HideFileExt" 0
}

