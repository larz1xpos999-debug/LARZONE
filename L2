function Remove-AppSafe($pattern) {
    try {
        Get-AppxPackage -AllUsers -Name $pattern -ErrorAction SilentlyContinue |
            ForEach-Object {
                Add-Log "Removing Appx: $($_.Name)"
                Remove-AppxPackage -Package $_.PackageFullName -AllUsers -ErrorAction SilentlyContinue
            }
    } catch { Add-Log "App removal skipped: $pattern" }
}

# -----------------------------
# Default profile
# -----------------------------
function Apply-Windows11Default {
    Add-Log "Applying LARZ1 DEFAULT profile..."
    Set-Progress 5 "Creating restore point..."
    Add-RestorePoint

    # Default = conservative Windows 11 style baseline:
    # do not disable core services; only optional/telemetry/UX items.
    Set-Progress 20 "Default: privacy..."
    Disable-TelemetryPolicy
    Disable-ConsumerExperiences
    Disable-Suggestions
    Show-Extensions

    Set-Progress 45 "Default: Game DVR..."
    Disable-GameDVR

    Set-Progress 60 "Default: optional services..."
    foreach ($s in $Services | Where-Object { $_.Category -eq 'Gaming' -or $_.Category -eq 'Privacy' }) {
        Set-ServiceMode $s.Name $s.Safe
    }

    Set-Progress 80 "Default: removing selected bloatware..."
    foreach ($a in $Apps) { Remove-AppSafe $a }

    Set-Progress 100 "DEFAULT complete"
    Add-Log "Default profile complete. Restart Windows for all changes to settle."
}

function Apply-ServiceProfile($profile) {
    Add-Log "Applying service profile: $profile"
    Add-RestorePoint
    $i=0
    $list=@($Services)
    foreach ($s in $list) {
        $i++
        $mode = $s.$profile
        if ($mode) {
            Set-ServiceMode $s.Name $mode
        }
        Set-Progress (($i/$list.Count)*100) "$profile services: $($s.Display)"
    }
    Add-Log "$profile service profile complete."
}

