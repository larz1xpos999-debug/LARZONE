# ---------- Helpers ----------
function Add-Log {
    param([string]$Text)
    if ($script:LogBox -and -not $script:LogBox.IsDisposed) {
        $script:LogBox.AppendText("[$(Get-Date -Format 'HH:mm:ss')] $Text`r`n")
        $script:LogBox.SelectionStart = $script:LogBox.TextLength
        $script:LogBox.ScrollToCaret()
        [System.Windows.Forms.Application]::DoEvents()
    }
}

function Set-Progress {
    param([int]$Value, [string]$Text)
    $v = [Math]::Max(0, [Math]::Min(100, $Value))
    if ($script:ProgressBar) { $script:ProgressBar.Value = $v }
    if ($script:ProgressLabel) { $script:ProgressLabel.Text = "$v%  $Text" }
    [System.Windows.Forms.Application]::DoEvents()
}

function Add-RestorePoint {
    try {
        Add-Log "Creating restore point..."
        Checkpoint-Computer -Description "LARZ1 Debloat Backup" -RestorePointType "MODIFY_SETTINGS" -ErrorAction Stop
        Add-Log "Restore point created."
        return $true
    } catch {
        Add-Log "Restore point skipped: $($_.Exception.Message)"
        return $false
    }
}

function Remove-AppSafe {
    param([string]$NamePattern)

    $packages = Get-AppxPackage -AllUsers -ErrorAction SilentlyContinue |
        Where-Object { $_.Name -like $NamePattern }

    if (-not $packages) {
        Add-Log "Not installed: $NamePattern"
        return
    }

    foreach ($pkg in $packages) {
        try {
            Remove-AppxPackage -Package $pkg.PackageFullName -AllUsers -ErrorAction Stop
            Add-Log "Removed: $($pkg.Name)"
        } catch {
            Add-Log "Skipped: $($pkg.Name) - $($_.Exception.Message)"
        }
    }
}

function Disable-RegistryValue {
    param([string]$Path, [string]$Name, [object]$Value, [Microsoft.Win32.RegistryValueKind]$Type = [Microsoft.Win32.RegistryValueKind]::DWord)

    try {
        if (-not (Test-Path $Path)) { New-Item -Path $Path -Force | Out-Null }
        New-ItemProperty -Path $Path -Name $Name -Value $Value -PropertyType $Type -Force | Out-Null
        Add-Log "Registry: $Path\$Name = $Value"
    } catch {
        Add-Log "Registry failed: $Path\$Name"
    }
}

# ---------- Options ----------
$options = @(
    [pscustomobject]@{ Id='Xbox';        Category='Apps';    Name='Remove Xbox Apps';             Desc='Remove Xbox-related AppX packages';        Action={ Remove-AppSafe '*Xbox*' } }
    [pscustomobject]@{ Id='Clipchamp';   Category='Apps';    Name='Remove Clipchamp';              Desc='Remove Microsoft Clipchamp';                Action={ Remove-AppSafe '*Clipchamp*' } }
    [pscustomobject]@{ Id='Solitaire';   Category='Apps';    Name='Remove Solitaire';              Desc='Remove Microsoft Solitaire Collection';     Action={ Remove-AppSafe '*Solitaire*' } }
    [pscustomobject]@{ Id='Teams';       Category='Apps';    Name='Remove Teams (consumer)';       Desc='Remove consumer Teams package';             Action={ Remove-AppSafe '*MSTeams*' } }

    [pscustomobject]@{ Id='Consumer';    Category='Windows'; Name='Disable Consumer Experiences';   Desc='Reduce automatic suggested app installs'; Action={
        Disable-RegistryValue 'HKLM:\SOFTWARE\Policies\Microsoft\Windows\CloudContent' 'DisableWindowsConsumerFeatures' 1
    }}
    [pscustomobject]@{ Id='Suggestions'; Category='Windows'; Name='Disable Suggested Content';      Desc='Reduce suggested content in Windows';       Action={
        Disable-RegistryValue 'HKCU:\Software\Microsoft\Windows\CurrentVersion\ContentDeliveryManager' 'SubscribedContent-338388Enabled' 0
        Disable-RegistryValue 'HKCU:\Software\Microsoft\Windows\CurrentVersion\ContentDeliveryManager' 'SubscribedContent-338389Enabled' 0
        Disable-RegistryValue 'HKCU:\Software\Microsoft\Windows\CurrentVersion\ContentDeliveryManager' 'SubscribedContent-353698Enabled' 0
    }}
    [pscustomobject]@{ Id='DVR';         Category='Gaming';  Name='Disable Game DVR';               Desc='Disable background Game DVR recording';     Action={
        Disable-RegistryValue 'HKCU:\System\GameConfigStore' 'GameDVR_Enabled' 0
        Disable-RegistryValue 'HKCU:\SOFTWARE\Microsoft\Windows\CurrentVersion\GameDVR' 'AppCaptureEnabled' 0
        Disable-RegistryValue 'HKLM:\SOFTWARE\Policies\Microsoft\Windows\GameDVR' 'AllowGameDVR' 0
    }}
    [pscustomobject]@{ Id='Background';  Category='Privacy'; Name='Limit Background Apps';          Desc='Disable broad background app execution policy'; Action={
        Disable-RegistryValue 'HKLM:\SOFTWARE\Policies\Microsoft\Windows\AppPrivacy' 'LetAppsRunInBackground' 2
    }}
)

