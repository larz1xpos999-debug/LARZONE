#requires -version 5.1
<#
FiveM Debloat & Fix Tool (GUI)
- ล้างแคช/ไฟล์ชั่วคราวของ FiveM แบบปลอดภัย
- ปรับ gta5_settings.xml ให้ VideoCardDescription ตรงกับการ์ดจอที่ Windows ตรวจพบ
- ตัวเลือกปรับแต่งระบบบางอย่าง (อาจต้องสิทธิ์แอดมิน)

หมายเหตุ:
1) เครื่องมือจะลบเฉพาะ "แคช/ไฟล์ชั่วคราว" ของ FiveM เท่านั้น ไม่แตะไฟล์เกม GTA V
2) แนะนำให้ปิด FiveM ก่อนกดเริ่มทำงาน
#>

Add-Type -AssemblyName System.Windows.Forms
Add-Type -AssemblyName System.Drawing

[System.Windows.Forms.Application]::EnableVisualStyles()

function Test-IsAdmin {
    try {
        $currentIdentity = [Security.Principal.WindowsIdentity]::GetCurrent()
        $principal = New-Object Security.Principal.WindowsPrincipal($currentIdentity)
        return $principal.IsInRole([Security.Principal.WindowsBuiltInRole]::Administrator)
    } catch {
        return $false
    }
}

function Get-GpuName {
    try {
        $name = (Get-CimInstance Win32_VideoController | Select-Object -First 1 -ExpandProperty Name)
        if ([string]::IsNullOrWhiteSpace($name)) { return "Unknown GPU" }
        return $name.Trim()
    } catch {
        return "Unknown GPU"
    }
}

function Write-Log {
    param(
        [Parameter(Mandatory=$true)][System.Windows.Forms.TextBox]$LogBox,
        [Parameter(Mandatory=$true)][string]$Message,
        [ValidateSet("INFO","OK","WARN","ERR")][string]$Level = "INFO"
    )
    $ts = (Get-Date).ToString("yyyy-MM-dd HH:mm:ss")
    $line = "[$ts][$Level] $Message"
    $LogBox.AppendText($line + [Environment]::NewLine)
    $LogBox.SelectionStart = $LogBox.TextLength
    $LogBox.ScrollToCaret()
}

function Ensure-Dir {
    param([Parameter(Mandatory=$true)][string]$Path)
    if (-not (Test-Path -LiteralPath $Path)) {
        New-Item -ItemType Directory -Path $Path -Force | Out-Null
    }
}

function Remove-PathSafe {
    param(
        [Parameter(Mandatory=$true)][string]$Path,
        [Parameter(Mandatory=$true)][System.Windows.Forms.TextBox]$LogBox
    )
    if (-not (Test-Path -LiteralPath $Path)) {
        Write-Log -LogBox $LogBox -Level "WARN" -Message "ไม่พบพาธ: $Path"
        return
    }
    try {
        # ลบโฟลเดอร์/ไฟล์แบบปลอดภัย
        Remove-Item -LiteralPath $Path -Recurse -Force -ErrorAction Stop
        Write-Log -LogBox $LogBox -Level "OK" -Message "ลบแล้ว: $Path"
    } catch {
        Write-Log -LogBox $LogBox -Level "ERR" -Message "ลบไม่สำเร็จ: $Path | $($_.Exception.Message)"
    }
}

function Backup-File {
    param(
        [Parameter(Mandatory=$true)][string]$FilePath,
        [Parameter(Mandatory=$true)][System.Windows.Forms.TextBox]$LogBox
    )
    if (-not (Test-Path -LiteralPath $FilePath)) { return $null }
    try {
        $dir = Split-Path -Parent $FilePath
        $name = Split-Path -Leaf $FilePath
        $stamp = (Get-Date).ToString("yyyyMMdd_HHmmss")
        $bak = Join-Path $dir "$name.bak.$stamp"
        Copy-Item -LiteralPath $FilePath -Destination $bak -Force
        Write-Log -LogBox $LogBox -Level "OK" -Message "สำรองไฟล์แล้ว: $bak"
        return $bak
    } catch {
        Write-Log -LogBox $LogBox -Level "ERR" -Message "สำรองไฟล์ไม่สำเร็จ: $FilePath | $($_.Exception.Message)"
        return $null
    }
}

function Update-GTA5Settings-VideoCardDescription {
    param(
        [Parameter(Mandatory=$true)][string]$CitizenFxPath,
        [Parameter(Mandatory=$true)][string]$GpuName,
        [Parameter(Mandatory=$true)][System.Windows.Forms.TextBox]$LogBox
    )

    $target = Join-Path $CitizenFxPath "gta5_settings.xml"

    if (-not (Test-Path -LiteralPath $CitizenFxPath)) {
        Write-Log -LogBox $LogBox -Level "ERR" -Message "ไม่พบโฟลเดอร์ CitizenFX: $CitizenFxPath"
        return $false
    }

    if (-not (Test-Path -LiteralPath $target)) {
        Write-Log -LogBox $LogBox -Level "WARN" -Message "ไม่พบไฟล์ gta5_settings.xml ใน CitizenFX (จะสร้างไฟล์ใหม่ให้)"
    } else {
        Backup-File -FilePath $target -LogBox $LogBox | Out-Null
    }

    try {
        # ถ้าไฟล์มีอยู่แล้วให้แก้เฉพาะแท็ก VideoCardDescription
        if (Test-Path -LiteralPath $target) {
            [xml]$xml = Get-Content -LiteralPath $target -Raw

            # รองรับ 2 รูปแบบ:
            # 1) <VideoCardDescription>...</VideoCardDescription>
            # 2) ไม่มี node -> เพิ่มท้าย <Settings>
            $node = $xml.SelectSingleNode("//Settings/VideoCardDescription")
            if ($null -ne $node) {
                $node.InnerText = $GpuName
            } else {
                $settingsNode = $xml.SelectSingleNode("//Settings")
                if ($null -eq $settingsNode) {
                    throw "โครงสร้าง XML ไม่ถูกต้อง: ไม่พบ <Settings>"
                }
                $newNode = $xml.CreateElement("VideoCardDescription")
                $newNode.InnerText = $GpuName
                [void]$settingsNode.AppendChild($newNode)
            }
            $xml.Save($target)
        } else {
            # สร้างไฟล์พื้นฐานใหม่ (ยึดโครงแบบที่พบทั่วไปของ FiveM)
