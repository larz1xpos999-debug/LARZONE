function Test-Admin {
    $id = [Security.Principal.WindowsIdentity]::GetCurrent()
    $p  = New-Object Security.Principal.WindowsPrincipal($id)
    return $p.IsInRole([Security.Principal.WindowsBuiltInRole]::Administrator)
}

if (-not (Test-Admin)) {
    [Windows.Forms.MessageBox]::Show('กรุณาเปิดไฟล์ด้วย Run with PowerShell / PowerShell (Administrator) แล้วลองใหม่','LARZONE v3','OK','Warning') | Out-Null
    exit
}

function Default-State {
    return [pscustomobject]@{
        Normal       = $false
        High         = $false
        Custom       = $false
        GpeditOpened = $false
        Ram          = 'ยังไม่ได้ตั้ง'
        Win32        = 'ยังไม่ได้ตั้ง'
        Keyboard     = 'ยังไม่ได้ตั้ง'
        Mouse        = 'ยังไม่ได้ตั้ง'
        LastMode     = 'ยังไม่เคยรัน'
        LastRun      = ''
        LastBackup   = ''
    }
}

function Load-State {
    if (Test-Path $StateFile) {
        try {
            $x = Get-Content $StateFile -Raw | ConvertFrom-Json
            $d = Default-State
            foreach ($p in $d.PSObject.Properties.Name) {
                if ($null -ne $x.PSObject.Properties[$p]) { $d.$p = $x.$p }
            }
            return $d
        } catch {}
    }
    return Default-State
}

$script:S = Load-State

function Save-State {
    $script:S | ConvertTo-Json -Depth 4 | Set-Content -Path $StateFile -Encoding UTF8
}

function Log([string]$Text) {
    $line = "[$(Get-Date -Format 'yyyy-MM-dd HH:mm:ss')] $Text"
    Add-Content -Path $LogFile -Value $line -Encoding UTF8
    if ($script:LogBox) { $script:LogBox.AppendText($line + [Environment]::NewLine) }
}

function Reg-Path([string]$Path) {
    return "Registry::$Path"
}

function Get-Dword([string]$Path,[string]$Name) {
    try {
        $p = Get-ItemProperty -Path (Reg-Path $Path) -Name $Name -ErrorAction Stop
        return [uint32]$p.$Name
    } catch { return $null }
}

function Set-Dword([string]$Path,[string]$Name,[uint32]$Value) {
    $rp = Reg-Path $Path
    if (-not (Test-Path $rp)) { New-Item -Path $rp -Force | Out-Null }
    New-ItemProperty -Path $rp -Name $Name -PropertyType DWord -Value $Value -Force | Out-Null
}

function Backup-RegistryKey([string]$Key,[string]$Folder) {
    $safe = ($Key -replace '[\\/:*?"<>|]','_') + '.reg'
    $dest = Join-Path $Folder $safe
    & reg.exe export $Key $dest /y *> $null
    if ($LASTEXITCODE -ne 0) { Log "Backup skipped/failed: $Key" }
}

function Do-Backup {
    $stamp = Get-Date -Format 'yyyyMMdd_HHmmss'
    $folder = Join-Path $BackupDir $stamp
    New-Item -ItemType Directory -Force -Path $folder | Out-Null

    $keys = @(
        'HKLM\SOFTWARE\Microsoft\Windows NT\CurrentVersion\Multimedia\SystemProfile',
        'HKLM\SYSTEM\CurrentControlSet\Control\PriorityControl',
        'HKLM\SYSTEM\CurrentControlSet\Control',
        'HKLM\SYSTEM\CurrentControlSet\Services\kbdclass\Parameters',
        'HKLM\SYSTEM\CurrentControlSet\Services\mouclass\Parameters'
    )
    foreach ($k in $keys) { Backup-RegistryKey $k $folder }

    $services = @('MapsBroker','DiagTrack')
    $svcData = foreach ($name in $services) {
        try {
            $svc = Get-CimInstance Win32_Service -Filter "Name='$name'"
            if ($svc) { [pscustomobject]@{Name=$name;StartMode=$svc.StartMode;State=$svc.State} }
        } catch {}
    }
    $svcData | ConvertTo-Json -Depth 3 | Set-Content (Join-Path $folder 'services.json') -Encoding UTF8

    $script:S.LastBackup = $folder
    Save-State
    Log "Backup created: $folder"
    return $folder
}

function Set-ServiceDisabled([string]$Name) {
    try {
        $svc = Get-Service -Name $Name -ErrorAction Stop
        if ($svc.StartType -ne 'Disabled') {
            Set-Service -Name $Name -StartupType Disabled -ErrorAction Stop
            Log "Disabled service: $Name"
        }
    } catch { Log "Service not changed: $Name" }
}

function Restore-Services([string]$Folder) {
    $file = Join-Path $Folder 'services.json'
    if (-not (Test-Path $file)) { return }
    try {
        $data = Get-Content $file -Raw | ConvertFrom-Json
        foreach ($s in @($data)) {
            if ($s.StartMode -eq 'Auto') { Set-Service $s.Name -StartupType Automatic -ErrorAction SilentlyContinue }
            elseif ($s.StartMode -eq 'Manual') { Set-Service $s.Name -StartupType Manual -ErrorAction SilentlyContinue }
            elseif ($s.StartMode -eq 'Disabled') { Set-Service $s.Name -StartupType Disabled -ErrorAction SilentlyContinue }
            Log "Restored service startup: $($s.Name) -> $($s.StartMode)"
        }
    } catch { Log 'Service restore could not be completed.' }
}

function Remove-AppxIfPresent([string]$Name) {
    try {
        $packages = @(Get-AppxPackage -AllUsers -Name $Name -ErrorAction SilentlyContinue)
        if ($packages.Count -eq 0) { Log "Absent: $Name"; return }
        foreach ($p in $packages) {
            Remove-AppxPackage -Package $p.PackageFullName -AllUsers -ErrorAction Stop
            Log "Removed AppX: $Name"
        }
    } catch { Log "AppX removal failed/blocked: $Name" }
}

function Normal {
    $b = Do-Backup
    foreach ($n in @('Microsoft.GetHelp','Microsoft.Getstarted','Microsoft.People','Microsoft.WindowsFeedbackHub')) { Remove-AppxIfPresent $n }
    Set-ServiceDisabled 'MapsBroker'
    $script:S.Normal = $true; $script:S.High = $false
    $script:S.LastMode = 'NORMAL'; $script:S.LastRun = (Get-Date).ToString('s')
    Save-State; Log 'NORMAL completed.'; Refresh-Main
    [Windows.Forms.MessageBox]::Show("NORMAL เสร็จแล้ว`nBackup: $b`n`nหมายเหตุ: AppX ที่ถูกถอนอาจไม่สามารถ Restore กลับด้วย Registry backup ได้",'LARZONE v3','OK','Information') | Out-Null
}

function High {
    $b = Do-Backup
    foreach ($n in @('Microsoft.GetHelp','Microsoft.Getstarted','Microsoft.People','Microsoft.WindowsFeedbackHub','Microsoft.BingNews','Microsoft.BingWeather','Microsoft.MicrosoftSolitaireCollection','Microsoft.YourPhone')) { Remove-AppxIfPresent $n }
    Set-ServiceDisabled 'MapsBroker'; Set-ServiceDisabled 'DiagTrack'
    $script:S.Normal = $false; $script:S.High = $true
    $script:S.LastMode = 'HIGH'; $script:S.LastRun = (Get-Date).ToString('s')
