#requires -RunAsAdministrator
$ErrorActionPreference="SilentlyContinue"
$root="$env:ProgramData\Larzone"
$bak="$root\Backup"
New-Item $bak -ItemType Directory -Force|Out-Null

function Header($title="LARZONE TUNE"){
 Clear-Host
 Write-Host "╔══════════════════════════════════════════════════════╗" -ForegroundColor Cyan
 Write-Host "║                 ⚡ LARZONE TUNE                      ║" -ForegroundColor Magenta
 Write-Host "║       WINDOWS • FIVEM • NETWORK • INPUT             ║" -ForegroundColor Cyan
 Write-Host "╠══════════════════════════════════════════════════════╣" -ForegroundColor Cyan
 Write-Host "║  $title".PadRight(55)+"║" -ForegroundColor White
 Write-Host "╚══════════════════════════════════════════════════════╝" -ForegroundColor Cyan
}
function P { Read-Host "`nกด Enter เพื่อกลับเมนู" | Out-Null }
function Back { Write-Host ""; Write-Host "[B] BACK    [0] EXIT" -ForegroundColor Yellow }
function WaitBack { Read-Host "กด Enter เพื่อกลับ" | Out-Null }

function Backup {
 if(!(Test-Path "$bak\game.reg")){
  reg.exe export "HKCU\Software\Microsoft\Windows\CurrentVersion\GameDVR" "$bak\game.reg" /y|Out-Null
  reg.exe export "HKCU\System\GameConfigStore" "$bak\config.reg" /y|Out-Null
  reg.exe export "HKCU\Control Panel\Mouse" "$bak\mouse.reg" /y|Out-Null
 }
}

function Profile($name){
 Backup
 $mm="HKLM:\SOFTWARE\Microsoft\Windows NT\CurrentVersion\Multimedia\SystemProfile"
 if(!(Test-Path $mm)){New-Item $mm -Force|Out-Null}
 $games="$mm\Tasks\Games"
 if(!(Test-Path $games)){New-Item $games -Force|Out-Null}

 # Values taken from the supplied source file, arranged from light -> full.
 # The source's actual traffic shaper is intentionally NOT enabled here because
 # it throttles network traffic; it is not a performance boost.
 switch($name){
  "LOW" {
   Set-ItemProperty $games "GPU Priority" 2 -Type DWord -Force
   Set-ItemProperty $games Priority 2 -Type DWord -Force
   Set-ItemProperty $games "Scheduling Category" "Medium" -Type String -Force
   powercfg /setactive SCHEME_BALANCED|Out-Null
  }
  "MEDIUM" {
   Set-ItemProperty $mm NetworkThrottlingIndex 0xffffffff -Type DWord -Force
   Set-ItemProperty $mm SystemResponsiveness 10 -Type DWord -Force
   Set-ItemProperty $games "GPU Priority" 6 -Type DWord -Force
   Set-ItemProperty $games Priority 4 -Type DWord -Force
   Set-ItemProperty $games "Scheduling Category" "High" -Type String -Force
   New-Item "HKCU:\Software\Microsoft\Windows\CurrentVersion\GameDVR" -Force|Out-Null
   Set-ItemProperty "HKCU:\Software\Microsoft\Windows\CurrentVersion\GameDVR" AppCaptureEnabled 0 -Type DWord -Force
   New-Item "HKCU:\System\GameConfigStore" -Force|Out-Null
   Set-ItemProperty "HKCU:\System\GameConfigStore" GameDVR_Enabled 0 -Type DWord -Force
   powercfg /setactive SCHEME_BALANCED|Out-Null
  }
  "HIGH" {
   Set-ItemProperty $mm NetworkThrottlingIndex 0xffffffff -Type DWord -Force
   Set-ItemProperty $mm SystemResponsiveness 0 -Type DWord -Force
   Set-ItemProperty $games "GPU Priority" 8 -Type DWord -Force
   Set-ItemProperty $games Priority 6 -Type DWord -Force
   Set-ItemProperty $games "Scheduling Category" "High" -Type String -Force
   New-Item "HKCU:\Software\Microsoft\Windows\CurrentVersion\GameDVR" -Force|Out-Null
   Set-ItemProperty "HKCU:\Software\Microsoft\Windows\CurrentVersion\GameDVR" AppCaptureEnabled 0 -Type DWord -Force
   New-Item "HKCU:\System\GameConfigStore" -Force|Out-Null
   Set-ItemProperty "HKCU:\System\GameConfigStore" GameDVR_Enabled 0 -Type DWord -Force
   powercfg /setactive SCHEME_MIN|Out-Null
  }
  "MAX" {
   # Full performance-related registry set present in the supplied source.
   Set-ItemProperty $mm NetworkThrottlingIndex 0xffffffff -Type DWord -Force
   Set-ItemProperty $mm SystemResponsiveness 0 -Type DWord -Force
   Set-ItemProperty $games "GPU Priority" 8 -Type DWord -Force
   Set-ItemProperty $games Priority 6 -Type DWord -Force
   Set-ItemProperty $games "Scheduling Category" "High" -Type String -Force
   $psched="HKLM:\SOFTWARE\Policies\Microsoft\Windows\Psched"
   if(!(Test-Path $psched)){New-Item $psched -Force|Out-Null}
   Set-ItemProperty $psched NonBestEffortLimit 80 -Type DWord -Force
   New-Item "HKCU:\Software\Microsoft\Windows\CurrentVersion\GameDVR" -Force|Out-Null
   Set-ItemProperty "HKCU:\Software\Microsoft\Windows\CurrentVersion\GameDVR" AppCaptureEnabled 0 -Type DWord -Force
   New-Item "HKCU:\System\GameConfigStore" -Force|Out-Null
   Set-ItemProperty "HKCU:\System\GameConfigStore" GameDVR_Enabled 0 -Type DWord -Force
   powercfg /setactive SCHEME_MIN|Out-Null
  }
 }
 Write-Host "`n✓ PERFORMANCE $name APPLIED" -ForegroundColor Green
 WaitBack
}

function FiveMMenu{
 while($true){
  Header "🎮 FIVEM / GAME"
  Write-Host "[1] GameDVR OFF";Write-Host "[2] GameConfigStore OFF";Write-Host "[3] GPU Priority = 8";Write-Host "[4] Game Priority = 6";Write-Host "[5] Scheduling = High";Write-Host "[6] NetworkThrottling = FFFFFFFF";Write-Host "[7] SystemResponsiveness = 0";Write-Host "[8] Power = High";Write-Host "[9] Game Profile";Write-Host "[10] Streaming Profile";Write-Host "[11] Apply Input";Write-Host "[12] Clean FiveM Cache";Write-Host "[13] Apply FiveM Pack";Write-Host "[14] Show FiveM Status";Write-Host "[15] APPLY ALL"
  Write-Host ""; Write-Host "[B] ⬅ BACK    [0] ❌ EXIT" -ForegroundColor Yellow;$x=(Read-Host "เลือก").ToUpper();if($x-eq"B"){return};if($x-eq"0"){exit}
  $mm="HKLM:\SOFTWARE\Microsoft\Windows NT\CurrentVersion\Multimedia\SystemProfile";$g="$mm\Tasks\Games"
  switch($x){
   "1"{Backup;New-Item "HKCU:\Software\Microsoft\Windows\CurrentVersion\GameDVR" -Force|Out-Null;Set-ItemProperty "HKCU:\Software\Microsoft\Windows\CurrentVersion\GameDVR" AppCaptureEnabled 0 -Force}
   "2"{Backup;New-Item "HKCU:\System\GameConfigStore" -Force|Out-Null;Set-ItemProperty "HKCU:\System\GameConfigStore" GameDVR_Enabled 0 -Force}
   "3"{Backup;New-Item $g -Force|Out-Null;Set-ItemProperty $g "GPU Priority" 8 -Type DWord -Force}
   "4"{Backup;New-Item $g -Force|Out-Null;Set-ItemProperty $g Priority 6 -Type DWord -Force}
   "5"{Backup;New-Item $g -Force|Out-Null;Set-ItemProperty $g "Scheduling Category" High -Type String -Force}
   "6"{Backup;New-Item $mm -Force|Out-Null;Set-ItemProperty $mm NetworkThrottlingIndex 0xffffffff -Type DWord -Force}
   "7"{Backup;New-Item $mm -Force|Out-Null;Set-ItemProperty $mm SystemResponsiveness 0 -Type DWord -Force}
   "8"{powercfg /setactive SCHEME_MIN|Out-Null}
   "9"{Profile "HIGH"}
   "10"{Profile "MEDIUM"}
   "11"{MouseMenu}
   "12"{Write-Host "FiveM cache cleanup is manual in this safe build." -f Yellow;P}
   "13"{Profile "HIGH"}
   "14"{Write-Host "FiveM profile / GameDVR status shown by current registry values.";Get-ItemProperty $g -ErrorAction SilentlyContinue|Select "GPU Priority",Priority,"Scheduling Category"|Format-List;P}
   "15"{Profile "MAX"}
  }
  Write-Host "`n✓ DONE" -f Green;P
 }
}
function NetworkMenu{
 while($true){
  Header "🌐 NETWORK"
  Write-Host "[1] NetworkThrottlingIndex = FFFFFFFF";Write-Host "[2] SystemResponsiveness = 0";Write-Host "[3] TCP Auto-Tuning = Normal";Write-Host "[4] NonBestEffortLimit = 80";Write-Host "[5] Check Adapter";Write-Host "[6] Check Link Speed";Write-Host "[7] Adapter Power Status";Write-Host "[8] TCP Global Status";Write-Host "[9] DNS Display";Write-Host "[10] Network Profile";Write-Host "[11] Apply TCP Normal";Write-Host "[12] Apply Multimedia Network";Write-Host "[13] Apply QoS Value";Write-Host "[14] Show Network Status";Write-Host "[15] APPLY ALL"
  Write-Host ""; Write-Host "[B] ⬅ BACK    [0] ❌ EXIT" -ForegroundColor Yellow;$x=(Read-Host "เลือก").ToUpper();if($x-eq"B"){return};if($x-eq"0"){exit}
  $mm="HKLM:\SOFTWARE\Microsoft\Windows NT\CurrentVersion\Multimedia\SystemProfile"
  switch($x){
   "1"{Backup;New-Item $mm -Force|Out-Null;Set-ItemProperty $mm NetworkThrottlingIndex 0xffffffff -Type DWord -Force}
   "2"{Backup;New-Item $mm -Force|Out-Null;Set-ItemProperty $mm SystemResponsiveness 0 -Type DWord -Force}
   "3"{netsh int tcp set global autotuninglevel=normal|Out-Null}
   "4"{Backup;$q="HKLM:\SOFTWARE\Policies\Microsoft\Windows\Psched";New-Item $q -Force|Out-Null;Set-ItemProperty $q NonBestEffortLimit 80 -Type DWord -Force}
   "5"{Get-NetAdapter|Format-Table Name,Status,LinkSpeed -AutoSize;P}
   "6"{Get-NetAdapter|Where Status -eq Up|Format-Table Name,LinkSpeed -AutoSize;P}
   "7"{Get-NetAdapterPowerManagement -Name * -ErrorAction SilentlyContinue|Format-List;P}
   "8"{netsh int tcp show global;P}
   "9"{Get-DnsClientServerAddress -AddressFamily IPv4|Format-Table InterfaceAlias,ServerAddresses -AutoSize;P}
   "10"{Get-NetConnectionProfile|Format-Table Name,InterfaceAlias,NetworkCategory -AutoSize;P}
   "11"{netsh int tcp set global autotuninglevel=normal|Out-Null}
   "12"{Backup;New-Item $mm -Force|Out-Null;Set-ItemProperty $mm NetworkThrottlingIndex 0xffffffff -Type DWord -Force;Set-ItemProperty $mm SystemResponsiveness 0 -Type DWord -Force}
   "13"{Backup;$q="HKLM:\SOFTWARE\Policies\Microsoft\Windows\Psched";New-Item $q -Force|Out-Null;Set-ItemProperty $q NonBestEffortLimit 80 -Type DWord -Force}
   "14"{netsh int tcp show global;Get-NetAdapter|Format-Table Name,Status,LinkSpeed -AutoSize;P}
   "15"{Profile "MAX"}
  }
  Write-Host "`n✓ DONE" -f Green;P
 }
}
