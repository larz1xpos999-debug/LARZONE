    ) -join "`r`n"
}

function Remove-SelectedApps([array]$Selected) {
    $backup = New-LarzoneBackup
    if (-not $backup) { return }

    $done = 0
    foreach ($name in $Selected) {
        try {
            $packages = Get-AppxPackage -AllUsers -Name $name -ErrorAction SilentlyContinue
            foreach ($package in $packages) {
                Remove-AppxPackage -Package $package.PackageFullName -AllUsers -ErrorAction SilentlyContinue
                $done++
            }
        } catch {}
    }

    Show-Message ("Debloat เสร็จแล้ว`r`n`r`nลบ App ได้: {0}`r`n`r`nBackup:`r`n{1}" -f $done, $backup) "$AppName // DEBLOAT"
}

function Apply-SafeTweaks([hashtable]$Options) {
    $backup = New-LarzoneBackup
    if (-not $backup) { return }

    # Only conservative, reversible user-facing toggles are handled here.
    # Critical services, Defender, Windows Update, network stack and input drivers are untouched.

    if ($Options.Suggestions) {
        try {
            $p = "HKCU:\Software\Microsoft\Windows\CurrentVersion\ContentDeliveryManager"
            Ensure-Dir $p | Out-Null
            Set-DWord $p "SubscribedContent-338388Enabled" 0
            Set-DWord $p "SubscribedContent-338389Enabled" 0
            Set-DWord $p "SubscribedContent-310093Enabled" 0
            Set-DWord $p "SubscribedContent-353694Enabled" 0
        } catch {}
    }

    if ($Options.Telemetry) {
        try {
            $p = "HKCU:\Software\Microsoft\Windows\CurrentVersion\Privacy"
            Ensure-Dir $p | Out-Null
            Set-DWord $p "TailoredExperiencesWithDiagnosticDataEnabled" 0
        } catch {}
    }

    if ($Options.BackgroundApps) {
        try {
            $p = "HKCU:\Software\Microsoft\Windows\CurrentVersion\BackgroundAccessApplications"
            Ensure-Dir $p | Out-Null
            Set-DWord $p "GlobalUserDisabled" 1
        } catch {}
    }

    Show-Message ("Tweaks ที่เลือกถูก Apply แล้ว`r`n`r`nBackup:`r`n{0}" -f $backup) "$AppName // CUSTOM"
}

