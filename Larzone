function Restore{
 Header "♻ RESTORE"
 if(Test-Path "$bak\game.reg"){reg.exe import "$bak\game.reg"|Out-Null}
 if(Test-Path "$bak\config.reg"){reg.exe import "$bak\config.reg"|Out-Null}
 if(Test-Path "$bak\mouse.reg"){reg.exe import "$bak\mouse.reg"|Out-Null}
 powercfg /setactive SCHEME_BALANCED|Out-Null
 Write-Host "`n✓ RESTORE COMPLETE" -ForegroundColor Yellow
 WaitBack
}

