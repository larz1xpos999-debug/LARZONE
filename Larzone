$statusBox.Location = New-Object System.Drawing.Point(650,120)
$statusBox.Size = New-Object System.Drawing.Size(380,475)
$statusBox.BackColor = [System.Drawing.Color]::FromArgb(13,17,27)
$statusBox.ForeColor = [System.Drawing.Color]::White
$statusBox.Font = [System.Drawing.Font]::new('Consolas',9)
$statusBox.Text = Get-LarzoneStatus
$form.Controls.Add($statusBox)

$debloatButton.Add_Click({ [void](Invoke-AppxDebloat) })

$normalButton.Add_Click({
    Invoke-QuickProfile -ProfileName 'NORMAL'
})

$highButton.Add_Click({
    Invoke-QuickProfile -ProfileName 'HIGH'
})

$customButton.Add_Click({
    Show-CustomEditor
})

$systemButton.Add_Click({
    Show-CustomEditor
})

$ramButton.Add_Click({
    Show-RamEditor
})

$statusButton.Add_Click({
    $statusBox.Text = Get-LarzoneStatus
})

$backupButton.Add_Click({
    $choice = [System.Windows.Forms.MessageBox]::Show(
        "YES = สร้าง Backup ใหม่`r`nNO = Restore Backup ล่าสุด`r`nCANCEL = ดูรายการ Backup",
        "$AppName // BACKUP / RESTORE",
        [System.Windows.Forms.MessageBoxButtons]::YesNoCancel,
        [System.Windows.Forms.MessageBoxIcon]::Question
    )

    if ($choice -eq [System.Windows.Forms.DialogResult]::Yes) {
        $backup = New-LarzoneBackup
        if ($null -ne $backup) {
            Show-Message -Message "Backup สำเร็จ`r`n`r`n$backup" -Title "$AppName // BACKUP"
        }
    } elseif ($choice -eq [System.Windows.Forms.DialogResult]::No) {
        Restore-LatestBackup
    } else {
        Show-BackupList
    }
})

$gamingButton.Add_Click({
    Show-Message -Message (
        "GAMING`r`n`r`n" +
        "V3.2 แยกส่วน Gaming ออกจาก Debloat แล้ว`r`n" +
        "ยังไม่ใส่ tweak ที่เสี่ยงต่อความเสถียรโดยอัตโนมัติ`r`n`r`n" +
        "NORMAL/HIGH จะไม่เปลี่ยน Keyboard / Mouse / Win32 / RAM"
    ) -Title "$AppName // GAMING"
})

$exitButton.Add_Click({
    $form.Close()
})

Write-Log 'LARZONE V3.2 started.'
[void]$form.ShowDialog()
