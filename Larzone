function Backup-State{try{$d=Join-Path $Backup (Get-Date -Format 'yyyyMMdd_HHmmss');New-Item -ItemType Directory -Force -Path $d|Out-Null;reg.exe export 'HKLM\SYSTEM\CurrentControlSet\Control' "$d\Control.reg" /y|Out-Null;reg.exe export 'HKLM\SYSTEM\CurrentControlSet\Services\kbdclass\Parameters' "$d\Keyboard.reg" /y|Out-Null;reg.exe export 'HKLM\SYSTEM\CurrentControlSet\Services\mouclass\Parameters' "$d\Mouse.reg" /y|Out-Null;$st=@();foreach($n in $OptionalServices){$s=Get-CimInstance Win32_Service -Filter "Name='$n'";if($s){$st+=[pscustomobject]@{Name=$s.Name;StartMode=$s.StartMode;State=$s.State}}};$st|ConvertTo-Json|Set-Content "$d\Services.json" -Encoding UTF8;$d}catch{$null}}
function Restore-State{$d=Get-ChildItem $Backup -Directory|Sort-Object LastWriteTime -Descending|Select-Object -First 1;if(-not $d){Box 'ยังไม่พบ Backup' 'LARZONE // RESTORE' 48;return};if([Windows.Forms.MessageBox]::Show("Restore จาก Backup ล่าสุด?`r`n`r`n$($d.Name)",'LARZONE // RESTORE',4,48)-ne [Windows.Forms.DialogResult]::Yes){return};foreach($f in 'Control.reg','Keyboard.reg','Mouse.reg'){$x=Join-Path $d.FullName $f;if(Test-Path $x){reg.exe import $x|Out-Null}};$sf=Join-Path $d.FullName 'Services.json';if(Test-Path $sf){try{foreach($s in @(Get-Content $sf -Raw|ConvertFrom-Json)){switch($s.StartMode){'Auto'{Set-Service $s.Name -StartupType Automatic}'Manual'{Set-Service $s.Name -StartupType Manual}'Disabled'{Set-Service $s.Name -StartupType Disabled}}}}catch{}};Box 'Restore เสร็จแล้ว`r`n`nแนะนำ Restart Windows'}
