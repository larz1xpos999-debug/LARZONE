#requires -version 5.1
<#
 LARZONE TUNE — Complete Edition
 Windows / FiveM / Network / Mouse / CPU-RAM
 - 4 Performance profiles
 - 5-9 category menus, no duplicated tuning ownership
 - Live "APPLIED / DIFFERENT / NOT RUN BY LARZONE" status
 - Persistent Larzone state
 - Timestamped registry backup + restore
 - Safe-by-default changes
#>

$ErrorActionPreference = "SilentlyContinue"
$AppName = "Larzone"
$DataDir = Join-Path $env:ProgramData $AppName
$BackupDir = Join-Path $DataDir "Backups"
$StateFile = Join-Path $DataDir "state.json"

New-Item -ItemType Directory -Path $DataDir,$BackupDir -Force | Out-Null

function IsAdmin {
    $p = New-Object Security.Principal.WindowsPrincipal([Security.Principal.WindowsIdentity]::GetCurrent())
    return $p.IsInRole([Security.Principal.WindowsBuiltInRole]::Administrator)
}
function NeedAdmin {
    if (!(IsAdmin)) {
        Write-Host "`n[!] เปิด PowerShell แบบ Run as administrator ก่อน" -ForegroundColor Yellow
        Read-Host "กด Enter เพื่อออก" | Out-Null
        exit
    }
}
function Header([string]$title) {
    Clear-Host
    Write-Host "╔══════════════════════════════════════════════════════════════╗" -ForegroundColor DarkCyan
    Write-Host ("║  ⚡ LARZONE TUNE  |  {0}" -f $title).PadRight(61) + "║" -ForegroundColor Cyan
    Write-Host "╠══════════════════════════════════════════════════════════════╣" -ForegroundColor DarkCyan
}
function Footer {
    Write-Host "╚══════════════════════════════════════════════════════════════╝" -ForegroundColor DarkCyan
}
function PauseMenu { Read-Host "`nกด Enter เพื่อกลับ" | Out-Null }
function ExitIfZero($x) { if($x -eq "0"){ exit } }

function LoadState {
    $script:State = @{}
    if(Test-Path $StateFile) {
        try {
            $o = Get-Content $StateFile -Raw | ConvertFrom-Json
            foreach($p in $o.PSObject.Properties){ $script:State[$p.Name] = $p.Value }
        } catch {}
    }
}
function SaveState([string[]]$keys) {
    LoadState
    foreach($k in $keys){ $script:State[$k] = $true }
    try {
        ($script:State | ConvertTo-Json) | Set-Content $StateFile -Encoding UTF8
    } catch {}
}
function WasRun([string]$key) {
    LoadState
    return [bool]($script:State[$key])
}
function StatusLine([string]$n,[string]$name,[bool]$match,[string]$key) {
    if(WasRun $key) {
        Write-Host ("[{0}] ● LARZONE APPLIED   {1}" -f $n,$name) -ForegroundColor Green
    } elseif($match) {
        Write-Host ("[{0}] ● MATCHED           {1}" -f $n,$name) -ForegroundColor Cyan
    } else {
        Write-Host ("[{0}] ○ NOT SET           {1}" -f $n,$name) -ForegroundColor Yellow
    }
}

function Backup {
    $stamp = Get-Date -Format "yyyyMMdd_HHmmss"
    $dir = Join-Path $BackupDir $stamp
    New-Item -ItemType Directory -Path $dir -Force | Out-Null

    $regs = @{
        GameDVR = "HKCU\Software\Microsoft\Windows\CurrentVersion\GameDVR"
        GameConfigStore = "HKCU\System\GameConfigStore"
        Mouse = "HKCU\Control Panel\Mouse"
        Multimedia = "HKLM\SOFTWARE\Microsoft\Windows NT\CurrentVersion\Multimedia\SystemProfile"
    }
    foreach($n in $regs.Keys) {
        reg.exe export $regs[$n] (Join-Path $dir "$n.reg") /y *> $null
    }
    powercfg /getactivescheme | Set-Content (Join-Path $dir "PowerPlan.txt")
    netsh int tcp show global | Set-Content (Join-Path $dir "TCP_Global.txt")
    Write-Host "✓ Backup: $dir" -ForegroundColor DarkGray
    return $dir
}
function RestoreLatest {
    Header "♻ RESTORE"
    $latest = Get-ChildItem $BackupDir -Directory | Sort-Object Name -Descending | Select-Object -First 1
    if(!$latest) {
        Write-Host "`nยังไม่มี Backup" -ForegroundColor Yellow
        PauseMenu; return
    }
    foreach($n in @("GameDVR","GameConfigStore","Mouse","Multimedia")) {
        $f = Join-Path $latest.FullName "$n.reg"
        if(Test-Path $f){ reg.exe import $f *> $null }
    }
    Write-Host "`n✓ คืนค่า Registry จาก Backup ล่าสุดแล้ว" -ForegroundColor Green
    Write-Host "Backup: $($latest.Name)" -ForegroundColor DarkGray
    PauseMenu
}

# ----- Registry helpers -----
$MM = "HKLM:\SOFTWARE\Microsoft\Windows NT\CurrentVersion\Multimedia\SystemProfile"
$Games = "$MM\Tasks\Games"
$GameDVR = "HKCU:\Software\Microsoft\Windows\CurrentVersion\GameDVR"
$GameConfig = "HKCU:\System\GameConfigStore"
$Mouse = "HKCU:\Control Panel\Mouse"

function GetReg($path,$name) {
    try { return (Get-ItemProperty -Path $path -Name $name -ErrorAction Stop).$name } catch { return $null }
}
function RegMatch($path,$name,$wanted) {
    $v = GetReg $path $name
    return ([string]$v -eq [string]$wanted)
}
function SetDword($path,$name,$value) {
    New-Item -Path $path -Force | Out-Null
    New-ItemProperty -Path $path -Name $name -Value $value -PropertyType DWord -Force | Out-Null
}
function SetString($path,$name,$value) {
    New-Item -Path $path -Force | Out-Null
    New-ItemProperty -Path $path -Name $name -Value $value -PropertyType String -Force | Out-Null
}

function ApplyFiveMCore {
    Backup | Out-Null
    SetDword $Games "GPU Priority" 8
    SetDword $Games "Priority" 6
    SetString $Games "Scheduling Category" "High"
    SetDword $MM "NetworkThrottlingIndex" 0xffffffff
    SetDword $MM "SystemResponsiveness" 0
    SaveState @("FiveM_GPU","FiveM_GamePriority","FiveM_Scheduling","FiveM_NetworkThrottle","FiveM_SystemResponse")
    Write-Host "✓ FiveM core applied" -ForegroundColor Green
}
function ApplyPowerHigh {
    Backup | Out-Null
    powercfg /setactive SCHEME_MIN | Out-Null
    SaveState @("Power_High")
    Write-Host "✓ High Performance power plan applied" -ForegroundColor Green
}
function ApplyPowerBalanced {
    Backup | Out-Null
    powercfg /setactive SCHEME_BALANCED | Out-Null
    SaveState @("Power_Balanced")
    Write-Host "✓ Balanced power plan applied" -ForegroundColor Green
}
function ApplyMouse {
    Backup | Out-Null
    SetDword $Mouse "MouseSpeed" 0
    SetDword $Mouse "MouseThreshold1" 0
    SetDword $Mouse "MouseThreshold2" 0
    SaveState @("Mouse_Input")
    Write-Host "✓ Mouse acceleration settings applied" -ForegroundColor Green
}
function ApplyWindowsSafe {
    Backup | Out-Null
    SetDword $GameDVR "AppCaptureEnabled" 0
    SetDword $GameConfig "GameDVR_Enabled" 0
    SaveState @("Windows_GameDVR","Windows_GameConfig")
    Write-Host "✓ GameDVR / GameConfigStore disabled" -ForegroundColor Green
}
function ApplyNetworkSafe {
    Backup | Out-Null
    netsh int tcp set global autotuninglevel=normal | Out-Null
    SaveState @("Network_AutoTuning")
    Write-Host "✓ TCP Auto-Tuning = Normal" -ForegroundColor Green
}
function CleanFiveMCache {
    Backup | Out-Null
    $paths = @(
        "$env:LOCALAPPDATA\FiveM\FiveM.app\data\cache",
        "$env:LOCALAPPDATA\FiveM\FiveM.app\data\server-cache",
        "$env:LOCALAPPDATA\FiveM\FiveM.app\data\server-cache-priv"
    )
    foreach($d in $paths) {
        if(Test-Path $d) {
            Get-ChildItem $d -Force -ErrorAction SilentlyContinue |
                Remove-Item -Recurse -Force -ErrorAction SilentlyContinue
        }
    }
    SaveState @("FiveM_Cache")
    Write-Host "✓ FiveM cache cleaned" -ForegroundColor Green
}

# ----- Profiles: each level is cumulative; MAX is the full safe set -----
function ApplyProfile([int]$level) {
    Backup | Out-Null
    switch($level) {
        1 {
            ApplyPowerBalanced
        }
        2 {
            SetDword $MM "NetworkThrottlingIndex" 0xffffffff
            SetDword $MM "SystemResponsiveness" 10
            SetDword $Games "GPU Priority" 6
            SetDword $Games "Priority" 4
            SetString $Games "Scheduling Category" "High"
            SetDword $GameDVR "AppCaptureEnabled" 0
            SetDword $GameConfig "GameDVR_Enabled" 0
            ApplyPowerBalanced
            SaveState @("Profile_2","FiveM_NetworkThrottle","FiveM_SystemResponse","FiveM_GPU","FiveM_GamePriority","FiveM_Scheduling","Windows_GameDVR","Windows_GameConfig","Power_Balanced")
        }
        3 {
            SetDword $MM "NetworkThrottlingIndex" 0xffffffff
            SetDword $MM "SystemResponsiveness" 0
            SetDword $Games "GPU Priority" 8
            SetDword $Games "Priority" 6
            SetString $Games "Scheduling Category" "High"
            SetDword $GameDVR "AppCaptureEnabled" 0
            SetDword $GameConfig "GameDVR_Enabled" 0
            ApplyPowerHigh
            SaveState @("Profile_3","FiveM_NetworkThrottle","FiveM_SystemResponse","FiveM_GPU","FiveM_GamePriority","FiveM_Scheduling","Windows_GameDVR","Windows_GameConfig","Power_High")
        }
        4 {
            SetDword $MM "NetworkThrottlingIndex" 0xffffffff
            SetDword $MM "SystemResponsiveness" 0
            SetDword $Games "GPU Priority" 8
            SetDword $Games "Priority" 6
            SetString $Games "Scheduling Category" "High"
            SetDword $GameDVR "AppCaptureEnabled" 0
            SetDword $GameConfig "GameDVR_Enabled" 0
            ApplyMouse
            ApplyNetworkSafe
            ApplyPowerHigh
            SaveState @("Profile_4","FiveM_NetworkThrottle","FiveM_SystemResponse","FiveM_GPU","FiveM_GamePriority","FiveM_Scheduling","Windows_GameDVR","Windows_GameConfig","Mouse_Input","Network_AutoTuning","Power_High")
        }
    }
    SaveState @("Profile_$level")
    Write-Host "✓ PROFILE $level applied" -ForegroundColor Green
}

function PerformanceMenu {
    while($true) {
        Header "🚀 PERFORMANCE"
        Write-Host "[1] 🟢 LOW       เบา / ปลอดภัย"
        Write-Host "[2] 🔵 MEDIUM    สมดุล"
        Write-Host "[3] 🟠 HIGH      เน้นประสิทธิภาพ"
        Write-Host "[4] 🔴 MAX       เต็มสุด"
        Write-Host ""
        Write-Host "[B] ⬅ BACK    [0] ❌ EXIT" -ForegroundColor Yellow
        $x=(Read-Host "เลือก").ToUpper(); ExitIfZero $x
        if($x -eq "B"){return}
        if($x -match "^[1-4]$"){ ApplyProfile ([int]$x); PauseMenu }
    }
}

function FiveMMenu {
    while($true) {
        Header "🎮 FIVEM / GAME"
        StatusLine "1" "GPU Priority = 8" (RegMatch $Games "GPU Priority" 8) "FiveM_GPU"
        StatusLine "2" "Game Priority = 6" (RegMatch $Games "Priority" 6) "FiveM_GamePriority"
        StatusLine "3" "Scheduling = High" (RegMatch $Games "Scheduling Category" "High") "FiveM_Scheduling"
        StatusLine "4" "NetworkThrottlingIndex = FFFFFFFF" (RegMatch $MM "NetworkThrottlingIndex" 4294967295) "FiveM_NetworkThrottle"
        StatusLine "5" "SystemResponsiveness = 0" (RegMatch $MM "SystemResponsiveness" 0) "FiveM_SystemResponse"
        StatusLine "6" "High Performance Power" ((powercfg /getactivescheme) -match "High performance") "Power_High"
        StatusLine "7" "FiveM Cache Cleaned" $false "FiveM_Cache"
        Write-Host "[8] Game Profile / current values"
        Write-Host "[9] Streaming Profile / current values"
        Write-Host "[10] FiveM Status"
        Write-Host "[11] Apply GPU/Game pack"
        Write-Host "[12] Apply Multimedia pack"
        Write-Host "[13] Clean FiveM Cache"
        Write-Host "[14] Show current values"
        Write-Host "[15] APPLY ALL FIVEM"
        Write-Host ""
        Write-Host "[B] ⬅ BACK    [0] ❌ EXIT" -ForegroundColor Yellow
        $x=(Read-Host "เลือก").ToUpper(); ExitIfZero $x
        if($x -eq "B"){return}
        switch($x) {
            "1"{Backup|Out-Null;SetDword $Games "GPU Priority" 8;SaveState @("FiveM_GPU");Write-Host "✓ GPU Priority = 8" -f Green}
            "2"{Backup|Out-Null;SetDword $Games "Priority" 6;SaveState @("FiveM_GamePriority");Write-Host "✓ Game Priority = 6" -f Green}
            "3"{Backup|Out-Null;SetString $Games "Scheduling Category" "High";SaveState @("FiveM_Scheduling");Write-Host "✓ Scheduling = High" -f Green}
            "4"{Backup|Out-Null;SetDword $MM "NetworkThrottlingIndex" 0xffffffff;SaveState @("FiveM_NetworkThrottle");Write-Host "✓ NetworkThrottlingIndex = FFFFFFFF" -f Green}
            "5"{Backup|Out-Null;SetDword $MM "SystemResponsiveness" 0;SaveState @("FiveM_SystemResponse");Write-Host "✓ SystemResponsiveness = 0" -f Green}
            "6"{ApplyPowerHigh}
            "7"{Write-Host "Cache state: $(if(WasRun 'FiveM_Cache'){'LARZONE APPLIED'}else{'NOT RUN BY LARZONE'})"}
            "8"{Get-ItemProperty $Games -ErrorAction SilentlyContinue|Select "GPU Priority",Priority,"Scheduling Category"|Format-List}
            "9"{Get-ItemProperty $MM -ErrorAction SilentlyContinue|Select NetworkThrottlingIndex,SystemResponsiveness|Format-List}
            "10"{Get-Process FiveM -ErrorAction SilentlyContinue|Select Id,CPU,WorkingSet,Responding|Format-List}
            "11"{Backup|Out-Null;SetDword $Games "GPU Priority" 8;SetDword $Games "Priority" 6;SetString $Games "Scheduling Category" "High";SaveState @("FiveM_GPU","FiveM_GamePriority","FiveM_Scheduling");Write-Host "✓ GPU/Game pack applied" -f Green}
            "12"{Backup|Out-Null;SetDword $MM "NetworkThrottlingIndex" 0xffffffff;SetDword $MM "SystemResponsiveness" 0;SaveState @("FiveM_NetworkThrottle","FiveM_SystemResponse");Write-Host "✓ Multimedia pack applied" -f Green}
            "13"{CleanFiveMCache}
            "14"{Get-ItemProperty $Games -ErrorAction SilentlyContinue|Select "GPU Priority",Priority,"Scheduling Category"|Format-List;Get-ItemProperty $MM -ErrorAction SilentlyContinue|Select NetworkThrottlingIndex,SystemResponsiveness|Format-List;powercfg /getactivescheme}
            "15"{ApplyFiveMCore;ApplyPowerHigh}
        }
        PauseMenu
    }
}

function NetworkMenu {
    while($true) {
        Header "🌐 NETWORK"
        $tcp=(netsh int tcp show global | Out-String)
        StatusLine "1" "TCP Auto-Tuning = Normal" ($tcp -match "Receive Window Auto-Tuning Level.*normal") "Network_AutoTuning"
        Write-Host "[2] TCP Global Status"
        Write-Host "[3] Network Adapter Status"
        Write-Host "[4] Link Speed"
        Write-Host "[5] Adapter Power Management"
        Write-Host "[6] DNS Servers"
        Write-Host "[7] Network Profile"
        Write-Host "[8] IPv4 Configuration"
        Write-Host "[9] IPv6 Configuration"
        Write-Host "[10] Active Adapter"
        Write-Host "[11] TCP Supplemental"
        Write-Host "[12] TCP ECN Status"
        Write-Host "[13] TCP Timestamps"
        Write-Host "[14] Full Network Status"
        Write-Host "[15] APPLY TCP SAFE"
        Write-Host ""
        Write-Host "[B] ⬅ BACK    [0] ❌ EXIT" -ForegroundColor Yellow
        $x=(Read-Host "เลือก").ToUpper(); ExitIfZero $x
        if($x -eq "B"){return}
        switch($x) {
            "1"{ApplyNetworkSafe}
            "2"{netsh int tcp show global}
            "3"{Get-NetAdapter|Format-Table Name,Status,LinkSpeed -AutoSize}
            "4"{Get-NetAdapter|Where Status -eq Up|Format-Table Name,LinkSpeed -AutoSize}
            "5"{Get-NetAdapterPowerManagement -Name *|Format-List}
            "6"{Get-DnsClientServerAddress -AddressFamily IPv4|Format-Table InterfaceAlias,ServerAddresses -AutoSize}
            "7"{Get-NetConnectionProfile|Format-Table Name,InterfaceAlias,NetworkCategory -AutoSize}
            "8"{Get-NetIPConfiguration|Format-List}
            "9"{Get-NetIPConfiguration|Select InterfaceAlias,IPv6Address|Format-List}
            "10"{Get-NetAdapter|Where Status -eq Up|Format-Table Name,InterfaceDescription,LinkSpeed -AutoSize}
            "11"{netsh int tcp show supplemental}
            "12"{netsh int tcp show global|Select-String "ECN"}
            "13"{netsh int tcp show global|Select-String "timestamps"}
            "14"{netsh int tcp show global;Get-NetAdapter|Format-Table Name,Status,LinkSpeed -AutoSize}
            "15"{ApplyNetworkSafe}
        }
        PauseMenu
    }
}

