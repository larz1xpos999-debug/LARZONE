function Restore{
 Header "♻ RESTORE"
 $latest=Get-ChildItem $bak -Directory -ErrorAction SilentlyContinue|Sort-Object Name -Descending|Select-Object -First 1
 if(!$latest){
  Write-Host "`n! ยังไม่มี Backup" -ForegroundColor Yellow
  WaitBack
  return
 }
 foreach($name in @("GameDVR","GameConfigStore","Mouse","Multimedia","Psched")){
  $f=Join-Path $latest.FullName "$name.reg"
  if(Test-Path $f){reg.exe import $f 2>$null|Out-Null}
 }
 powercfg /setactive SCHEME_BALANCED|Out-Null
 Write-Host "`n✓ RESTORE COMPLETE" -ForegroundColor Green
 Write-Host "Backup: $($latest.FullName)" -ForegroundColor DarkGray
 WaitBack
}

