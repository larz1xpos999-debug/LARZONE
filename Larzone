# ---------- Backup / Restore ----------
function Open-Backup {
    $f = New-Window "LARZONE // BACKUP / RESTORE" 900 620
    Title $f "BACKUP / RESTORE"

    $list = New-Object Windows.Forms.ListBox
    $list.Font = New-Object Drawing.Font("Segoe UI",10)
    $list.Location = New-Object Drawing.Point(35,90)
    $list.Size = New-Object Drawing.Size(820,300)
    $f.Controls.Add($list)

    function Refresh-List {
        $list.Items.Clear()
        Get-ChildItem $BackupRoot -Directory -EA 0 |
            Sort-Object LastWriteTime -Descending |
            ForEach-Object { [void]$list.Items.Add($_.FullName) }
    }
    Refresh-List

    Btn $f "CREATE BACKUP" 35 425 200 55 {
        [void](New-Backup "MANUAL")
        Refresh-List
        Info "สร้าง Backup แล้ว"
    } | Out-Null

    Btn $f "RESTORE SELECTED" 250 425 220 55 {
        if (-not $list.SelectedItem) { Info "กรุณาเลือก Backup"; return }
        if (Confirm "Import Registry จาก Backup ที่เลือกหรือไม่?") {
            Get-ChildItem ([string]$list.SelectedItem) -Filter "*.reg" -EA 0 |
                ForEach-Object { & reg.exe import $_.FullName | Out-Null }
            Info "Restore เสร็จแล้ว`r`nแนะนำ Restart Windows"
        }
    } | Out-Null

    Btn $f "REFRESH" 485 425 150 55 { Refresh-List } | Out-Null
    Btn $f "BACK" 650 425 150 55 { $f.Close() } | Out-Null

    [void]$f.ShowDialog()
}


# ---------- Persistent System Note ----------
$NoteFile = Join-Path $LogRoot "SystemNote.log"

function Add-SystemNote($message) {
    $line = "[{0}] {1}" -f (Get-Date -Format "dd/MM HH:mm:ss"), $message
    Add-Content -LiteralPath $NoteFile -Value $line -Encoding UTF8
    Log "NOTE $message"
}

function Get-SystemNotes {
    if (Test-Path $NoteFile) {
        return @(Get-Content -LiteralPath $NoteFile -Encoding UTF8)
    }
    return @()
}

function Show-SystemNote {
    $f = New-Window "LARZONE // SYSTEM NOTE" 620 650
    Title $f "SYSTEM NOTE"

    $box = New-Object Windows.Forms.TextBox
    $box.Multiline = $true
    $box.ReadOnly = $true
    $box.ScrollBars = "Vertical"
    $box.WordWrap = $false
    $box.Font = New-Object Drawing.Font("Consolas",10)
    $box.ForeColor = [Drawing.Color]::White
    $box.BackColor = [Drawing.Color]::FromArgb(15,22,32)
    $box.Location = New-Object Drawing.Point(30,85)
    $box.Size = New-Object Drawing.Size(555,420)
    $f.Controls.Add($box)

    function Refresh-NoteBox {
        $box.Text = ((Get-SystemNotes) -join [Environment]::NewLine)
        $box.SelectionStart = $box.TextLength
        $box.ScrollToCaret()
    }
    Refresh-NoteBox

    Btn $f "REFRESH" 30 530 150 50 { Refresh-NoteBox } | Out-Null
    Btn $f "CLEAR" 195 530 150 50 {
        if (Confirm "ล้าง System Note ทั้งหมดหรือไม่?") {
            Clear-Content -LiteralPath $NoteFile -ErrorAction SilentlyContinue
            Refresh-NoteBox
        }
    } | Out-Null
    Btn $f "CLOSE" 435 530 150 50 { $f.Close() } | Out-Null

    [void]$f.ShowDialog()
}

