# LARZONE // DEBLOAT V3.2
# DEBLOAT / GAMING / SYSTEM / RAM are separated.
# NORMAL/HIGH do not modify Keyboard, Mouse, Win32 or RAM.
# CUSTOM allows independent values. Backup is verified before Apply.

Add-Type -AssemblyName System.Windows.Forms
Add-Type -AssemblyName System.Drawing
[System.Windows.Forms.Application]::EnableVisualStyles()
$ErrorActionPreference="Continue"

$Root="$env:ProgramData\LARZONE\DebloatV3.2"
$BackupRoot="$Root\Backups"
$ControlKey="HKLM:\SYSTEM\CurrentControlSet\Control"
$KeyboardKey="HKLM:\SYSTEM\CurrentControlSet\Services\kbdclass\Parameters"
$MouseKey="HKLM:\SYSTEM\CurrentControlSet\Services\mouclass\Parameters"

$RamValues=[ordered]@{
 "Default"=0x380000;"4 GB"=0x400000;"6 GB"=0x600000;"8 GB"=0x800000
 "12 GB"=0xC00000;"16 GB"=0x1000000;"24 GB"=0x1800000
 "32 GB"=0x2000000;"64 GB"=0x4000000
}

# Conservative debloat apps; no critical input/network/audio services are touched.
$DebloatApps=@(
"Microsoft.BingNews","Microsoft.BingWeather","Microsoft.GetHelp",
"Microsoft.Getstarted","Microsoft.MicrosoftOfficeHub",
"Microsoft.MicrosoftSolitaireCollection","Microsoft.People",
"Microsoft.Todos","Microsoft.WindowsFeedbackHub","Microsoft.WindowsMaps",
"Microsoft.Xbox.TCUI","Microsoft.XboxGamingOverlay",
"Microsoft.XboxIdentityProvider","Microsoft.XboxSpeechToTextOverlay",
"Microsoft.ZuneMusic","Microsoft.ZuneVideo"
)

function Msg($t,$title="LARZONE",$icon=64){[void][Windows.Forms.MessageBox]::Show($t,$title,0,$icon)}
function Dir($p){if(!(Test-Path -LiteralPath $p)){New-Item -ItemType Directory -Path $p -Force|Out-Null};Test-Path -LiteralPath $p}
function GetD($p,$n){try{(Get-ItemProperty -Path $p -Name $n -ErrorAction Stop).$n}catch{$null}}
function SetD($p,$n,[uint32]$v){if(!(Test-Path -LiteralPath $p)){New-Item -Path $p -Force|Out-Null};New-ItemProperty -Path $p -Name $n -PropertyType DWord -Value $v -Force|Out-Null}
function Hex($v){if($null-eq$v){"NOT SET"}else{"0x{0:X}"-f([uint32]$v)}}

function ExportChecked($key,$file){
 & reg.exe export $key $file /y *> $null
 $c=$LASTEXITCODE
 [pscustomobject]@{Key=$key;Success=($c -eq 0 -and (Test-Path -LiteralPath $file));ExitCode=$c}
}

function Backup {
 Dir $BackupRoot|Out-Null
 $folder=Join-Path $BackupRoot (Get-Date -Format "yyyyMMdd_HHmmss")
 Dir $folder|Out-Null
 $r=@(
  (ExportChecked "HKLM\SYSTEM\CurrentControlSet\Control" (Join-Path $folder "Control.reg")),
  (ExportChecked "HKLM\SYSTEM\CurrentControlSet\Services\kbdclass\Parameters" (Join-Path $folder "Keyboard.reg")),
  (ExportChecked "HKLM\SYSTEM\CurrentControlSet\Services\mouclass\Parameters" (Join-Path $folder "Mouse.reg"))
 )
 $r|ConvertTo-Json -Depth 5|Set-Content (Join-Path $folder "BackupReport.json") -Encoding UTF8
 $bad=@($r|Where-Object{!$_.Success})
 if($bad.Count){Msg ("BACKUP ไม่สมบูรณ์`r`n`r`n"+(($bad|ForEach-Object{"$($_.Key) : exit $($_.ExitCode)"})-join "`r`n")) "LARZONE // BACKUP" 16;return $null}
 $folder
}

function Status {
 $os=Get-CimInstance Win32_OperatingSystem
 $cpu=Get-CimInstance Win32_Processor|Select-Object -First 1
 $gpu=Get-CimInstance Win32_VideoController|Where-Object Name|Select-Object -First 1
 $ram=[math]::Round((Get-CimInstance Win32_ComputerSystem).TotalPhysicalMemory/1GB,1)
 @(
 "SYSTEM NOTE","────────────────────────────",
 "CPU     : $($cpu.Name)","GPU     : $($gpu.Name)","RAM     : $ram GB",
 "Windows : $($os.Caption)","Build   : $($os.BuildNumber)",
 "","CURRENT VALUES","────────────────────────────",
 "Win32   : $(Hex(GetD $ControlKey 'Win32PrioritySeparation'))",
 "Keyboard: $(Hex(GetD $KeyboardKey 'KeyboardDataQueueSize'))",
 "Mouse   : $(Hex(GetD $MouseKey 'MouseDataQueueSize'))",
 "RAM     : $(Hex(GetD $ControlKey 'SvcHostSplitThresholdInKB'))",
 "","NORMAL / HIGH = no Keyboard / Mouse / Win32 / RAM",
 "CUSTOM = Keyboard / Mouse / Win32 editable","RAM = separate profile","GPEDIT = removed"
 )-join "`r`n"
}

function Debloat {
 $b=Backup;if(!$b){return}
 $done=0;$skip=0
 foreach($n in $DebloatApps){
  try{
   $apps=Get-AppxPackage -AllUsers -Name $n -ErrorAction SilentlyContinue
   if($apps){foreach($a in $apps){Remove-AppxPackage -Package $a.PackageFullName -AllUsers -ErrorAction SilentlyContinue;$done++}}
   else{$skip++}
  }catch{$skip++}
 }
 Msg "DEBLOAT เสร็จแล้ว`r`n`r`nจัดการ: $done รายการ`r`nไม่พบ/ข้าม: $skip รายการ`r`n`r`nBackup:`r`n$b" "LARZONE // DEBLOAT"
}

function Quick($name){
 $b=Backup;if(!$b){return}
 foreach($n in $DebloatApps){
  try{$apps=Get-AppxPackage -AllUsers -Name $n -ErrorAction SilentlyContinue;foreach($a in $apps){Remove-AppxPackage -Package $a.PackageFullName -AllUsers -ErrorAction SilentlyContinue}}catch{}
 }
 Msg "$name เสร็จแล้ว`r`n`r`nKeyboard / Mouse / Win32 / RAM = ไม่เปลี่ยน`r`n`r`nBackup:`r`n$b" "LARZONE // $name"
}

