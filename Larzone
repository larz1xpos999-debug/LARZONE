function Log($Text) {
    Add-Content -LiteralPath $LogFile -Value ("[{0}] {1}" -f (Get-Date -Format "yyyy-MM-dd HH:mm:ss"),$Text)
}

function Set-RegDword($Path,$Name,[int]$Value) {
    New-Item -Path $Path -Force | Out-Null
    New-ItemProperty -Path $Path -Name $Name -PropertyType DWord -Value $Value -Force | Out-Null
    Log "REG DWORD $Path\$Name = $Value"
}

function Set-RegString($Path,$Name,$Value) {
    New-Item -Path $Path -Force | Out-Null
    New-ItemProperty -Path $Path -Name $Name -PropertyType String -Value $Value -Force | Out-Null
    Log "REG STRING $Path\$Name = $Value"
}

function Remove-RegValueSafe($Path,$Name) {
    if (Test-Path $Path) {
        Remove-ItemProperty -Path $Path -Name $Name -ErrorAction SilentlyContinue
        Log "REG REMOVE $Path\$Name"
    }
}

function Backup-RegistryKey($KeyPath,$OutFile) {
    & reg.exe export $KeyPath $OutFile /y | Out-Null
}

function New-LarzoneBackup($Profile="MANUAL") {
    $stamp = Get-Date -Format "yyyyMMdd_HHmmss"
    $dir = Join-Path $BackupRoot "${stamp}_$Profile"
    New-Item -ItemType Directory -Force -Path $dir | Out-Null

    try {
        Backup-RegistryKey "HKCU\Software\Microsoft\Windows\CurrentVersion\Explorer" (Join-Path $dir "Explorer.reg")
        Backup-RegistryKey "HKCU\Software\Microsoft\Windows\CurrentVersion\ContentDeliveryManager" (Join-Path $dir "ContentDelivery.reg")
        Backup-RegistryKey "HKCU\Software\Microsoft\Windows\CurrentVersion\Search" (Join-Path $dir "Search.reg")
        Backup-RegistryKey "HKLM\SOFTWARE\Microsoft\Windows NT\CurrentVersion\Multimedia\SystemProfile" (Join-Path $dir "SystemProfile.reg")
        Backup-RegistryKey "HKLM\SOFTWARE\Microsoft\Windows NT\CurrentVersion\Multimedia\SystemProfile\Tasks\Games" (Join-Path $dir "Games.reg")
    } catch {}

    try {
        powercfg /getactivescheme | Out-File (Join-Path $dir "PowerPlan.txt") -Encoding utf8
        powercfg /query | Out-File (Join-Path $dir "PowerPlan_Query.txt") -Encoding utf8
    } catch {}

    try {
        Get-CimInstance Win32_StartupCommand |
            Select-Object Name,Command,Location,User |
            Export-Csv (Join-Path $dir "Startup.csv") -NoTypeInformation -Encoding UTF8
    } catch {}

    try {
        Get-CimInstance Win32_Service |
            Select-Object Name,StartMode,State |
            Export-Csv (Join-Path $dir "Services.csv") -NoTypeInformation -Encoding UTF8
    } catch {}

    try {
        Get-AppxPackage -AllUsers |
            Select-Object Name,PackageFullName |
            Export-Csv (Join-Path $dir "Appx.csv") -NoTypeInformation -Encoding UTF8
    } catch {}

    Set-Content -Path (Join-Path $dir "PROFILE.txt") -Value @"
LARZONE V3.2 BACKUP
Profile: $Profile
Date: $(Get-Date)
Computer: $env:COMPUTERNAME
User: $env:USERNAME
"@ -Encoding UTF8

    Log "BACKUP CREATED: $dir"
    return $dir
}

function Restore-Backup($Dir) {
    if (-not (Test-Path $Dir)) { return }
    Get-ChildItem $Dir -Filter *.reg | ForEach-Object {
        & reg.exe import $_.FullName | Out-Null
    }
    $power = Join-Path $Dir "PowerPlan.txt"
    Log "RESTORE REGISTRY FROM: $Dir"
}

function Get-RamText {
    try {
        $m = Get-CimInstance Win32_ComputerSystem
        $gb = [math]::Round($m.TotalPhysicalMemory/1GB,1)
        return "$gb GB"
    } catch { return "Unknown" }
}

function Get-SystemInfo {
    $cpu = (Get-CimInstance Win32_Processor | Select-Object -First 1 -ExpandProperty Name)
    $gpu = (Get-CimInstance Win32_VideoController | Select-Object -First 1 -ExpandProperty Name)
    $os = Get-CimInstance Win32_OperatingSystem
    [pscustomobject]@{
        CPU = $cpu
        GPU = $gpu
        RAM = Get-RamText
        Windows = $os.Caption
        Build = $os.BuildNumber
    }
}

# ---------- Safe gaming tweaks ----------
function Apply-Normal {
    New-LarzoneBackup "NORMAL"
    # Game DVR / background capture off; does not touch input or RAM.
    Set-RegDword "HKCU:\System\GameConfigStore" "GameDVR_Enabled" 0
    Set-RegDword "HKCU:\SOFTWARE\Microsoft\Windows\CurrentVersion\GameDVR" "AppCaptureEnabled" 0
    Set-RegDword "HKCU:\SOFTWARE\Microsoft\Windows\CurrentVersion\GameDVR" "AudioCaptureEnabled" 0
    Set-RegDword "HKCU:\SOFTWARE\Microsoft\GameBar" "ShowStartupPanel" 0
    Log "NORMAL profile applied"
}

function Apply-High {
    Apply-Normal
    # Prefer performance without forcing unsupported BCD/timer changes.
    Set-RegDword "HKCU:\Software\Microsoft\Windows\CurrentVersion\Explorer\VisualEffects" "VisualFXSetting" 2
    Set-RegDword "HKCU:\Software\Microsoft\Windows\CurrentVersion\Themes\Personalize" "EnableTransparency" 0
    Set-RegDword "HKCU:\Software\Microsoft\Windows\CurrentVersion\GameDVR" "HistoricalCaptureEnabled" 0

    # Windows Game Mode
    Set-RegDword "HKCU:\Software\Microsoft\GameBar" "AllowAutoGameMode" 1
    Set-RegDword "HKCU:\Software\Microsoft\GameBar" "AutoGameModeEnabled" 1

    # Multimedia Games task: conservative scheduling values.
    Set-RegDword "HKLM:\SOFTWARE\Microsoft\Windows NT\CurrentVersion\Multimedia\SystemProfile" "SystemResponsiveness" 10
    Set-RegDword "HKLM:\SOFTWARE\Microsoft\Windows NT\CurrentVersion\Multimedia\SystemProfile\Tasks\Games" "GPU Priority" 8
    Set-RegDword "HKLM:\SOFTWARE\Microsoft\Windows NT\CurrentVersion\Multimedia\SystemProfile\Tasks\Games" "Priority" 6
    Set-RegString "HKLM:\SOFTWARE\Microsoft\Windows NT\CurrentVersion\Multimedia\SystemProfile\Tasks\Games" "Scheduling Category" "High"
    Log "HIGH profile applied"
}

function Apply-GpuSafe {
    # Windows graphics preference: leave HAGS itself to the OS/user if unsupported.
    Set-RegDword "HKCU:\Software\Microsoft\Windows\CurrentVersion\GameDVR" "AppCaptureEnabled" 0
    Log "GPU/graphics safe profile applied"
}

function Apply-InputSafe {
    # Mouse acceleration off. No Win32 priority / RAM modification.
    Set-RegDword "HKCU:\Control Panel\Mouse" "MouseSpeed" 0
    Set-RegDword "HKCU:\Control Panel\Mouse" "MouseThreshold1" 0
    Set-RegDword "HKCU:\Control Panel\Mouse" "MouseThreshold2" 0
    Set-RegString "HKCU:\Control Panel\Mouse" "MouseSensitivity" "10"
    Log "Input safe profile applied"
}

function Apply-WindowsUi {
    Set-RegDword "HKCU:\Software\Microsoft\Windows\CurrentVersion\Themes\Personalize" "EnableTransparency" 0
    Set-RegDword "HKCU:\Software\Microsoft\Windows\CurrentVersion\Explorer\Advanced" "TaskbarAnimations" 0
    Set-RegDword "HKCU:\Software\Microsoft\Windows\CurrentVersion\Explorer\Advanced" "ListviewAlphaSelect" 0
    Set-RegDword "HKCU:\Software\Microsoft\Windows\CurrentVersion\Explorer\Advanced" "TaskbarMn" 0
    Log "Windows UI profile applied"
}

function Apply-Privacy {
    Set-RegDword "HKCU:\Software\Microsoft\Windows\CurrentVersion\AdvertisingInfo" "Enabled" 0
    Set-RegDword "HKCU:\Software\Microsoft\Windows\CurrentVersion\ContentDeliveryManager" "SubscribedContent-338388Enabled" 0
    Set-RegDword "HKCU:\Software\Microsoft\Windows\CurrentVersion\ContentDeliveryManager" "SubscribedContent-353694Enabled" 0
    Set-RegDword "HKCU:\Software\Microsoft\Windows\CurrentVersion\ContentDeliveryManager" "SubscribedContent-353696Enabled" 0
    Set-RegDword "HKCU:\Software\Microsoft\Windows\CurrentVersion\ContentDeliveryManager" "SystemPaneSuggestionsEnabled" 0
    Log "Privacy profile applied"
}

function Apply-Background {
    Set-RegDword "HKCU:\Software\Microsoft\Windows\CurrentVersion\BackgroundAccessApplications" "GlobalUserDisabled" 1
    Set-RegDword "HKCU:\Software\Microsoft\Windows\CurrentVersion\Search" "BackgroundAppGlobalToggle" 0
    Log "Background app profile applied"
}

function Apply-Telemetry {
    Set-RegDword "HKCU:\Software\Microsoft\Siuf\Rules" "NumberOfSIUFInPeriod" 0
    Set-RegDword "HKCU:\Software\Microsoft\Siuf\Rules" "PeriodInNanoSeconds" 0
    Set-RegDword "HKLM:\SOFTWARE\Policies\Microsoft\Windows\DataCollection" "AllowTelemetry" 1
    Log "Telemetry profile applied (minimum supported diagnostic level)"
}

function Apply-Gaming {
    Apply-Normal
    Set-RegDword "HKCU:\Software\Microsoft\GameBar" "AllowAutoGameMode" 1
    Set-RegDword "HKCU:\Software\Microsoft\GameBar" "AutoGameModeEnabled" 1
    Log "Gaming profile applied"
}

function Apply-PowerHigh {
    $list = (powercfg /list) -join "`n"
    $ultimate = $null
    if ($list -match "Ultimate Performance") {
        $ultimate = [regex]::Match($list,'([a-f0-9-]{36}).*Ultimate Performance').Groups[1].Value
    }
    if ($ultimate) {
        powercfg /setactive $ultimate
        Log "Ultimate Performance activated"
    } else {
        powercfg /setactive SCHEME_MAX
        Log "High performance scheme activated"
    }
}

function Apply-Selected($items) {
    New-LarzoneBackup "CUSTOM"
    foreach ($item in $items) {
        switch ($item) {
            "Windows UI" { Apply-WindowsUi }
            "Privacy" { Apply-Privacy }
            "Telemetry" { Apply-Telemetry }
            "Background Apps" { Apply-Background }
            "Gaming" { Apply-Gaming }
            "Input / Mouse" { Apply-InputSafe }
            "Power / CPU" { Apply-PowerHigh }
            "GPU / Graphics" { Apply-GpuSafe }
        }
    }
    Log "CUSTOM SELECTED APPLIED: $($items -join ', ')"
}

