}

function Verify-Tweak([string]$Id) {
    if ($NoVerify) { return $true }

    switch ($Id) {
        'AdvertisingID' { return ((Get-RegValue 'HKCU:\Software\Microsoft\Windows\CurrentVersion\AdvertisingInfo' 'Enabled') -eq 0) }
        'TailoredExperiences' { return ((Get-RegValue 'HKCU:\Software\Microsoft\Windows\CurrentVersion\Privacy' 'TailoredExperiencesWithDiagnosticDataEnabled') -eq 0) }
        'FeedbackRequests' { return ((Get-RegValue 'HKCU:\Software\Microsoft\Siuf\Rules' 'NumberOfSIUFInPeriod') -eq 0) }
        'ActivityHistory' { return ((Get-RegValue 'HKLM:\SOFTWARE\Policies\Microsoft\Windows\System' 'EnableActivityFeed') -eq 0) }
        'Location' { return ((Get-RegValue 'HKLM:\SOFTWARE\Policies\Microsoft\Windows\LocationAndSensors' 'DisableLocation') -eq 1) }
        'ConsumerFeatures' { return ((Get-RegValue 'HKLM:\SOFTWARE\Policies\Microsoft\Windows\CloudContent' 'DisableWindowsConsumerFeatures') -eq 1) }
        'Suggestions' { return ((Get-RegValue 'HKCU:\Software\Microsoft\Windows\CurrentVersion\ContentDeliveryManager' 'SystemPaneSuggestionsEnabled') -eq 0) }
        'Widgets' {
            $v1 = (Get-RegValue 'HKLM:\SOFTWARE\Policies\Microsoft\Dsh' 'AllowNewsAndInterests')
            $v2 = (Get-RegValue 'HKLM:\SOFTWARE\Policies\Microsoft\Dsh' 'AllowWidgets')
            # ถ้า key ไหนไม่มี จะได้ $null; ให้ผ่านเมื่อค่าใดค่าหนึ่ง "ถูกปิด" หรือทั้งสองไม่มี (บางรุ่น windows อาจไม่รองรับ policy นี้)
            return (($v1 -eq 0) -or ($v2 -eq 0) -or (($null -eq $v1) -and ($null -eq $v2)))
        }
        'Copilot' { return ((Get-RegValue 'HKCU:\Software\Policies\Microsoft\Windows\WindowsCopilot' 'TurnOffWindowsCopilot') -eq 1) }
        'Transparency' { return ((Get-RegValue 'HKCU:\Software\Microsoft\Windows\CurrentVersion\Themes\Personalize' 'EnableTransparency') -eq 0) }
        'TaskbarAnimations' { return ((Get-RegValue 'HKCU:\Software\Microsoft\Windows\CurrentVersion\Explorer\Advanced' 'TaskbarAnimations') -eq 0) }
        'VisualFX' { return ((Get-RegValue 'HKCU:\Software\Microsoft\Windows\CurrentVersion\Explorer\VisualEffects' 'VisualFXSetting') -eq 2) }
        'SearchHighlights' { return ((Get-RegValue 'HKCU:\Software\Microsoft\Windows\CurrentVersion\SearchSettings' 'IsDynamicSearchBoxEnabled') -eq 0) }
        'BackgroundApps' { return ((Get-RegValue 'HKCU:\Software\Microsoft\Windows\CurrentVersion\BackgroundAccessApplications' 'GlobalUserDisabled') -eq 1) }
        'StartupSuggestions' { return ((Get-RegValue 'HKCU:\Software\Microsoft\Windows\CurrentVersion\ContentDeliveryManager' 'SubscribedContent-338393Enabled') -eq 0) }
        'GameDVR' { return ((Get-RegValue 'HKCU:\System\GameConfigStore' 'GameDVR_Enabled') -eq 0) }
        'GameCapture' { return ((Get-RegValue 'HKCU:\SOFTWARE\Microsoft\Windows\CurrentVersion\GameDVR' 'AppCaptureEnabled') -eq 0) }
        'GameBar' { return ((Get-RegValue 'HKCU:\Software\Microsoft\GameBar' 'UseNexusForGameBarEnabled') -eq 0) }
        'Animations' {
            $a = (Get-RegValue 'HKCU:\Software\Microsoft\Windows\CurrentVersion\Explorer\Advanced' 'TaskbarAnimations')
            $m = (Get-RegValue 'HKCU:\Control Panel\Desktop\WindowMetrics' 'MinAnimate')
            return (($a -eq 0) -and ("$m" -eq '0'))
        }
        default { return $true }
    }
}

function Invoke-ApplySelected([string[]]$SelectedIds, [string]$BackupProfileName) {
    if (-not $SelectedIds -or $SelectedIds.Count -eq 0) { return @() }

    $backup = New-Backup $BackupProfileName
    $results = @()

    foreach ($id in $SelectedIds) {
        try {
            Apply-Tweak $id
            $ok = Verify-Tweak $id
            $results += [pscustomobject]@{ Id = $id; OK = [bool]$ok }
            if ($ok) { Write-Log "VERIFY OK $id" } else { Write-Log "VERIFY FAIL $id" 'WARN' }
        } catch {
            Write-Log "ERROR $id : $($_.Exception.Message)" 'ERROR'
            $results += [pscustomobject]@{ Id = $id; OK = $false; Error = $_.Exception.Message }
        }
    }

    $okCount = @($results | Where-Object OK).Count
    $badCount = @($results | Where-Object { -not $_.OK }).Count
    Add-SystemNote ("{0} → Applied {1}, Verified {2}, Failed {3}" -f $BackupProfileName, $SelectedIds.Count, $okCount, $badCount)
    return $results
}

