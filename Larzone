function Restore-LastBackup {
    $d=$S.LastBackup
    if (-not $d -or -not (Test-Path $d)) { [Windows.Forms.MessageBox]::Show('ยังไม่มี Backup ล่าสุด','LARZONE v3','OK','Warning') | Out-Null; return }
    $answer=[Windows.Forms.MessageBox]::Show("Restore Registry จาก Backup นี้?`n`n$d`n`nคำเตือน: Registry/Service จะคืนได้ แต่ AppX ที่ถอนออกอาจไม่ถูกติดตั้งกลับอัตโนมัติ",'LARZONE v3','YesNo','Warning')
    if ($answer -ne 'Yes') { return }
    foreach ($reg in @(Get-ChildItem $d -Filter '*.reg' -ErrorAction SilentlyContinue)) {
        & reg.exe import $reg.FullName *> $null
        Log "Restored registry: $($reg.Name)"
    }
    Restore-Services $d
    $script:S.Normal=$false; $script:S.High=$false; $script:S.Custom=$false; $script:S.LastMode='RESTORED'; $script:S.LastRun=(Get-Date).ToString('s'); Save-State; Refresh-Main
    [Windows.Forms.MessageBox]::Show('Restore Registry/Service เสร็จแล้ว`nแนะนำให้ Restart Windows','LARZONE v3','OK','Information') | Out-Null
}

