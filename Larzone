    if($uiChecks | Where-Object Checked){$names+="Windows UI"}
    Apply-Selected $names
    if($debloatChecks | Where-Object Checked){
        Apply-Debloat ($debloatChecks | Where-Object Checked | ForEach-Object Text)
    }
    if($serviceChecks | Where-Object Checked){
        Set-SelectedServices ($serviceChecks | Where-Object Checked | ForEach-Object Text)
    }
    $status.Text="STATUS: CUSTOM APPLIED"
})
$custom.Controls.Add($applyCustom)

