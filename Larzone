    $mode.ForeColor = [System.Drawing.Color]::LightGreen
    $mode.AutoSize = $true
    $mode.Location = New-Object System.Drawing.Point(760,78)
    $f.Controls.Add($mode)

    $items = [ordered]@{
        "Privacy / Telemetry" = @(
            @{Id="Telemetry"; Text="ปิด Telemetry / Diagnostic Data"},
            @{Id="ActivityHistory"; Text="ปิด Activity History"},
            @{Id="TailoredExperiences"; Text="ปิด Tailored Experiences / Personalization"},
            @{Id="Location"; Text="ปิด Location Access"}
        )
        "Windows / Debloat" = @(
            @{Id="ConsumerFeatures"; Text="ปิด Consumer Features / Suggested Apps"},
            @{Id="Suggestions"; Text="ปิด Windows Suggestions / Recommended Content"},
            @{Id="Widgets"; Text="ปิด Widgets"},
            @{Id="BackgroundApps"; Text="ปิด Background Apps"}
        )
        "UI / Explorer" = @(
            @{Id="SearchHighlights"; Text="ปิด Search Highlights / Cloud Search"},
            @{Id="Transparency"; Text="ปิด Transparency"},
            @{Id="Animations"; Text="ปิด Taskbar Animations"},
            @{Id="VisualEffects"; Text="Best Performance Visual Effects"},
            @{Id="ExplorerThisPC"; Text="Explorer เปิด This PC"}
        )
        "Gaming / Performance" = @(
            @{Id="GameDVR"; Text="ปิด Game DVR / Captures"},
            @{Id="GameMode"; Text="เปิด Game Mode"},
            @{Id="InputMouse"; Text="Mouse Input / Acceleration Tweak"},
            @{Id="HighPerformance"; Text="High Performance Power Plan"}
        )
        "Optional" = @(
            @{Id="Copilot"; Text="ปิด Windows Copilot"},
            @{Id="FastStartup"; Text="เปิด Fast Startup"}
        )
    }

    $list = New-Object System.Windows.Forms.CheckedListBox
    $list.Font = $font
    $list.ForeColor = [System.Drawing.Color]::White
    $list.BackColor = [System.Drawing.Color]::FromArgb(12,18,30)
    $list.BorderStyle = "FixedSingle"
    $list.CheckOnClick = $true
    $list.Location = New-Object System.Drawing.Point(35,120)
    $list.Size = New-Object System.Drawing.Size(930,480)
    $f.Controls.Add($list)

    $map = @{}
    foreach ($cat in $items.Keys) {
        [void]$list.Items.Add("===== $cat =====", $false)
        $catIndex = $list.Items.Count - 1
        $map[$catIndex] = $null

        foreach ($it in $items[$cat]) {
            $idx = $list.Items.Add("  " + $it.Text, $false)
            $map[$idx] = $it.Id
        }
    }

    # Default: balanced gaming/debloat profile; optional/destructive choices stay off.
    $defaultIds = @(
        "Telemetry","ActivityHistory","TailoredExperiences",
        "ConsumerFeatures","Suggestions","Widgets","BackgroundApps",
        "SearchHighlights","Transparency","Animations","VisualEffects",
        "GameDVR","GameMode"
    )
    for ($i=0; $i -lt $list.Items.Count; $i++) {
        if ($map[$i] -and ($defaultIds -contains $map[$i])) {
            $list.SetItemChecked($i,$true)
        }
    }

    Make-Button $f "DEFAULT" 35 620 170 60 {
        for ($i=0; $i -lt $list.Items.Count; $i++) {
            $list.SetItemChecked($i,$false)
            if ($map[$i] -and ($defaultIds -contains $map[$i])) {
                $list.SetItemChecked($i,$true)
            }
        }
        $mode.Text = "MODE : DEFAULT"
    } | Out-Null

    Make-Button $f "CUSTOM" 225 620 170 60 {
        $mode.Text = "MODE : CUSTOM"
    } | Out-Null

    Make-Button $f "ALL ON" 415 620 170 60 {
        for ($i=0; $i -lt $list.Items.Count; $i++) {
            if ($map[$i]) { $list.SetItemChecked($i,$true) }
        }
        $mode.Text = "MODE : CUSTOM / ALL"
    } | Out-Null

    Make-Button $f "ALL OFF" 605 620 170 60 {
        for ($i=0; $i -lt $list.Items.Count; $i++) {
            $list.SetItemChecked($i,$false)
        }
        $mode.Text = "MODE : CUSTOM / EMPTY"
    } | Out-Null

    Make-Button $f "APPLY SELECTED" 795 620 170 60 {
        $selected = @()
        for ($i=0; $i -lt $list.Items.Count; $i++) {
            if ($map[$i] -and $list.GetItemChecked($i)) {
                $selected += $map[$i]
            }
        }

        if ($selected.Count -eq 0) {
            Info "ยังไม่ได้เลือก tweak"
            return
        }

        if (-not (Confirm ("จะ Apply $($selected.Count) tweak ที่เลือก`r`n`r`n" +
            (($selected | ForEach-Object { "- " + $_ }) -join "`r`n") +
            "`r`n`r`nจะสร้าง Backup ก่อนดำเนินการต่อ"))) {
            return
        }
        foreach ($id in $selected) {
            Apply-CustomTweak $id
        }
        Info "Apply CUSTOM / DEBLOAT เสร็จแล้ว"
    } | Out-Null

    [void]$f.ShowDialog()
}

# ---------- Debloat ----------
function Open-Debloat {
    $f = New-SimpleWindow "LARZONE // DEBLOAT" 980 720
    Add-Title $f "DEBLOAT"

    $sub = New-Object System.Windows.Forms.Label
    $sub.Text = "DEFAULT = รายการที่แนะนำ | CUSTOM = เลือกเปิด/ปิดแต่ละรายการเอง"
    $sub.Font = $font
    $sub.AutoSize = $true
    $sub.Location = New-Object System.Drawing.Point(35,75)
    $f.Controls.Add($sub)

    $checks = @{}
    $y = 155
    $column = 0

    foreach ($name in $Apps.Keys) {
        $cb = New-Object System.Windows.Forms.CheckBox
        $cb.Text = $name
        $cb.Font = $font
        $cb.ForeColor = [System.Drawing.Color]::White
        $cb.AutoSize = $true

        if ($column -eq 0) {
            $cb.Location = New-Object System.Drawing.Point(45,$y)
        } else {
            $cb.Location = New-Object System.Drawing.Point(430,$y)
        }

        $f.Controls.Add($cb)
        $checks[$name] = $cb

        if ($column -eq 1) {
            $column = 0
            $y += 38
        } else {
            $column = 1
        }
    }

    # Recommended default: conservative removable consumer apps.
    $defaultApps = @(
        "Feedback Hub",
        "Get Help",
        "Get Started",
        "Solitaire",
        "People",
        "Weather",
        "News",
        "Maps",
        "3D Viewer"
    )

    foreach ($name in $defaultApps) {
        if ($checks.ContainsKey($name)) { $checks[$name].Checked = $true }
    }

    Make-Button $f "DEFAULT" 45 500 180 60 {
        foreach ($c in $checks.Values) { $c.Checked = $false }
        foreach ($name in $defaultApps) {
            if ($checks.ContainsKey($name)) { $checks[$name].Checked = $true }
        }
        $mode.Text = "MODE : DEFAULT"
    } | Out-Null

    Make-Button $f "CUSTOM" 245 500 180 60 {
        $mode.Text = "MODE : CUSTOM"
    } | Out-Null

    Make-Button $f "ALL ON" 445 500 160 60 {
        foreach ($c in $checks.Values) { $c.Checked = $true }
        $mode.Text = "MODE : CUSTOM / ALL"
    } | Out-Null

    Make-Button $f "ALL OFF" 625 500 160 60 {
        foreach ($c in $checks.Values) { $c.Checked = $false }
        $mode.Text = "MODE : CUSTOM / EMPTY"
    } | Out-Null

    $mode = New-Object System.Windows.Forms.Label
    $mode.Text = "MODE : DEFAULT"
    $mode.Font = $font
    $mode.ForeColor = [System.Drawing.Color]::LightGreen
    $mode.AutoSize = $true
    $mode.Location = New-Object System.Drawing.Point(800,520)
    $f.Controls.Add($mode)

    Make-Button $f "REMOVE SELECTED" 45 590 360 65 {
        $selected = @(
            $checks.GetEnumerator() |
            Where-Object { $_.Value.Checked } |
            ForEach-Object Key
        )
        if ($selected.Count -eq 0) {
            Info "ยังไม่ได้เลือกแอป"
            return
        }
        if (Confirm ("จะลบ $($selected.Count) รายการ:`r`n" + ($selected -join ", ") + "`r`n`r`nดำเนินการต่อหรือไม่?")) {
            Apply-Debloat $selected
            Info "Debloat เสร็จแล้ว"
        }
    } | Out-Null

    Make-Button $f "BACK" 425 590 170 65 { $f.Close() } | Out-Null
    Make-Button $f "CLOSE" 615 590 170 65 { $f.Close() } | Out-Null

    [void]$f.ShowDialog()
}

# ---------- System ----------
function Open-System {
    $f = New-SimpleWindow "LARZONE // SYSTEM" 760 540
    Add-Title $f "SYSTEM"

    $info = Get-CimInstance Win32_ComputerSystem
    $os = Get-CimInstance Win32_OperatingSystem
    $cpu = (Get-CimInstance Win32_Processor | Select-Object -First 1).Name
    $gpu = (Get-CimInstance Win32_VideoController | Select-Object -First 1).Name
    $ram = [math]::Round($info.TotalPhysicalMemory/1GB,1)

    $l = New-Object System.Windows.Forms.Label
    $l.Text = "CPU : $cpu`r`nGPU : $gpu`r`nRAM : $ram GB`r`nWindows : $($os.Caption)`r`nBuild : $($os.BuildNumber)"
    $l.Font = $font
    $l.AutoSize = $true
    $l.Location = New-Object System.Drawing.Point(40,95)
    $f.Controls.Add($l)

    Make-Button $f "KEYBOARD / MOUSE" 40 270 250 65 {
        Apply-Input
        Info "Input profile ถูก Apply แล้ว"
    } | Out-Null

    Make-Button $f "RAM PROFILE" 310 270 180 65 {
        Info "RAM profile ใช้เป็นข้อมูล/โปรไฟล์ของเครื่องมือ`r`nไม่บังคับล็อก RAM หรือแบ่ง RAM ปลอมให้ GPU"
    } | Out-Null

    Make-Button $f "REFRESH" 510 270 170 65 {
        $l.Text = "CPU : $((Get-CimInstance Win32_Processor | Select -First 1).Name)`r`nGPU : $((Get-CimInstance Win32_VideoController | Select -First 1).Name)`r`nRAM : $([math]::Round((Get-CimInstance Win32_ComputerSystem).TotalPhysicalMemory/1GB,1)) GB`r`nWindows : $((Get-CimInstance Win32_OperatingSystem).Caption)`r`nBuild : $((Get-CimInstance Win32_OperatingSystem).BuildNumber)"
    } | Out-Null

    Make-Button $f "ปิด" 280 400 200 55 { $f.Close() } | Out-Null
    [void]$f.ShowDialog()
}

# ---------- Backup ----------
function Open-Backup {
    $f = New-SimpleWindow "LARZONE // BACKUP / RESTORE" 850 600
    Add-Title $f "BACKUP / RESTORE"

    $list = New-Object System.Windows.Forms.ListBox
    $list.Font = $font
    $list.Location = New-Object System.Drawing.Point(35,90)
    $list.Size = New-Object System.Drawing.Size(770,300)
    $f.Controls.Add($list)

    function Refresh-List {
        $list.Items.Clear()
        Get-ChildItem $BackupRoot -Directory -ErrorAction SilentlyContinue |
            Sort-Object LastWriteTime -Descending |
            ForEach-Object { [void]$list.Items.Add($_.FullName) }
    }
    Refresh-List

    Make-Button $f "CREATE BACKUP" 35 420 220 60 {
        New-Backup "MANUAL"
        Refresh-List
        Info "สร้าง Backup แล้ว"
    } | Out-Null

    Make-Button $f "RESTORE SELECTED" 275 420 250 60 {
        if (-not $list.SelectedItem) { Info "กรุณาเลือก Backup"; return }
        if (Confirm "Restore Registry จาก Backup นี้หรือไม่?") {
            Restore-Backup ([string]$list.SelectedItem)
            Info "Restore เสร็จแล้ว แนะนำ Restart Windows"
        }
    } | Out-Null

    Make-Button $f "REFRESH" 545 420 120 60 { Refresh-List } | Out-Null
    Make-Button $f "ปิด" 665 420 140 60 { $f.Close() } | Out-Null
    [void]$f.ShowDialog()
}

