}

# CUSTOM values explicitly supplied in the previous configuration.
$RamMap = [ordered]@{
    '4 GB'  = 0x400000
    '6 GB'  = 0x600000
    '8 GB'  = 0x800000
    '12 GB' = 0xC00000
    '16 GB' = 0x1000000
    '24 GB' = 0x1800000
    '32 GB' = 0x2000000
    '64 GB' = 0x4000000
}

function Apply-CustomValues([string]$RamChoice,[bool]$ApplyRam,[bool]$ApplyWin32,[bool]$ApplyKeyboard,[bool]$ApplyMouse) {
    $b = Do-Backup
    $changed = New-Object System.Collections.Generic.List[string]

    if ($ApplyRam) {
        $v = [uint32]$RamMap[$RamChoice]
        Set-Dword 'HKLM\SYSTEM\CurrentControlSet\Control' 'SvcHostSplitThresholdInKB' $v
        $script:S.Ram = "$RamChoice -> 0x$('{0:X}' -f $v)"
        $changed.Add("RAM profile: $RamChoice / SvcHostSplitThresholdInKB = 0x$('{0:X}' -f $v)")
    }

    if ($ApplyWin32) {
        # User-specified value: fff9887 (stored as DWORD hexadecimal).
        $v = [uint32]0x0FFF9887
        Set-Dword 'HKLM\SYSTEM\CurrentControlSet\Control\PriorityControl' 'Win32PrioritySeparation' $v
        $script:S.Win32 = '0x0FFF9887'
        $changed.Add('Win32PrioritySeparation = 0x0FFF9887')
    }

    if ($ApplyKeyboard) {
        Set-Dword 'HKLM\SYSTEM\CurrentControlSet\Services\kbdclass\Parameters' 'KeyboardDataQueueSize' 16
        $script:S.Keyboard = '16 decimal'
        $changed.Add('KeyboardDataQueueSize = 16 decimal')
    }

    if ($ApplyMouse) {
        Set-Dword 'HKLM\SYSTEM\CurrentControlSet\Services\mouclass\Parameters' 'MouseDataQueueSize' 25
        $script:S.Mouse = '25 decimal'
        $changed.Add('MouseDataQueueSize = 25 decimal')
    }

    if ($changed.Count -eq 0) {
        [Windows.Forms.MessageBox]::Show('ยังไม่ได้เลือกค่าที่ต้องการ Apply','LARZONE v3','OK','Warning') | Out-Null
        return
    }

    $script:S.Custom = $true; $script:S.LastMode = 'CUSTOM'; $script:S.LastRun = (Get-Date).ToString('s')
    Save-State
    foreach ($x in $changed) { Log $x }
    Refresh-Main
    [Windows.Forms.MessageBox]::Show(("CUSTOM เสร็จแล้ว`n`n" + ($changed -join "`n") + "`n`nBackup: $b"),'LARZONE v3','OK','Information') | Out-Null
}

function Open-Gpedit {
    if (-not (Get-Command gpedit.msc -ErrorAction SilentlyContinue)) {
        try { Start-Process 'gpedit.msc' -ErrorAction Stop }
        catch {
            [Windows.Forms.MessageBox]::Show('เครื่องนี้ไม่พบ gpedit.msc หรือ Windows edition ไม่รองรับ Local Group Policy Editor','LARZONE v3','OK','Warning') | Out-Null
            Log 'GPEDIT unavailable.'
            return
        }
    } else {
        Start-Process 'gpedit.msc'
    }
    $script:S.GpeditOpened = $true; Save-State; Log 'GPEDIT opened (manual policy configuration).'
}

function Get-SystemInfo {
    try { $cpu = (Get-CimInstance Win32_Processor | Select-Object -First 1 -ExpandProperty Name).Trim() } catch { $cpu='ไม่ทราบ' }
    try { $gpu = ((Get-CimInstance Win32_VideoController | Select-Object -ExpandProperty Name) -join ' / ').Trim() } catch { $gpu='ไม่ทราบ' }
    try {
        $cv = Get-ItemProperty 'HKLM:\SOFTWARE\Microsoft\Windows NT\CurrentVersion'
        $win = "$($cv.ProductName) $($cv.DisplayVersion) (Build $($cv.CurrentBuild))"
    } catch { $win='ไม่ทราบ' }
    try { $ram = [math]::Round((Get-CimInstance Win32_ComputerSystem).TotalPhysicalMemory/1GB,1) } catch { $ram='ไม่ทราบ' }
    [pscustomobject]@{CPU=$cpu;GPU=$gpu;Windows=$win;RAM="$ram GB"}
}

function Check-Row([string]$Name,[bool]$OK,[string]$Detail) {
    $mark = if ($OK) { 'OK' } else { 'NOT OK' }
    return ("{0,-24} [{1,-6}] {2}" -f $Name,$mark,$Detail)
}

function StatusText {
    $a = New-Object System.Collections.Generic.List[string]
    $sys = Get-SystemInfo
    $a.Add('LARZONE // CHECK STATUS v3')
    $a.Add('==============================================')
    $a.Add(("CPU    : {0}" -f $sys.CPU))
    $a.Add(("GPU    : {0}" -f $sys.GPU))
    $a.Add(("WINDOWS: {0}" -f $sys.Windows))
    $a.Add(("RAM    : {0}" -f $sys.RAM))
    $a.Add('')
    $a.Add('PROFILE STATE')
    $a.Add('----------------------------------------------')
    $a.Add((Check-Row 'NORMAL' $S.Normal $(if($S.Normal){'state says applied'}else{'not selected'})))
    $a.Add((Check-Row 'HIGH' $S.High $(if($S.High){'state says applied'}else{'not selected'})))
    $a.Add((Check-Row 'CUSTOM' $S.Custom $(if($S.Custom){'state says applied'}else{'not selected'})))
    $a.Add((Check-Row 'GPEDIT' $S.GpeditOpened $(if($S.GpeditOpened){'opened manually'}else{'not opened by tool'})))
    $a.Add('')
    $a.Add('CUSTOM REGISTRY - REAL VALUES')
    $a.Add('----------------------------------------------')

    $w = Get-Dword 'HKLM\SYSTEM\CurrentControlSet\Control\PriorityControl' 'Win32PrioritySeparation'
    $a.Add((Check-Row 'Win32PrioritySeparation' ($null -ne $w -and $w -eq [uint32]0x0FFF9887) $(if($null -eq $w){'missing'}else{'current = 0x{0:X}' -f $w})))

    $split = Get-Dword 'HKLM\SYSTEM\CurrentControlSet\Control' 'SvcHostSplitThresholdInKB'
    $ramKnown = $false; $ramName='not set'
    foreach ($pair in $RamMap.GetEnumerator()) { if ($null -ne $split -and $split -eq [uint32]$pair.Value) { $ramKnown=$true; $ramName=$pair.Key } }
    $a.Add((Check-Row 'RAM / SvcHostSplit' $ramKnown $(if($null -eq $split){'missing'}else{'current = 0x{0:X} ({1})' -f $split,$ramName})))

    $kb = Get-Dword 'HKLM\SYSTEM\CurrentControlSet\Services\kbdclass\Parameters' 'KeyboardDataQueueSize'
    $a.Add((Check-Row 'KeyboardDataQueueSize' ($null -ne $kb -and $kb -eq 16) $(if($null -eq $kb){'missing'}else{'current = {0} decimal' -f $kb})))

    $mouse = Get-Dword 'HKLM\SYSTEM\CurrentControlSet\Services\mouclass\Parameters' 'MouseDataQueueSize'
    $a.Add((Check-Row 'MouseDataQueueSize' ($null -ne $mouse -and $mouse -eq 25) $(if($null -eq $mouse){'missing'}else{'current = {0} decimal' -f $mouse})))

    $a.Add('')
    $a.Add('SERVICES')
    $a.Add('----------------------------------------------')
    foreach ($n in @('MapsBroker','DiagTrack')) {
        try {
            $s=Get-Service $n -ErrorAction Stop
            $c=Get-CimInstance Win32_Service -Filter "Name='$n'"
            $a.Add(("{0,-24} {1,-10} StartMode={2}" -f $n,$s.Status,$c.StartMode))
        } catch { $a.Add(("{0,-24} NOT FOUND" -f $n)) }
    }

    $a.Add('')
    $a.Add('APPX CHECK')
    $a.Add('----------------------------------------------')
    foreach ($n in @('Microsoft.GetHelp','Microsoft.Getstarted','Microsoft.People','Microsoft.WindowsFeedbackHub','Microsoft.BingNews','Microsoft.BingWeather','Microsoft.MicrosoftSolitaireCollection','Microsoft.YourPhone')) {
        try { $count=@(Get-AppxPackage -AllUsers -Name $n -ErrorAction SilentlyContinue).Count; $state=if($count){'PRESENT'}else{'REMOVED / ABSENT'}; $a.Add(("{0,-38} {1}" -f $n,$state)) }
        catch { $a.Add(("{0,-38} CHECK FAILED" -f $n)) }
    }

    $a.Add('')
    $a.Add('LAST ACTION')
    $a.Add('----------------------------------------------')
    $a.Add("Mode   : $($S.LastMode)")
    $a.Add("Run    : $($S.LastRun)")
    $a.Add("Backup : $($S.LastBackup)")
    $a.Add('')
    $a.Add('Note: GPEDIT is opened manually; this tool does not claim a policy was applied unless it changes a Registry value itself.')
    return ($a -join [Environment]::NewLine)
}

