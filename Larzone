# ---------- System Profiles ----------
function Parse-Number($text) {
    $t=[string]$text; $t=$t.Trim()
    if($t -match '^(0x)?[0-9a-fA-F]{1,8}$' -and ($t -match '[a-fA-F]' -or $t.StartsWith('0x'))) {
        return [uint32]([Convert]::ToUInt64(($t -replace '^0x',''),16))
    }
    $n=0L
    if([long]::TryParse($t,[ref]$n) -and $n -ge 0 -and $n -le 4294967295){return [uint32]$n}
    throw "Invalid number"
}

function Open-SystemProfile($Type) {
    $f=New-Window "LARZONE // $Type" 620 420; Title $f $Type
    $label=New-Object Windows.Forms.Label; $label.Text=$Type; $label.AutoSize=$true; $label.Font=New-Object Drawing.Font("Segoe UI Semibold",12); $label.Location=New-Object Drawing.Point(45,90); $f.Controls.Add($label)
    $box=New-Object Windows.Forms.TextBox; $box.Font=New-Object Drawing.Font("Segoe UI",12); $box.Location=New-Object Drawing.Point(45,125); $box.Size=New-Object Drawing.Size(360,38); $f.Controls.Add($box)
    $hint=New-Object Windows.Forms.Label; $hint.AutoSize=$true; $hint.ForeColor=[Drawing.Color]::LightGray; $hint.Location=New-Object Drawing.Point(45,172); $f.Controls.Add($hint)
    if($Type -eq "KEYBOARD"){$box.Text="16";$hint.Text="ใส่ตัวเลขได้อิสระ";$path='HKLM:\SYSTEM\CurrentControlSet\Services\kbdclass\Parameters';$name='KeyboardDataQueueSize';$default='16';$hex=$false}
    elseif($Type -eq "MOUSE"){$box.Text="25";$hint.Text="ใส่ตัวเลขได้อิสระ";$path='HKLM:\SYSTEM\CurrentControlSet\Services\mouclass\Parameters';$name='MouseDataQueueSize';$default='25';$hex=$false}
    elseif($Type -eq "WIN32"){$box.Text="FFF9887";$hint.Text="Hex DWORD • Default = FFF9887";$path='HKLM:\SYSTEM\CurrentControlSet\Control\PriorityControl';$name='Win32PrioritySeparation';$default='FFF9887';$hex=$true}
    elseif($Type -eq "NETWORK"){$box.Text="FFFFFFFF";$hint.Text="Hex DWORD • Default = FFFFFFFF";$path='HKLM:\SOFTWARE\Microsoft\Windows NT\CurrentVersion\Multimedia\SystemProfile';$name='NetworkThrottlingIndex';$default='FFFFFFFF';$hex=$true}
    else{$f.Close();return}
    Btn $f "DEFAULT" 45 225 150 50 {$box.Text=$default}|Out-Null
    Btn $f "APPLY" 215 225 150 50 {
        try{
            if($hex){$value=Parse-Number $box.Text}else{$tmp=0;if(-not [int]::TryParse($box.Text,[ref]$tmp)-or$tmp-lt0){throw "Invalid number"};$value=[uint32]$tmp}
            if(-not(Confirm "Apply $Type = $($box.Text)?")){return}
            $backup=New-Backup $Type; Dword $path $name $value
            $actual=(Get-ItemProperty -Path $path -Name $name -EA Stop).$name; $ok=([uint32]$actual -eq [uint32]$value)
            if($ok){Add-SystemNote("$Type → $($box.Text) ✓");Info "Apply สำเร็จ`r`nVerify: SUCCESS`r`nBackup: $backup"}else{Add-SystemNote("$Type → Verify FAILED");Info "Verify ไม่ผ่าน"}
        }catch{Add-SystemNote("$Type → FAILED: $($_.Exception.Message)");Info "Apply ไม่สำเร็จ`r`n$($_.Exception.Message)"}
    }|Out-Null
    Btn $f "BACK" 385 225 150 50 {$f.Close()}|Out-Null
    [void]$f.ShowDialog()
}

