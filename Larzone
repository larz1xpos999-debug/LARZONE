function Clear-FiveM-Cache {
    param(
        [Parameter(Mandatory=$true)][System.Windows.Forms.TextBox]$LogBox
    )

    $localAppData = [Environment]::GetFolderPath("LocalApplicationData")
    $appData = [Environment]::GetFolderPath("ApplicationData")

    # เส้นทางยอดนิยมของ FiveM
    $paths = @(
        (Join-Path $localAppData "FiveM\FiveM.app\data\cache"),
        (Join-Path $localAppData "FiveM\FiveM.app\data\server-cache"),
        (Join-Path $localAppData "FiveM\FiveM.app\data\server-cache-priv"),
        (Join-Path $localAppData "FiveM\FiveM.app\crashes"),
        (Join-Path $appData "CitizenFX\cache")
    )

    foreach ($p in $paths) {
        # เคลียร์เฉพาะ "ของในโฟลเดอร์" เพื่อไม่ทำให้เส้นทางหลักหายไป
        if (Test-Path -LiteralPath $p) {
            try {
                Get-ChildItem -LiteralPath $p -Force -ErrorAction Stop | ForEach-Object {
                    Remove-PathSafe -Path $_.FullName -LogBox $LogBox
                }
            } catch {
                Write-Log -LogBox $LogBox -Level "ERR" -Message "เคลียร์ไม่สำเร็จที่: $p | $($_.Exception.Message)"
            }
        } else {
            Write-Log -LogBox $LogBox -Level "WARN" -Message "ไม่พบโฟลเดอร์แคช: $p"
        }
    }

    Write-Log -LogBox $LogBox -Level "OK" -Message "ทำความสะอาดแคช FiveM เสร็จแล้ว"
}

function Disable-Xbox-GameBar {
    param([Parameter(Mandatory=$true)][System.Windows.Forms.TextBox]$LogBox)

    try {
        # ปิด Game Bar / Game DVR (บางเครื่องต้องสิทธิ์แอดมินถึงจะเขียนได้)
        $reg1 = "HKCU:\SOFTWARE\Microsoft\Windows\CurrentVersion\GameDVR"
        Ensure-Dir -Path $reg1
        New-ItemProperty -Path $reg1 -Name "AppCaptureEnabled" -PropertyType DWord -Value 0 -Force | Out-Null

        $reg2 = "HKCU:\System\GameConfigStore"
        Ensure-Dir -Path $reg2
        New-ItemProperty -Path $reg2 -Name "GameDVR_Enabled" -PropertyType DWord -Value 0 -Force | Out-Null

        Write-Log -LogBox $LogBox -Level "OK" -Message "ตั้งค่าปิด Xbox Game Bar/Game DVR แล้ว (อาจต้องรีสตาร์ต/ออก-เข้าใหม่)"
    } catch {
        Write-Log -LogBox $LogBox -Level "ERR" -Message "ปิด Xbox Game Bar ไม่สำเร็จ | $($_.Exception.Message)"
    }
}

function Set-HighPerformancePowerPlan {
    param([Parameter(Mandatory=$true)][System.Windows.Forms.TextBox]$LogBox)
    try {
        # SCHEME_MIN = High performance (ถ้ามี)
        $null = & powercfg /setactive SCHEME_MIN 2>$null
        if ($LASTEXITCODE -eq 0) {
            Write-Log -LogBox $LogBox -Level "OK" -Message "ตั้งค่า Power Plan เป็น High performance แล้ว"
        } else {
            Write-Log -LogBox $LogBox -Level "WARN" -Message "ตั้งค่า Power Plan ไม่สำเร็จ (อาจไม่มีแผนนี้ หรือจำเป็นต้องรันแบบแอดมิน)"
        }
    } catch {
        Write-Log -LogBox $LogBox -Level "ERR" -Message "ตั้งค่า Power Plan ไม่สำเร็จ | $($_.Exception.Message)"
    }
}

function Backup-RegistryKey {
    param(
        [Parameter(Mandatory=$true)][string]$RegPath,
        [Parameter(Mandatory=$true)][string]$OutFile,
        [Parameter(Mandatory=$true)][System.Windows.Forms.TextBox]$LogBox
    )
    try {
        $outDir = Split-Path -Parent $OutFile
        if (-not (Test-Path -LiteralPath $outDir)) {
            New-Item -ItemType Directory -Path $outDir -Force | Out-Null
        }
        $null = & reg.exe export $RegPath $OutFile /y
        if ($LASTEXITCODE -eq 0) {
            Write-Log -LogBox $LogBox -Level "OK" -Message "สำรอง Registry แล้ว: $OutFile"
        } else {
            Write-Log -LogBox $LogBox -Level "WARN" -Message "สำรอง Registry ไม่สำเร็จ: $RegPath (อาจไม่มีคีย์นี้)"
        }
    } catch {
        Write-Log -LogBox $LogBox -Level "ERR" -Message "สำรอง Registry ไม่สำเร็จ: $RegPath | $($_.Exception.Message)"
    }
}

function Set-RegistryTweaksForFiveM {
    param(
        [Parameter(Mandatory=$true)][System.Windows.Forms.TextBox]$LogBox
    )

    if (-not (Test-IsAdmin)) {
        Write-Log -LogBox $LogBox -Level "WARN" -Message "ข้ามการปรับ Registry: ต้องรันแบบแอดมิน"
        return $false
    }

    $stamp = (Get-Date).ToString("yyyyMMdd_HHmmss")
    $backupDir = Join-Path $PSScriptRoot "Backups"

    # สำรองคีย์ที่จะแก้
    Backup-RegistryKey -RegPath "HKLM\SOFTWARE\Microsoft\Windows NT\CurrentVersion\Multimedia\SystemProfile\Tasks\Games" -OutFile (Join-Path $backupDir "Tasks_Games_$stamp.reg") -LogBox $LogBox
    Backup-RegistryKey -RegPath "HKLM\SYSTEM\CurrentControlSet\Control\PriorityControl" -OutFile (Join-Path $backupDir "PriorityControl_$stamp.reg") -LogBox $LogBox
    Backup-RegistryKey -RegPath "HKLM\SYSTEM\CurrentControlSet\Services\kbdclass\Parameters" -OutFile (Join-Path $backupDir "kbdclass_Parameters_$stamp.reg") -LogBox $LogBox
    Backup-RegistryKey -RegPath "HKLM\SYSTEM\CurrentControlSet\Services\mouclass\Parameters" -OutFile (Join-Path $backupDir "mouclass_Parameters_$stamp.reg") -LogBox $LogBox

    try {
        Write-Log -LogBox $LogBox -Level "INFO" -Message "กำลังใส่ค่า Registry สำหรับโหมด Games..."

        $gamesKey = "Registry::HKEY_LOCAL_MACHINE\SOFTWARE\Microsoft\Windows NT\CurrentVersion\Multimedia\SystemProfile\Tasks\Games"
        if (-not (Test-Path -LiteralPath $gamesKey)) {
            New-Item -Path $gamesKey -Force | Out-Null
        }

        # ตามค่าที่ผู้ใช้ให้มา
        New-ItemProperty -Path $gamesKey -Name "GPU Priority" -PropertyType DWord -Value 8 -Force | Out-Null
        New-ItemProperty -Path $gamesKey -Name "Priority" -PropertyType DWord -Value 6 -Force | Out-Null
        New-ItemProperty -Path $gamesKey -Name "Scheduling Category" -PropertyType String -Value "High" -Force | Out-Null
        New-ItemProperty -Path $gamesKey -Name "SFIO Priority" -PropertyType DWord -Value 6 -Force | Out-Null

        Write-Log -LogBox $LogBox -Level "OK" -Message "ตั้งค่า Tasks\\Games แล้ว (GPU Priority=8, Priority=6, Scheduling Category=High, SFIO Priority=6)"

        $prioKey = "Registry::HKEY_LOCAL_MACHINE\SYSTEM\CurrentControlSet\Control\PriorityControl"
        if (-not (Test-Path -LiteralPath $prioKey)) {
            New-Item -Path $prioKey -Force | Out-Null
        }
        # Win32PrioritySeparation = 0x1a
        New-ItemProperty -Path $prioKey -Name "Win32PrioritySeparation" -PropertyType DWord -Value 0x1A -Force | Out-Null
        Write-Log -LogBox $LogBox -Level "OK" -Message "ตั้งค่า Win32PrioritySeparation = 0x1A แล้ว"

        $kbdKey = "Registry::HKEY_LOCAL_MACHINE\SYSTEM\CurrentControlSet\Services\kbdclass\Parameters"
        if (-not (Test-Path -LiteralPath $kbdKey)) {
            New-Item -Path $kbdKey -Force | Out-Null
        }
        New-ItemProperty -Path $kbdKey -Name "KeyboardDataQueueSize" -PropertyType DWord -Value 20 -Force | Out-Null
        Write-Log -LogBox $LogBox -Level "OK" -Message "ตั้งค่า KeyboardDataQueueSize = 20 แล้ว"

        $mouKey = "Registry::HKEY_LOCAL_MACHINE\SYSTEM\CurrentControlSet\Services\mouclass\Parameters"
        if (-not (Test-Path -LiteralPath $mouKey)) {
            New-Item -Path $mouKey -Force | Out-Null
        }
        New-ItemProperty -Path $mouKey -Name "MouseDataQueueSize" -PropertyType DWord -Value 25 -Force | Out-Null
        Write-Log -LogBox $LogBox -Level "OK" -Message "ตั้งค่า MouseDataQueueSize = 25 แล้ว"

        Write-Log -LogBox $LogBox -Level "INFO" -Message "แนะนำ: รีสตาร์ตเครื่อง 1 ครั้งเพื่อให้ค่าบางส่วนมีผล"
        return $true
    } catch {
        Write-Log -LogBox $LogBox -Level "ERR" -Message "ตั้งค่า Registry ไม่สำเร็จ | $($_.Exception.Message)"
        return $false
    }
}

function Get-TotalRamBytes {
    try {
        $cs = Get-CimInstance Win32_ComputerSystem
        if ($null -eq $cs -or -not $cs.TotalPhysicalMemory) { return 0 }
        return [int64]$cs.TotalPhysicalMemory
    } catch {
        return 0
    }
}

function Get-RecommendedSvcHostSplitThresholdHex {
    param([Parameter(Mandatory=$true)][int64]$TotalRamBytes)

    # ตารางตามค่าที่ผู้ใช้ให้มา (หน่วยเป็น "hex" ของ KB)
    # หมายเหตุ: เราจะใช้การ "ปัดขึ้น" เป็นระดับ RAM ที่ใกล้สุดในตาราง
    if ($TotalRamBytes -le 0) { return "380000" }

    $ramGB = [math]::Ceiling($TotalRamBytes / 1GB)

    if ($ramGB -le 4) { return "400000" }
    elseif ($ramGB -le 6) { return "600000" }
    elseif ($ramGB -le 8) { return "800000" }
    elseif ($ramGB -le 12) { return "C00000" }
    elseif ($ramGB -le 16) { return "1000000" }
    elseif ($ramGB -le 24) { return "1800000" }
    elseif ($ramGB -le 32) { return "2000000" }
    else { return "4000000" } # 64GB+
}

function Set-SvcHostSplitThresholdInKB {
    param(
        [Parameter(Mandatory=$true)][System.Windows.Forms.TextBox]$LogBox
    )

    if (-not (Test-IsAdmin)) {
        Write-Log -LogBox $LogBox -Level "WARN" -Message "ข้ามการลด Process (svchost): ต้องรันแบบแอดมิน"
        return $false
    }

    $totalBytes = Get-TotalRamBytes
    if ($totalBytes -le 0) {
        Write-Log -LogBox $LogBox -Level "ERR" -Message "ตรวจจับ RAM ไม่สำเร็จ"
        return $false
    }

    $hex = Get-RecommendedSvcHostSplitThresholdHex -TotalRamBytes $totalBytes
    $thresholdKB = [uint32]([Convert]::ToInt32($hex, 16))
    $ramGBExact = [math]::Round(($totalBytes / 1GB), 2)

    $stamp = (Get-Date).ToString("yyyyMMdd_HHmmss")
    $backupDir = Join-Path $PSScriptRoot "Backups"
    Backup-RegistryKey -RegPath "HKLM\SYSTEM\CurrentControlSet\Control" -OutFile (Join-Path $backupDir "Control_$stamp.reg") -LogBox $LogBox

    try {
        $controlKey = "Registry::HKEY_LOCAL_MACHINE\SYSTEM\CurrentControlSet\Control"
        if (-not (Test-Path -LiteralPath $controlKey)) {
            New-Item -Path $controlKey -Force | Out-Null
        }

        # คีย์นี้ช่วย "รวม" บริการกลับมารันใน svchost น้อยลง (ลดจำนวน process) เมื่อ threshold > RAM เครื่อง
        New-ItemProperty -Path $controlKey -Name "SvcHostSplitThresholdInKB" -PropertyType DWord -Value $thresholdKB -Force | Out-Null

        Write-Log -LogBox $LogBox -Level "OK" -Message "ตั้งค่า SvcHostSplitThresholdInKB = 0x$hex ($thresholdKB KB) แล้ว"
        Write-Log -LogBox $LogBox -Level "INFO" -Message "RAM ตรวจพบ ~ $ramGBExact GB (แนะนำรีสตาร์ต 1 ครั้ง)"
        return $true
    } catch {
        Write-Log -LogBox $LogBox -Level "ERR" -Message "ตั้งค่า SvcHostSplitThresholdInKB ไม่สำเร็จ | $($_.Exception.Message)"
        return $false
    }
}

