# LARZONE DEBLOAT - FiveM Edition
# Right click -> Run with PowerShell (Administrator)
$ErrorActionPreference='SilentlyContinue'
Add-Type -AssemblyName System.Windows.Forms
Add-Type -AssemblyName System.Drawing
[Windows.Forms.Application]::EnableVisualStyles()
$Root="$env:ProgramData\LarzoneDebloat";$Backup="$Root\Backups";$StateFile="$Root\state.json";$Log="$Root\larzone.log"
New-Item -ItemType Directory -Force -Path $Root,$Backup|Out-Null
function Admin{$p=New-Object Security.Principal.WindowsPrincipal([Security.Principal.WindowsIdentity]::GetCurrent());$p.IsInRole([Security.Principal.WindowsBuiltInRole]::Administrator)}
if(!(Admin)){[Windows.Forms.MessageBox]::Show('กรุณาเปิด PowerShell แบบ Administrator แล้วรันไฟล์นี้อีกครั้ง','LARZONE');exit}
function LoadState{if(Test-Path $StateFile){try{return Get-Content $StateFile -Raw|ConvertFrom-Json}catch{}};[pscustomobject]@{Normal=$false;High=$false;Custom=$false;Gpedit=$false;Ram='ยังไม่ได้ตั้ง';LastMode='ยังไม่เคยรัน';LastRun='';LastBackup=''}}
$script:S=LoadState
function SaveState{$script:S|ConvertTo-Json|Set-Content $StateFile -Encoding UTF8}
function Log($x){$l="[$(Get-Date -Format 'yyyy-MM-dd HH:mm:ss')] $x";Add-Content $Log $l -Encoding UTF8;if($script:LogBox){$script:LogBox.AppendText($l+"`r`n")}}
function DoBackup{$d=Join-Path $Backup (Get-Date -Format 'yyyyMMdd_HHmmss');New-Item -ItemType Directory -Force $d|Out-Null;foreach($k in @('HKLM\SOFTWARE\Microsoft\Windows NT\CurrentVersion\Multimedia\SystemProfile','HKLM\SYSTEM\CurrentControlSet\Control\PriorityControl','HKLM\SYSTEM\CurrentControlSet\Services\kbdclass\Parameters','HKLM\SYSTEM\CurrentControlSet\Services\mouclass\Parameters')){reg export $k (Join-Path $d (($k-replace '[\\/:*?"<>|]','_')+'.reg')) /y|Out-Null};$script:S.LastBackup=$d;SaveState;Log "Backup created: $d";return $d}
function App($n){$p=@(Get-AppxPackage -AllUsers -Name $n);if($p){$p|%{Remove-AppxPackage -Package $_.PackageFullName -AllUsers;Log "Removed $n"}}else{Log "Absent $n"}}
function Svc($n){$s=Get-Service $n;if($s){$m=(Get-CimInstance Win32_Service -Filter "Name='$n'").StartMode;if($m-ne'Disabled'){Set-Service $n -StartupType Disabled;Log "Disabled $n"}}}
function Normal{$b=DoBackup;@('Microsoft.GetHelp','Microsoft.Getstarted','Microsoft.People','Microsoft.WindowsFeedbackHub')|%{App $_};Svc 'MapsBroker';$script:S.Normal=$true;$script:S.High=$false;$script:S.LastMode='NORMAL';$script:S.LastRun=(Get-Date).ToString('s');SaveState;[Windows.Forms.MessageBox]::Show("NORMAL เสร็จแล้ว`nBackup: $b",'LARZONE');Refresh}
function High{$b=DoBackup;@('Microsoft.GetHelp','Microsoft.Getstarted','Microsoft.People','Microsoft.WindowsFeedbackHub','Microsoft.BingNews','Microsoft.BingWeather','Microsoft.MicrosoftSolitaireCollection','Microsoft.YourPhone')|%{App $_};Svc 'MapsBroker';Svc 'DiagTrack';$script:S.Normal=$false;$script:S.High=$true;$script:S.LastMode='HIGH';$script:S.LastRun=(Get-Date).ToString('s');SaveState;[Windows.Forms.MessageBox]::Show("HIGH เสร็จแล้ว`nBackup: $b",'LARZONE');Refresh}
function StatusText{$a=@('LARZONE STATUS','==============================',"NORMAL : $(if($S.Normal){'RAN'}else{'NOT RAN'})","HIGH   : $(if($S.High){'RAN'}else{'NOT RAN'})","CUSTOM : $(if($S.Custom){'RAN'}else{'NOT RAN'})","GPEDIT : $(if($S.Gpedit){'USED'}else{'NOT USED'})","RAM    : $($S.Ram)",'','CURRENT WINDOWS STATE','==============================');foreach($n in @('MapsBroker','DiagTrack')){$s=Get-Service $n;if($s){$a+="$n : $($s.Status) / $((Get-CimInstance Win32_Service -Filter "Name='$n'").StartMode)"}};foreach($n in @('Microsoft.GetHelp','Microsoft.Getstarted','Microsoft.People','Microsoft.WindowsFeedbackHub','Microsoft.BingNews','Microsoft.BingWeather','Microsoft.MicrosoftSolitaireCollection','Microsoft.YourPhone')){$a+="$n : $(if(@(Get-AppxPackage -AllUsers -Name $n).Count){'PRESENT'}else{'REMOVED / ABSENT'})"};$a+="`nLAST MODE: $($S.LastMode)";$a+="LAST RUN : $($S.LastRun)";$a+="BACKUP   : $($S.LastBackup)";$a-join "`r`n"}
function ShowStatus{$f=New-Object Windows.Forms.Form;$f.Text='LARZONE - CHECK STATUS';$f.Size=New-Object Drawing.Size(820,610);$f.StartPosition='CenterScreen';$f.BackColor=[Drawing.Color]::FromArgb(10,13,19);$b=New-Object Windows.Forms.TextBox;$b.Multiline=$true;$b.ReadOnly=$true;$b.ScrollBars='Both';$b.WordWrap=$false;$b.Font=New-Object Drawing.Font('Consolas',10);$b.BackColor=[Drawing.Color]::FromArgb(20,23,31);$b.ForeColor='White';$b.Location=New-Object Drawing.Point(25,25);$b.Size=New-Object Drawing.Size(750,450);$b.Text=StatusText;$f.Controls.Add($b);$r=New-Object Windows.Forms.Button;$r.Text='REFRESH';$r.Location=New-Object Drawing.Point(25,500);$r.Size=New-Object Drawing.Size(170,45);$r.Add_Click({$script:S=LoadState;$b.Text=StatusText;Refresh});$f.Controls.Add($r);$x=New-Object Windows.Forms.Button;$x.Text='BACK';$x.Location=New-Object Drawing.Point(215,500);$x.Size=New-Object Drawing.Size(170,45);$x.Add_Click({$f.Close()});$f.Controls.Add($x);[void]$f.ShowDialog()}
function Custom{$f=New-Object Windows.Forms.Form;$f.Text='LARZONE - CUSTOM';$f.Size=New-Object Drawing.Size(650,450);$f.StartPosition='CenterScreen';$f.BackColor=[Drawing.Color]::FromArgb(12,15,22);$g=New-Object Windows.Forms.CheckBox;$g.Text='GPEDIT - เปิด Local Group Policy';$g.ForeColor='White';$g.Location=New-Object Drawing.Point(30,60);$g.Size=New-Object Drawing.Size(500,40);$f.Controls.Add($g);$r=New-Object Windows.Forms.CheckBox;$r.Text='RAM PROFILE';$r.ForeColor='White';$r.Location=New-Object Drawing.Point(30,110);$r.Size=New-Object Drawing.Size(500,40);$f.Controls.Add($r);$c=New-Object Windows.Forms.ComboBox;$c.DropDownStyle='DropDownList';$c.Items.AddRange(@('4 GB','6 GB','8 GB','12 GB','16 GB','24 GB','32 GB','64 GB'));$c.SelectedItem='16 GB';$c.Location=New-Object Drawing.Point(55,160);$c.Size=New-Object Drawing.Size(150,30);$f.Controls.Add($c);$a=New-Object Windows.Forms.Button;$a.Text='APPLY CUSTOM';$a.Location=New-Object Drawing.Point(30,230);$a.Size=New-Object Drawing.Size(250,55);$a.Add_Click({if($g.Checked){Start-Process gpedit.msc;$S.Gpedit=$true;Log 'GPEDIT opened'};if($r.Checked){$S.Ram=$c.SelectedItem;Log "RAM profile $($c.SelectedItem)"};$S.Custom=$true;$S.LastMode='CUSTOM';$S.LastRun=(Get-Date).ToString('s');SaveState;$f.Close();Refresh});$f.Controls.Add($a);$x=New-Object Windows.Forms.Button;$x.Text='BACK';$x.Location=New-Object Drawing.Point(300,230);$x.Size=New-Object Drawing.Size(150,55);$x.Add_Click({$f.Close()});$f.Controls.Add($x);[void]$f.ShowDialog()}
function Restore{$d=$S.LastBackup;if(!$d-or!(Test-Path $d)){[Windows.Forms.MessageBox]::Show('ยังไม่มี Backup ล่าสุด','LARZONE');return};if([Windows.Forms.MessageBox]::Show('Restore Registry จาก Backup ล่าสุด?','LARZONE','YesNo','Warning')-ne'Yes'){return};Get-ChildItem $d -Filter '*.reg'|%{reg import $_.FullName|Out-Null;Log "Restored $($_.Name)"};$S.Normal=$false;$S.High=$false;$S.Custom=$false;$S.LastMode='RESTORED';SaveState;Refresh;[Windows.Forms.MessageBox]::Show('Restore เสร็จแล้ว','LARZONE')}
$form=New-Object Windows.Forms.Form;$form.Text='LARZONE DEBLOAT - FiveM';$form.Size=New-Object Drawing.Size(1100,700);$form.StartPosition='CenterScreen';$form.BackColor=[Drawing.Color]::FromArgb(8,10,15)
function Btn($t,$x,$y,$w,$h,$fn){$b=New-Object Windows.Forms.Button;$b.Text=$t;$b.Location=New-Object Drawing.Point($x,$y);$b.Size=New-Object Drawing.Size($w,$h);$b.Font=New-Object Drawing.Font('Segoe UI',12,[Drawing.FontStyle]::Bold);$b.BackColor=[Drawing.Color]::FromArgb(20,24,34);$b.ForeColor='White';$b.FlatStyle='Flat';$b.Add_Click($fn);$form.Controls.Add($b)}
