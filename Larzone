function Hex($v){if($null -eq $v){'NOT SET'}else{'0x{0:X}'-f([uint32]$v)}}
function Status-Report{$i=SysInfo;$a=@('LARZONE // CHECK STATUS','','SYSTEM',"Windows : $($i.Windows)","Build   : $($i.Build)","CPU     : $($i.CPU)","GPU     : $($i.GPU)","RAM     : $($i.RAM) GB",'','REGISTRY',"RAM / SvcHostSplitThresholdInKB : $(Hex(ReadD $Control 'SvcHostSplitThresholdInKB'))","Win32PrioritySeparation         : $(Hex(ReadD $Control 'Win32PrioritySeparation'))","KeyboardDataQueueSize            : $(Hex(ReadD $Kbd 'KeyboardDataQueueSize'))","MouseDataQueueSize               : $(Hex(ReadD $Mouse 'MouseDataQueueSize'))",'','OPTIONAL SERVICES');foreach($n in $OptionalServices){$s=Get-CimInstance Win32_Service -Filter "Name='$n'";if($s){$a+="$n : $($s.StartMode) / $($s.State)"}else{$a+="$n : NOT FOUND"}};$a+='';$a+='GPEDIT : NOT INCLUDED';$a-join "`r`n"}
