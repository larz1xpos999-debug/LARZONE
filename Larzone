function StatusMenu {
    Header "📊 STATUS"
    Write-Host ""
    Write-Host "Larzone state: " -NoNewline
    if(Test-Path $StateFile){Write-Host "AVAILABLE" -ForegroundColor Green}else{Write-Host "EMPTY" -ForegroundColor Yellow}
    Write-Host "State file: $StateFile"
    $latest=Get-ChildItem $BackupDir -Directory|Sort-Object Name -Descending|Select-Object -First 1
    Write-Host "Latest backup: " -NoNewline
    if($latest){Write-Host $latest.Name -ForegroundColor Green}else{Write-Host "NONE" -ForegroundColor Yellow}
    Write-Host ""
    Write-Host "FiveM core:"
    StatusLine "GPU" "GPU Priority = 8" (RegMatch $Games "GPU Priority" 8) "FiveM_GPU"
    StatusLine "PRI" "Game Priority = 6" (RegMatch $Games "Priority" 6) "FiveM_GamePriority"
    StatusLine "SCH" "Scheduling = High" (RegMatch $Games "Scheduling Category" "High") "FiveM_Scheduling"
    StatusLine "NET" "NetworkThrottlingIndex = FFFFFFFF" (RegMatch $MM "NetworkThrottlingIndex" 4294967295) "FiveM_NetworkThrottle"
    StatusLine "SYS" "SystemResponsiveness = 0" (RegMatch $MM "SystemResponsiveness" 0) "FiveM_SystemResponse"
    Write-Host ""
    Write-Host "Windows:"
    StatusLine "DVR" "GameDVR OFF" (RegMatch $GameDVR "AppCaptureEnabled" 0) "Windows_GameDVR"
    StatusLine "CFG" "GameConfigStore OFF" (RegMatch $GameConfig "GameDVR_Enabled" 0) "Windows_GameConfig"
    Write-Host ""
    Write-Host "Input:"
    StatusLine "MOU" "Mouse acceleration OFF" ((RegMatch $Mouse "MouseSpeed" 0) -and (RegMatch $Mouse "MouseThreshold1" 0) -and (RegMatch $Mouse "MouseThreshold2" 0)) "Mouse_Input"
    PauseMenu
}

