    $f.Size=New-Object System.Drawing.Size(900,560)
    $f.StartPosition='CenterScreen'
    $f.BackColor=[Drawing.Color]::FromArgb(12,14,19)

    $g=New-Object System.Windows.Forms.DataGridView
    $g.Location=New-Object System.Drawing.Point(20,70)
    $g.Size=New-Object System.Drawing.Size(840,380)
    $g.ReadOnly=$true; $g.AllowUserToAddRows=$false; $g.RowHeadersVisible=$false
    $g.AutoSizeColumnsMode='Fill'
    $g.BackgroundColor=[Drawing.Color]::FromArgb(20,23,30)
    $g.DefaultCellStyle.BackColor=[Drawing.Color]::FromArgb(25,28,36)
    $g.DefaultCellStyle.ForeColor=[Drawing.Color]::White
    $f.Controls.Add($g)

    $t=New-Object System.Windows.Forms.Label
    $t.Text='🔎 CHECK STATUS — คลิก REFRESH เพื่ออ่านสถานะล่าสุด'
    $t.ForeColor=[Drawing.Color]::White; $t.Font=New-Object Drawing.Font('Segoe UI',15,[Drawing.FontStyle]::Bold)
    $t.Location=New-Object Drawing.Point(20,20); $t.AutoSize=$true; $f.Controls.Add($t)

    function Refresh-Status {
        $data=@(
            [pscustomobject]@{Item='DEBLOAT'; Status=if($script:State.DebloatRun){'✓ ใช้แล้ว'}else{'—'}},
            [pscustomobject]@{Item='Privacy / Consumer Suggestions'; Status=if($script:State.Privacy){'✓ ใช้แล้ว'}else{'—'}},
            [pscustomobject]@{Item='Consumer App Cleanup'; Status=if($script:State.AppCleanup){'✓ ใช้แล้ว'}else{'—'}},
            [pscustomobject]@{Item='Selected Services'; Status=if($script:State.Services){'✓ ใช้แล้ว'}else{'—'}},
            [pscustomobject]@{Item='Last Action'; Status=$script:State.LastAction},
            [pscustomobject]@{Item='Last Run'; Status=$script:State.LastRun},
            [pscustomobject]@{Item='Backup'; Status=$script:State.BackupPath}
        )
        $g.DataSource=$null; $g.DataSource=$data
    }
    New-Button $f '↻ REFRESH' 20 465 180 40 {Refresh-Status}
    New-Button $f '← BACK' 215 465 180 40 {$f.Close()}
    Refresh-Status
    [void]$f.ShowDialog()
}

# -------------------- UI --------------------
function New-Button($Parent,$Text,$X,$Y,$W,$H,$Action){
    $b=New-Object System.Windows.Forms.Button
    $b.Text=$Text; $b.Location=New-Object Drawing.Point($X,$Y); $b.Size=New-Object Drawing.Size($W,$H)
    $b.FlatStyle='Flat'; $b.FlatAppearance.BorderSize=1
    $b.BackColor=[Drawing.Color]::FromArgb(28,31,40); $b.ForeColor=[Drawing.Color]::White
    $b.Font=New-Object Drawing.Font('Segoe UI',10,[Drawing.FontStyle]::Bold); $b.Cursor='Hand'
    $b.Add_MouseEnter({$this.BackColor=[Drawing.Color]::FromArgb(48,52,66)})
    $b.Add_MouseLeave({$this.BackColor=[Drawing.Color]::FromArgb(28,31,40)})
    $b.Add_Click($Action); $Parent.Controls.Add($b); return $b
}

