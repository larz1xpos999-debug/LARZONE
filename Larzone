function Apply-Tweak([string]$Id) {
    switch ($Id) {
        'AdvertisingID' {
            Set-RegDword 'HKCU:\Software\Microsoft\Windows\CurrentVersion\AdvertisingInfo' 'Enabled' 0
        }
        'TailoredExperiences' {
            Set-RegDword 'HKCU:\Software\Microsoft\Windows\CurrentVersion\Privacy' 'TailoredExperiencesWithDiagnosticDataEnabled' 0
        }
        'FeedbackRequests' {
            Set-RegDword 'HKCU:\Software\Microsoft\Siuf\Rules' 'NumberOfSIUFInPeriod' 0
        }
        'ActivityHistory' {
            Set-RegDword 'HKLM:\SOFTWARE\Policies\Microsoft\Windows\System' 'EnableActivityFeed' 0
            Set-RegDword 'HKLM:\SOFTWARE\Policies\Microsoft\Windows\System' 'PublishUserActivities' 0
            Set-RegDword 'HKLM:\SOFTWARE\Policies\Microsoft\Windows\System' 'UploadUserActivities' 0
        }
        'Location' {
            Set-RegDword 'HKLM:\SOFTWARE\Policies\Microsoft\Windows\LocationAndSensors' 'DisableLocation' 1
        }
        'ConsumerFeatures' {
            Set-RegDword 'HKLM:\SOFTWARE\Policies\Microsoft\Windows\CloudContent' 'DisableWindowsConsumerFeatures' 1
        }
        'Suggestions' {
            Set-RegDword 'HKCU:\Software\Microsoft\Windows\CurrentVersion\ContentDeliveryManager' 'SystemPaneSuggestionsEnabled' 0
            Set-RegDword 'HKCU:\Software\Microsoft\Windows\CurrentVersion\ContentDeliveryManager' 'SubscribedContent-338388Enabled' 0
        }
        'Widgets' {
            # รองรับทั้ง Win10 (News&Interests) และ Win11 (Widgets)
            Set-RegDword 'HKLM:\SOFTWARE\Policies\Microsoft\Dsh' 'AllowNewsAndInterests' 0
            Set-RegDword 'HKLM:\SOFTWARE\Policies\Microsoft\Dsh' 'AllowWidgets' 0
        }
        'Copilot' {
            Set-RegDword 'HKCU:\Software\Policies\Microsoft\Windows\WindowsCopilot' 'TurnOffWindowsCopilot' 1
        }
        'Transparency' {
            Set-RegDword 'HKCU:\Software\Microsoft\Windows\CurrentVersion\Themes\Personalize' 'EnableTransparency' 0
        }
        'TaskbarAnimations' {
            Set-RegDword 'HKCU:\Software\Microsoft\Windows\CurrentVersion\Explorer\Advanced' 'TaskbarAnimations' 0
        }
        'VisualFX' {
            Set-RegDword 'HKCU:\Software\Microsoft\Windows\CurrentVersion\Explorer\VisualEffects' 'VisualFXSetting' 2
        }
        'SearchHighlights' {
            Set-RegDword 'HKCU:\Software\Microsoft\Windows\CurrentVersion\SearchSettings' 'IsDynamicSearchBoxEnabled' 0
        }
        'BackgroundApps' {
            Set-RegDword 'HKCU:\Software\Microsoft\Windows\CurrentVersion\BackgroundAccessApplications' 'GlobalUserDisabled' 1
        }
        'StartupSuggestions' {
            Set-RegDword 'HKCU:\Software\Microsoft\Windows\CurrentVersion\ContentDeliveryManager' 'SubscribedContent-338393Enabled' 0
        }
        'GameDVR' {
            Set-RegDword 'HKCU:\System\GameConfigStore' 'GameDVR_Enabled' 0
        }
        'GameCapture' {
            Set-RegDword 'HKCU:\SOFTWARE\Microsoft\Windows\CurrentVersion\GameDVR' 'AppCaptureEnabled' 0
            Set-RegDword 'HKCU:\SOFTWARE\Microsoft\Windows\CurrentVersion\GameDVR' 'AudioCaptureEnabled' 0
        }
        'GameBar' {
            Set-RegDword 'HKCU:\Software\Microsoft\GameBar' 'UseNexusForGameBarEnabled' 0
        }
        'PowerPlan' {
            if ($PSCmdlet.ShouldProcess('powercfg', 'Set active scheme to High Performance')) {
                powercfg /setactive SCHEME_MAX | Out-Null
                Write-Log 'Power plan -> High Performance'
            }
        }
        'Animations' {
            # BUGFIX: MinAnimate ในหลายเครื่องเป็น REG_SZ ('0'/'1') ไม่ใช่ DWORD
            Set-RegDword  'HKCU:\Software\Microsoft\Windows\CurrentVersion\Explorer\Advanced' 'TaskbarAnimations' 0
            Set-RegString 'HKCU:\Control Panel\Desktop\WindowMetrics' 'MinAnimate' '0'
        }
        'OneDrive' {
            Write-Log 'OneDrive selected - removal intentionally not automatic in rewrite' 'WARN'
        }
        'DisableUpdate' {
            Write-Log 'DisableUpdate selected - intentionally blocked from automatic execution' 'WARN'
        }
        'DisableDefender' {
