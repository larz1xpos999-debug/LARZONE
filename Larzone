#requires -Version 5.1
<#
LARZONE V3.2.5 (Rewrite)
แนวทาง: Safe-first / ทำ Backup ก่อนแก้ / ตรวจสอบผล / มี Log / มี WhatIf

ข้อแนะนำด้านความปลอดภัย:
- หลีกเลี่ยงการรันแบบ `irm <url> | iex` เพราะเป็นการดาวน์โหลด+รันทันทีโดยไม่ตรวจสอบ
- วิธีที่ปลอดภัยกว่า: ดาวน์โหลดเป็นไฟล์ -> เปิดดูโค้ด -> (ถ้าต้องการ) คำนวณ hash -> ค่อยรัน
  ตัวอย่าง:
    Invoke-WebRequest -Uri 'https://example.com/LARZONE.ps1' -OutFile .\LARZONE.ps1
    Get-FileHash .\LARZONE.ps1 -Algorithm SHA256
    powershell -NoProfile -ExecutionPolicy Bypass -File .\LARZONE.ps1
#>

[CmdletBinding(SupportsShouldProcess = $true, ConfirmImpact = 'High')]
param(
    [ValidateSet('UI','CLI')]
    [string]$Mode = 'UI',

    # CLI mode:
    [ValidateSet('NORMAL','HIGH','CUSTOM')]
    [string]$Profile,

    # CLI mode for CUSTOM:
    [string[]]$TweakId,

    [switch]$NoBackup,
    [switch]$NoVerify,

    # ใช้สำหรับเทสต์/รันในระบบที่ไม่อยากเปิดหน้าต่าง (เช่นเช็ค syntax)
    [switch]$NoUI,

    # เก็บไฟล์ Backup/Log ที่ ProgramData ตามเดิม (ปรับได้)
    [string]$DataRoot = (Join-Path $env:ProgramData 'LARZONE\V3.2.5')
)

Set-StrictMode -Version Latest
$ErrorActionPreference = 'Stop'

function Test-IsAdmin {
    return ([Security.Principal.WindowsPrincipal][Security.Principal.WindowsIdentity]::GetCurrent()).IsInRole(
        [Security.Principal.WindowsBuiltInRole]::Administrator
    )
}

function Convert-ToNativeRegPath([string]$psPath) {
    # HKCU:\Software\X -> HKCU\Software\X  (สำหรับ reg.exe export/import เท่านั้น)
    $native = $psPath -replace '^HKLM:\\', 'HKLM\' -replace '^HKCU:\\', 'HKCU\'
    $native = $native -replace '^HKLM:', 'HKLM' -replace '^HKCU:', 'HKCU'
    return $native
}

function Ensure-Dir([string]$path) {
    New-Item -ItemType Directory -Path $path -Force | Out-Null
}

$Root = $DataRoot
$BackupRoot = Join-Path $Root 'Backups'
$LogRoot = Join-Path $Root 'Logs'
Ensure-Dir $BackupRoot
Ensure-Dir $LogRoot

$LogFile = Join-Path $LogRoot ("LARZONE_{0}.log" -f (Get-Date -Format 'yyyyMMdd_HHmmss'))
$NoteFile = Join-Path $LogRoot 'SystemNote.log'
if (-not (Test-Path $NoteFile)) { New-Item -ItemType File -Path $NoteFile -Force | Out-Null }

function Write-Log([string]$Message, [ValidateSet('INFO','WARN','ERROR')] [string]$Level = 'INFO') {
    $line = "[{0}] [{1}] {2}" -f (Get-Date -Format 'yyyy-MM-dd HH:mm:ss'), $Level, $Message
    Add-Content -LiteralPath $LogFile -Value $line -Encoding UTF8
}

function Add-SystemNote([string]$Message) {
    $line = "[{0}] {1}" -f (Get-Date -Format 'dd/MM HH:mm:ss'), $Message
    Add-Content -LiteralPath $NoteFile -Value $line -Encoding UTF8
    Write-Log "NOTE $Message"
}

function Get-SystemNotes {
    if (Test-Path $NoteFile) { return @(Get-Content -LiteralPath $NoteFile -Encoding UTF8) }
    return @()
}

function Get-MachineSummary {
    try {
        $cpu = (Get-CimInstance Win32_Processor | Select-Object -First 1).Name
        $gpu = (Get-CimInstance Win32_VideoController | Where-Object { $_.Name } | Select-Object -First 1).Name
        $ram = [math]::Round((Get-CimInstance Win32_ComputerSystem).TotalPhysicalMemory / 1GB, 0)
        return "เครื่อง: $env:COMPUTERNAME`r`nCPU: $cpu`r`nGPU: $gpu`r`nRAM: $ram GB"
    } catch {
        return "เครื่อง: $env:COMPUTERNAME"
    }
}

function Backup-RegKey([string]$nativeKey, [string]$outFile) {
    # ใช้ reg.exe export เพราะให้ไฟล์ .reg มาตรฐานและง่ายต่อ restore
    & reg.exe export $nativeKey $outFile /y | Out-Null
    if ($LASTEXITCODE -ne 0) { throw "Backup registry failed: $nativeKey -> $outFile (exit=$LASTEXITCODE)" }
}

function New-Backup([string]$profile = 'MANUAL') {
    if ($NoBackup) {
        Write-Log "Backup skipped (NoBackup) for profile=$profile" 'WARN'
        return $null
    }

    $dir = Join-Path $BackupRoot ("{0}_{1}" -f (Get-Date -Format 'yyyyMMdd_HHmmss'), $profile)
    Ensure-Dir $dir

    Backup-RegKey 'HKCU\Software\Microsoft\Windows\CurrentVersion\Explorer' (Join-Path $dir 'Explorer.reg')
    Backup-RegKey 'HKCU\Software\Microsoft\Windows\CurrentVersion\GameDVR' (Join-Path $dir 'GameDVR.reg')
    Backup-RegKey 'HKCU\Software\Microsoft\GameBar' (Join-Path $dir 'GameBar.reg')
    Backup-RegKey 'HKLM\SOFTWARE\Microsoft\Windows NT\CurrentVersion\Multimedia\SystemProfile' (Join-Path $dir 'SystemProfile.reg')
    Backup-RegKey 'HKCU\Control Panel\Mouse' (Join-Path $dir 'Mouse.reg')
    Backup-RegKey 'HKLM\SYSTEM\CurrentControlSet\Services\kbdclass\Parameters' (Join-Path $dir 'KeyboardClass.reg')
    Backup-RegKey 'HKLM\SYSTEM\CurrentControlSet\Services\mouclass\Parameters' (Join-Path $dir 'MouseClass.reg')
    Backup-RegKey 'HKLM\SYSTEM\CurrentControlSet\Control\PriorityControl' (Join-Path $dir 'PriorityControl.reg')

    try { powercfg /getactivescheme | Out-File (Join-Path $dir 'PowerPlan.txt') -Encoding UTF8 } catch {}
    try {
        Get-CimInstance Win32_Service |
            Select-Object Name, StartMode, State |
            Export-Csv (Join-Path $dir 'Services.csv') -NoTypeInformation -Encoding UTF8
    } catch {}

    Set-Content (Join-Path $dir 'INFO.txt') @"
LARZONE V3.2.5 BACKUP
Profile : $profile
Date    : $(Get-Date)
Computer: $env:COMPUTERNAME
"@ -Encoding UTF8

    Write-Log "BACKUP CREATED $dir"
    Add-SystemNote "Backup → Created ($profile)"
    return $dir
}

function Set-RegDword([string]$Path, [string]$Name, [uint32]$Value) {
    if ($PSCmdlet.ShouldProcess("$Path\$Name", "Set DWORD=$Value")) {
        New-Item -Path $Path -Force | Out-Null
        New-ItemProperty -Path $Path -Name $Name -PropertyType DWord -Value $Value -Force | Out-Null
        Write-Log "DWORD $Path\$Name=$Value"
    }
}

function Set-RegString([string]$Path, [string]$Name, [string]$Value) {
    if ($PSCmdlet.ShouldProcess("$Path\$Name", "Set STRING=$Value")) {
        New-Item -Path $Path -Force | Out-Null
        New-ItemProperty -Path $Path -Name $Name -PropertyType String -Value $Value -Force | Out-Null
        Write-Log "STRING $Path\$Name=$Value"
    }
}

function Get-RegValue([string]$Path, [string]$Name) {
    try {
        $p = Get-ItemProperty -Path $Path -Name $Name -ErrorAction Stop
        return $p.$Name
    } catch {
        return $null
    }
}

