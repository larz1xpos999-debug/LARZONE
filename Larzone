$ErrorActionPreference = "Continue"
$Key = "Larz1999"

Clear-Host
Write-Host "========================================"
Write-Host "          LARZ1 GAMING TOOLS"
Write-Host "========================================"
Write-Host ""

$identity = [Security.Principal.WindowsIdentity]::GetCurrent()
$principal = New-Object Security.Principal.WindowsPrincipal($identity)

if (-not $principal.IsInRole([Security.Principal.WindowsBuiltInRole]::Administrator)) {
    Write-Host "[X] Please run PowerShell as Administrator." -ForegroundColor Red
    Read-Host "Press Enter to exit"
    exit 1
}

$inputKey = Read-Host "Enter License Key"
if ($inputKey -cne $Key) {
    Write-Host "[X] Invalid Key!" -ForegroundColor Red
    Read-Host "Press Enter to exit"
    exit 1
}

Write-Host "[OK] Key Valid" -ForegroundColor Green
Write-Host ""

$Services = @(
    "SysMain","DiagTrack","dmwappushservice","MapsBroker","lfsvc",
    "XblAuthManager","XblGameSave","XboxNetApiSvc","XboxGipSvc",
    "Fax","RetailDemo","wisvc","WMPNetworkSvc","PhoneSvc",
    "SCardSvr","SCPolicySvc","ScDeviceEnum","CscService","WerSvc",
    "SharedAccess","WalletService","TokenBroker","PcaSvc","TrkWks",
    "AJRouter","CDPSvc","DusmSvc","WpcMonSvc"
)

$Success = 0
$Skipped = 0
$Failed = 0

foreach ($Name in $Services) {
    $svc = Get-Service -Name $Name -ErrorAction SilentlyContinue

    if ($null -eq $svc) {
        Write-Host "[SKIP] $Name - not installed" -ForegroundColor DarkYellow
        $Skipped++
        continue
    }

    try {
        Set-Service -Name $Name -StartupType Disabled -ErrorAction Stop
        Write-Host "[OK]   $Name -> Disabled" -ForegroundColor Green
        $Success++
    }
    catch {
        Write-Host "[FAIL] $Name -> $($_.Exception.Message)" -ForegroundColor Red
        $Failed++
    }
}

Write-Host ""
Write-Host "========================================"
Write-Host "                 RESULT"
Write-Host "========================================"
Write-Host "Success : $Success"
Write-Host "Skipped : $Skipped"
Write-Host "Failed  : $Failed"
Write-Host ""
Write-Host "Bluetooth services: NOT MODIFIED" -ForegroundColor Cyan
Write-Host "Restart Windows before testing FiveM." -ForegroundColor Yellow
Read-Host "Press Enter to exit"
