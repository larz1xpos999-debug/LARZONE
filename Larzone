$script:LogBox=New-Object Windows.Forms.TextBox;$script:LogBox.Multiline=$true;$script:LogBox.ReadOnly=$true;$script:LogBox.ScrollBars='Vertical';$script:LogBox.Font=New-Object Drawing.Font('Consolas',8);$script:LogBox.BackColor=[Drawing.Color]::FromArgb(9,11,16);$script:LogBox.ForeColor=[Drawing.Color]::FromArgb(180,200,220);$script:LogBox.Location=New-Object Drawing.Point(730,555);$script:LogBox.Size=New-Object Drawing.Size(320,90);$form.Controls.Add($script:LogBox)
