            [int]$k = 0
            [int]$m = 0
            $kText = $fields[1].Text.Trim()
            $mText = $fields[2].Text.Trim()

            if ($kText -match "^0x") { $k=[Convert]::ToInt32($kText.Replace("0x",""),16) }
            elseif (-not [int]::TryParse($kText,[ref]$k)) { throw "Keyboard ต้องเป็นตัวเลขหรือ HEX" }

            if ($mText -match "^0x") { $m=[Convert]::ToInt32($mText.Replace("0x",""),16) }
            elseif (-not [int]::TryParse($mText,[ref]$m)) { throw "Mouse ต้องเป็นตัวเลขหรือ HEX" }

            if ($k -lt 1 -or $k -gt 255) { throw "Keyboard ต้องอยู่ 1-255" }
            if ($m -lt 1 -or $m -gt 255) { throw "Mouse ต้องอยู่ 1-255" }

            Set-DWord $ControlKey "Win32PrioritySeparation" $w
            Set-DWord $KeyboardKey "KeyboardDataQueueSize" ([uint32]$k)
            Set-DWord $MouseKey "MouseDataQueueSize" ([uint32]$m)

            # RAM is shown separately and is not written from this button.
            Show-Message ("System Custom สำเร็จ`r`n`r`nRAM ไม่ถูกเปลี่ยนจากปุ่มนี้`r`n`r`nBackup:`r`n{0}" -f $b) "$AppName // SYSTEM"
            Refresh-SystemFields
        } catch {
            Show-Message $_.Exception.Message "$AppName // SYSTEM" ([System.Windows.Forms.MessageBoxIcon]::Error)
        }
    })

    Refresh-SystemFields
    [void]$f.ShowDialog()
}

function Show-RamProfile {
    $f = New-BaseForm "$AppName // RAM PROFILE" 650 450
    Add-Header $f "RAM PROFILE" "ใช้ค่าตาราง RAM ที่คุณกำหนดไว้เดิม"

    $combo = New-Object System.Windows.Forms.ComboBox
    $combo.Location = New-Object System.Drawing.Point(50,150)
    $combo.Size = New-Object System.Drawing.Size(400,40)
    $combo.DropDownStyle = "DropDownList"
    foreach ($key in $RamValues.Keys) { [void]$combo.Items.Add($key) }

    $actual = [math]::Round((Get-CimInstance Win32_ComputerSystem).TotalPhysicalMemory/1GB)
    if ($RamValues.Contains("$actual GB")) { $combo.SelectedItem = "$actual GB" } else { $combo.SelectedItem = "Default" }
    $f.Controls.Add($combo)

    $apply = New-Button "APPLY RAM PROFILE" 50 230 400 65 12
    $back = New-Button "BACK" 50 310 400 55 11
    $f.Controls.Add($apply);$f.Controls.Add($back)

    $apply.Add_Click({
        $b=New-LarzoneBackup
        if (-not $b) { return }
        $name=[string]$combo.SelectedItem
        Set-DWord $ControlKey "SvcHostSplitThresholdInKB" ([uint32]$RamValues[$name])
        Show-Message ("RAM Profile: {0}`r`nValue: {1}`r`n`r`nBackup:`r`n{2}" -f $name,(Format-Hex $RamValues[$name]),$b) "$AppName // RAM"
    })
    $back.Add_Click({$f.Close()})
    [void]$f.ShowDialog()
}

function Show-BackupRestore {
    $f = New-BaseForm "$AppName // BACKUP / RESTORE" 850 600
    Add-Header $f "BACKUP / RESTORE" "สำรองและกู้คืนค่าที่ LARZONE แก้ไข"

    $list=New-Object System.Windows.Forms.ListBox
    $list.Location=New-Object System.Drawing.Point(40,125);$list.Size=New-Object System.Drawing.Size(740,300)
    $list.BackColor=[System.Drawing.Color]::FromArgb(13,17,27);$list.ForeColor=[System.Drawing.Color]::White
    $list.Font=New-Object System.Drawing.Font("Consolas",10)
    $f.Controls.Add($list)

    function Refresh-Backups {
        $list.Items.Clear()
        if(Test-Path -LiteralPath $BackupRoot){
            Get-ChildItem -LiteralPath $BackupRoot -Directory | Sort-Object Name -Descending |
                ForEach-Object {[void]$list.Items.Add($_.FullName)}
        }
    }

    $new=New-Button "CREATE BACKUP" 40 460 230 60 11
    $restore=New-Button "RESTORE SELECTED" 290 460 230 60 11
    $refresh=New-Button "REFRESH" 540 460 240 60 11
    $f.Controls.Add($new);$f.Controls.Add($restore);$f.Controls.Add($refresh)

    $new.Add_Click({$b=New-LarzoneBackup;if($b){Refresh-Backups;Show-Message "Backup สำเร็จ`r`n`r`n$b" "$AppName // BACKUP"}})
    $restore.Add_Click({
        if($null -eq $list.SelectedItem){Show-Message "เลือก Backup ก่อน";return}
        [void](Restore-LarzoneBackup ([string]$list.SelectedItem))
    })
    $refresh.Add_Click({Refresh-Backups})
    Refresh-Backups
    [void]$f.ShowDialog()
}

