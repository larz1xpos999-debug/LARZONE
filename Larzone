# events
$btnBrowse.Add_Click({
    $dlg = New-Object System.Windows.Forms.FolderBrowserDialog
    $dlg.Description = "เลือกโฟลเดอร์ CitizenFX (Roaming)"
    $dlg.SelectedPath = $txtCitizenFx.Text
    if ($dlg.ShowDialog() -eq [System.Windows.Forms.DialogResult]::OK) {
        $txtCitizenFx.Text = $dlg.SelectedPath
    }
})

$btnOpenCitizenFx.Add_Click({
    try {
        $p = $txtCitizenFx.Text
        if (Test-Path -LiteralPath $p) {
            Start-Process -FilePath "explorer.exe" -ArgumentList @("`"$p`"") | Out-Null
        } else {
            [System.Windows.Forms.MessageBox]::Show("ไม่พบโฟลเดอร์: $p", "CitizenFX", "OK", "Warning") | Out-Null
        }
    } catch {
        [System.Windows.Forms.MessageBox]::Show("เปิดโฟลเดอร์ไม่สำเร็จ: $($_.Exception.Message)", "CitizenFX", "OK", "Error") | Out-Null
    }
})

$btnStart.Add_Click({
    $btnStart.Enabled = $false
    $form.UseWaitCursor = $true
    try {
        Write-Log -LogBox $txtLog -Level "INFO" -Message "เริ่มทำงาน..."
        Write-Log -LogBox $txtLog -Level "INFO" -Message "GPU: $gpuName"
        Write-Log -LogBox $txtLog -Level "INFO" -Message "CitizenFX: $($txtCitizenFx.Text)"

        if ($chkClearCache.Checked) {
            Write-Log -LogBox $txtLog -Level "INFO" -Message "กำลังล้างแคช FiveM..."
            Clear-FiveM-Cache -LogBox $txtLog
        }

        if ($chkFixGtaSettings.Checked) {
            Write-Log -LogBox $txtLog -Level "INFO" -Message "กำลังแก้ gta5_settings.xml..."
            $ok = Update-GTA5Settings-VideoCardDescription -CitizenFxPath $txtCitizenFx.Text -GpuName $gpuName -LogBox $txtLog
            if (-not $ok) {
                Write-Log -LogBox $txtLog -Level "WARN" -Message "ข้ามขั้นตอนแก้ gta5_settings.xml เนื่องจากเกิดข้อผิดพลาด"
            }
        }

        if ($chkDisableGameBar.Checked) {
            Write-Log -LogBox $txtLog -Level "INFO" -Message "กำลังปิด Xbox Game Bar/Game DVR..."
            Disable-Xbox-GameBar -LogBox $txtLog
        }

        if ($chkHighPerf.Checked) {
            Write-Log -LogBox $txtLog -Level "INFO" -Message "กำลังตั้ง Power Plan..."
            Set-HighPerformancePowerPlan -LogBox $txtLog
        }

        if ($chkRegistryTweaks.Checked) {
            Write-Log -LogBox $txtLog -Level "INFO" -Message "กำลังปรับ Registry..."
            $okReg = Set-RegistryTweaksForFiveM -LogBox $txtLog
            if (-not $okReg) {
                Write-Log -LogBox $txtLog -Level "WARN" -Message "ปรับ Registry ไม่สำเร็จ/ถูกข้าม (ลองรันแบบแอดมิน)"
            }
        }

        if ($chkSvcHostReduceProc.Checked) {
            Write-Log -LogBox $txtLog -Level "INFO" -Message "กำลังลดจำนวน Process (svchost) ตาม RAM..."
            $okSvc = Set-SvcHostSplitThresholdInKB -LogBox $txtLog
            if (-not $okSvc) {
                Write-Log -LogBox $txtLog -Level "WARN" -Message "ลด Process ไม่สำเร็จ/ถูกข้าม (ลองรันแบบแอดมิน)"
            }
        }

        Write-Log -LogBox $txtLog -Level "OK" -Message "เสร็จแล้ว"
        $msg = "เสร็จแล้ว! แนะนำให้เปิด FiveM ใหม่อีกครั้ง"
        if ($chkRegistryTweaks.Checked -or $chkSvcHostReduceProc.Checked) { $msg += "`n`nหมายเหตุ: ถ้าเลือกปรับ Registry/ลด Process แนะนำรีสตาร์ตเครื่อง 1 ครั้ง" }
        [System.Windows.Forms.MessageBox]::Show($msg, "FiveM Debloat", "OK", "Information") | Out-Null
    } catch {
        Write-Log -LogBox $txtLog -Level "ERR" -Message "เกิดข้อผิดพลาดไม่คาดคิด: $($_.Exception.Message)"
        [System.Windows.Forms.MessageBox]::Show("เกิดข้อผิดพลาด: $($_.Exception.Message)", "FiveM Debloat", "OK", "Error") | Out-Null
    } finally {
        $form.UseWaitCursor = $false
        $btnStart.Enabled = $true
    }
})

