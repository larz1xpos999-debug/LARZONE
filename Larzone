Ensure-Dir $BackupRoot | Out-Null

function Write-Log([string]$Text) {
    try {
        Add-Content -LiteralPath $LogFile -Value ("[{0}] {1}" -f (Get-Date -Format "yyyy-MM-dd HH:mm:ss"), $Text)
    } catch {}
}

function Show-Message([string]$Message, [string]$Title = $AppName,
    [System.Windows.Forms.MessageBoxIcon]$Icon = [System.Windows.Forms.MessageBoxIcon]::Information) {
    [void][System.Windows.Forms.MessageBox]::Show($Message, $Title,
        [System.Windows.Forms.MessageBoxButtons]::OK, $Icon)
}

function Get-DWord([string]$Path, [string]$Name) {
    try {
        return (Get-ItemProperty -Path $Path -Name $Name -ErrorAction Stop).$Name
    } catch {
        return $null
    }
}

function Set-DWord([string]$Path, [string]$Name, [uint32]$Value) {
    if (-not (Test-Path -LiteralPath $Path)) {
        New-Item -Path $Path -Force | Out-Null
    }
    New-ItemProperty -Path $Path -Name $Name -PropertyType DWord -Value $Value -Force | Out-Null
}

function Format-Hex($Value) {
    if ($null -eq $Value) { return "NOT SET" }
    return ("0x{0:X8}" -f [uint32]$Value)
}

function Export-KeyChecked([string]$Key, [string]$File, [string]$Label) {
    if (-not (Test-Path -LiteralPath $Key)) {
        Write-Log ("{0}: registry key not present; skipped." -f $Label)
        return [pscustomobject]@{ Label=$Label; Success=$true; Skipped=$true; ExitCode=0 }
    }

    & reg.exe export $Key $File /y *> $null
    $code = $LASTEXITCODE
    $ok = ($code -eq 0 -and (Test-Path -LiteralPath $File))
    if ($ok) {
        Write-Log ("{0}: exported successfully." -f $Label)
    } else {
        Write-Log ("{0}: export failed with exit code {1}." -f $Label, $code)
    }
    return [pscustomobject]@{ Label=$Label; Success=$ok; Skipped=$false; ExitCode=$code }
}

function New-LarzoneBackup {
    Ensure-Dir $BackupRoot | Out-Null
    $folder = Join-Path $BackupRoot (Get-Date -Format "yyyyMMdd_HHmmss")
    Ensure-Dir $folder | Out-Null

    $results = @(
        (Export-KeyChecked "HKLM\SYSTEM\CurrentControlSet\Control" (Join-Path $folder "Control.reg") "Control"),
        (Export-KeyChecked "HKLM\SYSTEM\CurrentControlSet\Services\kbdclass\Parameters" (Join-Path $folder "Keyboard.reg") "Keyboard"),
        (Export-KeyChecked "HKLM\SYSTEM\CurrentControlSet\Services\mouclass\Parameters" (Join-Path $folder "Mouse.reg") "Mouse")
    )

    $results | ConvertTo-Json -Depth 4 | Set-Content -LiteralPath (Join-Path $folder "BackupReport.json") -Encoding UTF8

    $failed = @($results | Where-Object { -not $_.Success })
    if ($failed.Count -gt 0) {
        Show-Message ("Backup ไม่สมบูรณ์:`r`n`r`n" +
            (($failed | ForEach-Object { "{0} : exit {1}" -f $_.Label, $_.ExitCode }) -join "`r`n")) `
            "$AppName // BACKUP" ([System.Windows.Forms.MessageBoxIcon]::Error)
        return $null
    }

    Write-Log ("Backup created: {0}" -f $folder)
    return $folder
}

function Restore-LarzoneBackup([string]$Folder) {
    if (-not (Test-Path -LiteralPath $Folder)) {
        Show-Message "ไม่พบโฟลเดอร์ Backup" "$AppName // RESTORE" ([System.Windows.Forms.MessageBoxIcon]::Error)
        return $false
    }

    $files = @(
        (Join-Path $Folder "Control.reg"),
        (Join-Path $Folder "Keyboard.reg"),
        (Join-Path $Folder "Mouse.reg")
    )

    $failed = @()
    foreach ($file in $files) {
        if (Test-Path -LiteralPath $file) {
            & reg.exe import $file *> $null
            if ($LASTEXITCODE -ne 0) { $failed += [IO.Path]::GetFileName($file) }
        }
    }

    if ($failed.Count -gt 0) {
        Show-Message ("Restore ไม่สำเร็จ:`r`n" + ($failed -join "`r`n")) `
            "$AppName // RESTORE" ([System.Windows.Forms.MessageBoxIcon]::Error)
        return $false
    }

    Show-Message ("Restore สำเร็จ`r`n`r`n{0}`r`n`r`nแนะนำให้ Restart Windows" -f $Folder) "$AppName // RESTORE"
    Write-Log ("Backup restored: {0}" -f $Folder)
    return $true
}

function Get-SystemInfo {
    try {
        $os = Get-CimInstance Win32_OperatingSystem
        $cpu = Get-CimInstance Win32_Processor | Select-Object -First 1
        $gpu = Get-CimInstance Win32_VideoController | Where-Object { $_.Name } | Select-Object -First 1
        $cs = Get-CimInstance Win32_ComputerSystem
        $total = [math]::Round($cs.TotalPhysicalMemory / 1GB, 1)
        $free = [math]::Round($os.FreePhysicalMemory / 1MB, 1)
        return [pscustomobject]@{
            CPU = $cpu.Name
            GPU = $gpu.Name
            RAM = $total
            FreeRAM = $free
            Windows = $os.Caption
            Build = $os.BuildNumber
        }
    } catch {
        return [pscustomobject]@{ CPU="Unknown";GPU="Unknown";RAM=0;FreeRAM=0;Windows="Unknown";Build="Unknown" }
    }
}

