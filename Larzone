  Write-Host "[1] TCP Auto-Tuning";Write-Host "[2] TCP Global Status";Write-Host "[3] Adapter Status";Write-Host "[4] Link Speed";Write-Host "[5] Adapter Power";Write-Host "[6] DNS Servers";Write-Host "[7] Network Profile";Write-Host "[8] IPv4 Config";Write-Host "[9] IPv6 Config";Write-Host "[10] Active Adapter";Write-Host "[11] TCP Congestion";Write-Host "[12] TCP ECN Status";Write-Host "[13] TCP Timestamps";Write-Host "[14] Network Status";Write-Host "[15] APPLY NETWORK SAFE"
