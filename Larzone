    $b.FlatAppearance.BorderColor = [System.Drawing.Color]::FromArgb(70,160,240)
    $b.Add_Click($Action)
    $Form.Controls.Add($b)
    return $b
}

function New-SimpleWindow($Title,$Width=760,$Height=560) {
    $f = New-Object System.Windows.Forms.Form
    $f.Text = $Title
    $f.StartPosition = "CenterScreen"
    $f.ClientSize = New-Object System.Drawing.Size($Width,$Height)
    $f.BackColor = [System.Drawing.Color]::FromArgb(10,15,25)
    $f.ForeColor = [System.Drawing.Color]::White
    $f.FormBorderStyle = "FixedSingle"
    $f.MaximizeBox = $false
    $f.MinimizeBox = $true
    return $f
}

function Add-Title($Form,$Text) {
    $l = New-Object System.Windows.Forms.Label
    $l.Text = $Text
    $l.Font = $fontTitle
    $l.ForeColor = [System.Drawing.Color]::FromArgb(65,185,255)
