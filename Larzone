# ---------- Custom / Debloat Tweaks ----------
# Each tweak is independent so CUSTOM mode can apply only what the user selected.
function Apply-CustomTweak($Id) {
    switch ($Id) {
        "Telemetry" {
            Set-Dword "HKLM:\SOFTWARE\Policies\Microsoft\Windows\DataCollection" "AllowTelemetry" 0
            Set-Dword "HKCU:\Software\Microsoft\Windows\CurrentVersion\AdvertisingInfo" "Enabled" 0
        }
        "ActivityHistory" {
            Set-Dword "HKLM:\SOFTWARE\Policies\Microsoft\Windows\System" "EnableActivityFeed" 0
            Set-Dword "HKLM:\SOFTWARE\Policies\Microsoft\Windows\System" "PublishUserActivities" 0
            Set-Dword "HKLM:\SOFTWARE\Policies\Microsoft\Windows\System" "UploadUserActivities" 0
        }
        "ConsumerFeatures" {
            Set-Dword "HKLM:\SOFTWARE\Policies\Microsoft\Windows\CloudContent" "DisableWindowsConsumerFeatures" 1
        }
        "Suggestions" {
            Set-Dword "HKCU:\Software\Microsoft\Windows\CurrentVersion\ContentDeliveryManager" "SystemPaneSuggestionsEnabled" 0
            Set-Dword "HKCU:\Software\Microsoft\Windows\CurrentVersion\ContentDeliveryManager" "SubscribedContent-338388Enabled" 0
            Set-Dword "HKCU:\Software\Microsoft\Windows\CurrentVersion\ContentDeliveryManager" "SubscribedContent-353694Enabled" 0
            Set-Dword "HKCU:\Software\Microsoft\Windows\CurrentVersion\ContentDeliveryManager" "SubscribedContent-353696Enabled" 0
        }
        "Widgets" {
            Set-Dword "HKLM:\SOFTWARE\Policies\Microsoft\Dsh" "AllowNewsAndInterests" 0
            Set-Dword "HKCU:\Software\Microsoft\Windows\CurrentVersion\Explorer\Advanced" "TaskbarDa" 0
        }
        "BackgroundApps" {
            Set-Dword "HKCU:\Software\Microsoft\Windows\CurrentVersion\BackgroundAccessApplications" "GlobalUserDisabled" 1
        }
        "SearchHighlights" {
            Set-Dword "HKCU:\Software\Microsoft\Windows\CurrentVersion\SearchSettings" "IsDynamicSearchBoxEnabled" 0
            Set-Dword "HKCU:\Software\Microsoft\Windows\CurrentVersion\SearchSettings" "IsCloudSearchEnabled" 0
        }
        "Transparency" {
            Set-Dword "HKCU:\Software\Microsoft\Windows\CurrentVersion\Themes\Personalize" "EnableTransparency" 0
        }
        "Animations" {
            Set-Dword "HKCU:\Software\Microsoft\Windows\CurrentVersion\Explorer\Advanced" "TaskbarAnimations" 0
        }
        "VisualEffects" {
            Set-Dword "HKCU:\Software\Microsoft\Windows\CurrentVersion\Explorer\VisualEffects" "VisualFXSetting" 2
        }
        "ExplorerThisPC" {
            Set-Dword "HKCU:\Software\Microsoft\Windows\CurrentVersion\Explorer\Advanced" "LaunchTo" 1
        }
        "GameDVR" {
            Set-Dword "HKCU:\System\GameConfigStore" "GameDVR_Enabled" 0
            Set-Dword "HKCU:\SOFTWARE\Microsoft\Windows\CurrentVersion\GameDVR" "AppCaptureEnabled" 0
            Set-Dword "HKCU:\SOFTWARE\Microsoft\Windows\CurrentVersion\GameDVR" "AudioCaptureEnabled" 0
        }
        "GameMode" {
            Set-Dword "HKCU:\Software\Microsoft\GameBar" "AllowAutoGameMode" 1
            Set-Dword "HKCU:\Software\Microsoft\GameBar" "AutoGameModeEnabled" 1
        }
        "InputMouse" {
            Set-Dword "HKCU:\Control Panel\Mouse" "MouseSpeed" 0
            Set-Dword "HKCU:\Control Panel\Mouse" "MouseThreshold1" 0
            Set-Dword "HKCU:\Control Panel\Mouse" "MouseThreshold2" 0
        }
        "HighPerformance" {
            powercfg /setactive SCHEME_MAX | Out-Null
            Write-Log "CUSTOM high performance power plan selected"
        }
        "Copilot" {
            Set-Dword "HKCU:\Software\Policies\Microsoft\Windows\WindowsCopilot" "TurnOffWindowsCopilot" 1
        }
        "TailoredExperiences" {
            Set-Dword "HKCU:\Software\Microsoft\Windows\CurrentVersion\Privacy" "TailoredExperiencesWithDiagnosticDataEnabled" 0
        }
        "Location" {
            Set-String "HKLM:\SOFTWARE\Microsoft\Windows\CurrentVersion\CapabilityAccessManager\ConsentStore\location" "Value" "Deny"
        }
        "FastStartup" {
            Set-Dword "HKLM:\SYSTEM\CurrentControlSet\Control\Session Manager\Power" "HiberbootEnabled" 1
        }
    }
}

