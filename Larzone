# LARZONE // DEBLOAT V3.2 FIXED
# V3.1 base, with DEBLOAT separated from SYSTEM/GAMING/RAM.
# IMPORTANT:
# - NORMAL/HIGH do NOT change Keyboard, Mouse, Win32PrioritySeparation, or RAM.
# - RAM profile uses the exact values supplied by the user.
# - Keyboard/Mouse/Win32 are available only in CUSTOM.
# - No Windows services are disabled/removed by this script.
# - Backup treats missing optional registry keys as "not present", not as a fatal error.

#requires -Version 5.1
#requires -RunAsAdministrator

Set-StrictMode -Version Latest
$ErrorActionPreference = 'Continue'

Add-Type -AssemblyName System.Windows.Forms
Add-Type -AssemblyName System.Drawing
[System.Windows.Forms.Application]::EnableVisualStyles()

$AppName = 'LARZONE V3.2'
$Root = Join-Path $env:ProgramData 'LARZONE\V3.2'
$BackupRoot = Join-Path $Root 'Backups'
$LogRoot = Join-Path $Root 'Logs'

$ControlKey = 'HKLM:\SYSTEM\CurrentControlSet\Control'
$KeyboardKey = 'HKLM:\SYSTEM\CurrentControlSet\Services\kbdclass\Parameters'
$MouseKey = 'HKLM:\SYSTEM\CurrentControlSet\Services\mouclass\Parameters'

# Exact RAM table supplied by the user.
$RamValues = [ordered]@{
    'Default' = 0x380000
    '4 GB'    = 0x400000
    '6 GB'    = 0x600000
    '8 GB'    = 0x800000
    '12 GB'   = 0xC00000
    '16 GB'   = 0x1000000
    '24 GB'   = 0x1800000
    '32 GB'   = 0x2000000
    '64 GB'   = 0x4000000
}

# Conservative Appx debloat list.
# Deliberately does not touch critical Windows services, networking, audio, keyboard, mouse, Defender, or Windows Update.
$DebloatApps = @(
    'Microsoft.BingNews',
    'Microsoft.BingWeather',
    'Microsoft.GetHelp',
    'Microsoft.Getstarted',
    'Microsoft.MicrosoftOfficeHub',
    'Microsoft.MicrosoftSolitaireCollection',
    'Microsoft.People',
    'Microsoft.Todos',
    'Microsoft.WindowsFeedbackHub',
    'Microsoft.WindowsMaps',
    'Microsoft.Xbox.TCUI',
    'Microsoft.XboxGamingOverlay',
    'Microsoft.XboxIdentityProvider',
    'Microsoft.XboxSpeechToTextOverlay',
    'Microsoft.ZuneMusic',
    'Microsoft.ZuneVideo'
)

function Ensure-Directory {
    param([Parameter(Mandatory)][string]$Path)
    if (-not (Test-Path -LiteralPath $Path)) {
        New-Item -ItemType Directory -Path $Path -Force | Out-Null
    }
    return (Test-Path -LiteralPath $Path)
}

function Write-Log {
    param([Parameter(Mandatory)][string]$Message)
    try {
        Ensure-Directory -Path $LogRoot | Out-Null
        $file = Join-Path $LogRoot ((Get-Date).ToString('yyyy-MM-dd') + '.log')
        Add-Content -LiteralPath $file -Value ("[{0}] {1}" -f (Get-Date -Format 'HH:mm:ss'), $Message) -Encoding UTF8
    } catch {
        # Logging must never stop the main operation.
    }
}

function Show-Message {
    param(
        [Parameter(Mandatory)][string]$Message,
        [string]$Title = $AppName,
        [System.Windows.Forms.MessageBoxIcon]$Icon = [System.Windows.Forms.MessageBoxIcon]::Information
    )
    [void][System.Windows.Forms.MessageBox]::Show(
        $Message,
        $Title,
        [System.Windows.Forms.MessageBoxButtons]::OK,
        $Icon
    )
}

function Get-DwordValue {
    param(
        [Parameter(Mandatory)][string]$Path,
        [Parameter(Mandatory)][string]$Name
    )
    try {
        return (Get-ItemProperty -LiteralPath $Path -Name $Name -ErrorAction Stop).$Name
    } catch {
        return $null
    }
}

function Set-DwordValue {
    param(
        [Parameter(Mandatory)][string]$Path,
        [Parameter(Mandatory)][string]$Name,
        [Parameter(Mandatory)][uint32]$Value
    )
    if (-not (Test-Path -LiteralPath $Path)) {
        New-Item -Path $Path -Force | Out-Null
    }
    New-ItemProperty -LiteralPath $Path -Name $Name -PropertyType DWord -Value $Value -Force | Out-Null
}

function Format-Hex {
    param([AllowNull()][object]$Value)
    if ($null -eq $Value) {
        return 'NOT SET'
    }
    return ('0x{0:X8}' -f ([uint32]$Value))
}

function Export-RegistryKey {
    param(
        [Parameter(Mandatory)][string]$RegistryKey,
        [Parameter(Mandatory)][string]$OutputFile,
        [Parameter(Mandatory)][string]$Label
    )

    if (-not (Test-Path -LiteralPath ("Registry::" + $RegistryKey))) {
        Write-Log "$Label: registry key not present; skipped."
        return [pscustomobject]@{
            Label = $Label
            Status = 'NotPresent'
            File = $OutputFile
        }
    }

    & reg.exe export $RegistryKey $OutputFile /y *> $null
    $exitCode = $LASTEXITCODE

    if (($exitCode -eq 0) -and (Test-Path -LiteralPath $OutputFile)) {
        Write-Log "$Label: exported successfully."
        return [pscustomobject]@{
            Label = $Label
            Status = 'OK'
            File = $OutputFile
        }
    }

    Write-Log "$Label: export failed with exit code $exitCode."
    return [pscustomobject]@{
        Label = $Label
        Status = 'Failed'
        File = $OutputFile
        ExitCode = $exitCode
    }
}

function New-LarzoneBackup {
    Ensure-Directory -Path $BackupRoot | Out-Null

    $folder = Join-Path $BackupRoot (Get-Date -Format 'yyyyMMdd_HHmmss')
    Ensure-Directory -Path $folder | Out-Null

    $items = @()
    $items += Export-RegistryKey -RegistryKey 'HKLM\SYSTEM\CurrentControlSet\Control' `
        -OutputFile (Join-Path $folder 'Control.reg') -Label 'Control'
    $items += Export-RegistryKey -RegistryKey 'HKLM\SYSTEM\CurrentControlSet\Services\kbdclass\Parameters' `
        -OutputFile (Join-Path $folder 'Keyboard.reg') -Label 'Keyboard'
    $items += Export-RegistryKey -RegistryKey 'HKLM\SYSTEM\CurrentControlSet\Services\mouclass\Parameters' `
        -OutputFile (Join-Path $folder 'Mouse.reg') -Label 'Mouse'

    $report = [ordered]@{
        Created = (Get-Date).ToString('s')
        Computer = $env:COMPUTERNAME
        Windows = (Get-CimInstance Win32_OperatingSystem).Caption
        Results = $items
    }

    $report | ConvertTo-Json -Depth 8 | Set-Content -LiteralPath (Join-Path $folder 'BackupReport.json') -Encoding UTF8

    $failed = @($items | Where-Object { $_.Status -eq 'Failed' })
    if ($failed.Count -gt 0) {
        Write-Log 'Backup failed.'
        Show-Message -Message (
            "BACKUP ไม่สมบูรณ์`r`n`r`n" +
            (($failed | ForEach-Object { "$($_.Label): export failed" }) -join "`r`n")
        ) -Title "$AppName // BACKUP" -Icon ([System.Windows.Forms.MessageBoxIcon]::Error)
        return $null
    }

    Write-Log "Backup created: $folder"
    return $folder
}

function Get-LarzoneStatus {
    try {
        $os = Get-CimInstance Win32_OperatingSystem
        $cpu = Get-CimInstance Win32_Processor | Select-Object -First 1
        $gpu = Get-CimInstance Win32_VideoController | Where-Object { $_.Name } | Select-Object -First 1
        $computer = Get-CimInstance Win32_ComputerSystem
        $ramGb = [math]::Round($computer.TotalPhysicalMemory / 1GB, 1)

        return @(
            'SYSTEM NOTE'
            '────────────────────────────────'
            "CPU      : $($cpu.Name)"
            "GPU      : $($gpu.Name)"
            "RAM      : $ramGb GB"
            "Windows  : $($os.Caption)"
            "Build    : $($os.BuildNumber)"
            ''
            'CURRENT VALUES'
            '────────────────────────────────'
            "Win32    : $(Format-Hex (Get-DwordValue -Path $ControlKey -Name 'Win32PrioritySeparation'))"
            "Keyboard : $(Format-Hex (Get-DwordValue -Path $KeyboardKey -Name 'KeyboardDataQueueSize'))"
            "Mouse    : $(Format-Hex (Get-DwordValue -Path $MouseKey -Name 'MouseDataQueueSize'))"
            "RAM      : $(Format-Hex (Get-DwordValue -Path $ControlKey -Name 'SvcHostSplitThresholdInKB'))"
            ''
            'V3.2 RULES'
            '────────────────────────────────'
            'NORMAL / HIGH : no Keyboard / Mouse / Win32 / RAM'
            'CUSTOM        : Keyboard / Mouse / Win32 only'
            'RAM PROFILE   : uses supplied RAM table'
            'DEBLOAT       : Appx apps only'
            'SERVICES      : not modified'
            'GPEDIT        : not modified'
        ) -join [Environment]::NewLine
    } catch {
        return "Unable to read system information.`r`n$($_.Exception.Message)"
    }
}

function Invoke-AppxDebloat {
    param([switch]$Quiet)

    $backup = New-LarzoneBackup
    if (-not $backup) {
        return $false
    }

    $removed = 0
    $notFound = 0
    $failed = 0

    foreach ($packageName in $DebloatApps) {
        try {
            $packages = @(Get-AppxPackage -AllUsers -Name $packageName -ErrorAction SilentlyContinue)

            if ($packages.Count -eq 0) {
                $notFound++
                continue
            }

            foreach ($package in $packages) {
                try {
                    Remove-AppxPackage -Package $package.PackageFullName -AllUsers -ErrorAction Stop
                    $removed++
                    Write-Log "Removed Appx: $($package.PackageFullName)"
                } catch {
                    $failed++
                    Write-Log "Failed Appx: $($package.PackageFullName) - $($_.Exception.Message)"
                }
            }
        } catch {
            $failed++
            Write-Log "Package lookup failed: $packageName - $($_.Exception.Message)"
        }
    }

    if (-not $Quiet) {
        Show-Message -Message (
            "DEBLOAT เสร็จแล้ว`r`n`r`n" +
            "จัดการสำเร็จ : $removed`r`n" +
            "ไม่พบ        : $notFound`r`n" +
            "ล้มเหลว      : $failed`r`n`r`n" +
            "Backup:`r`n$backup"
        ) -Title "$AppName // DEBLOAT"
    }

    return $true
}

function Invoke-QuickProfile {
    param([Parameter(Mandatory)][string]$ProfileName)

    # Intentionally no Keyboard / Mouse / Win32 / RAM changes here.
    $ok = Invoke-AppxDebloat -Quiet
    if (-not $ok) {
        return
    }

    Show-Message -Message (
        "$ProfileName เสร็จแล้ว`r`n`r`n" +
        "Keyboard / Mouse / Win32 / RAM = ไม่เปลี่ยน`r`n" +
        "Services = ไม่เปลี่ยน"
    ) -Title "$AppName // $ProfileName"
}

function Show-BackupList {
    Ensure-Directory -Path $BackupRoot | Out-Null
    $folders = @(Get-ChildItem -LiteralPath $BackupRoot -Directory -ErrorAction SilentlyContinue | Sort-Object Name -Descending)

    if ($folders.Count -eq 0) {
        Show-Message -Message 'ยังไม่มี Backup ของ LARZONE V3.2' -Title "$AppName // BACKUP"
        return
    }

    $list = ($folders | ForEach-Object { $_.FullName }) -join [Environment]::NewLine
    Show-Message -Message "Backup ที่มี:`r`n`r`n$list" -Title "$AppName // BACKUP"
}

function Restore-LatestBackup {
    Ensure-Directory -Path $BackupRoot | Out-Null
    $latest = Get-ChildItem -LiteralPath $BackupRoot -Directory -ErrorAction SilentlyContinue |
        Sort-Object Name -Descending | Select-Object -First 1

    if ($null -eq $latest) {
        Show-Message -Message 'ไม่พบ Backup สำหรับ Restore.' -Title "$AppName // RESTORE" -Icon ([System.Windows.Forms.MessageBoxIcon]::Warning)
        return
    }

    $answer = [System.Windows.Forms.MessageBox]::Show(
        "Restore Backup ล่าสุด:`r`n$($latest.FullName)`r`n`r`nต้องการทำต่อหรือไม่?",
        "$AppName // RESTORE",
        [System.Windows.Forms.MessageBoxButtons]::YesNo,
        [System.Windows.Forms.MessageBoxIcon]::Warning
    )

    if ($answer -ne [System.Windows.Forms.DialogResult]::Yes) {
        return
    }

    $files = @('Control.reg','Keyboard.reg','Mouse.reg')
    $imported = 0
    $failed = 0

    foreach ($file in $files) {
        $path = Join-Path $latest.FullName $file
        if (-not (Test-Path -LiteralPath $path)) {
            continue
        }

        try {
            & reg.exe import $path *> $null
            if ($LASTEXITCODE -eq 0) {
                $imported++
            } else {
                $failed++
            }
        } catch {
            $failed++
        }
    }

    Show-Message -Message (
        "Restore เสร็จสิ้น`r`n`r`n" +
        "Imported : $imported`r`n" +
        "Failed   : $failed`r`n`r`n" +
        "แนะนำให้ Restart Windows หลัง Restore"
    ) -Title "$AppName // RESTORE"
}

function Show-CustomEditor {
    $dialog = New-Object System.Windows.Forms.Form
    $dialog.Text = "$AppName // CUSTOM"
    $dialog.Size = New-Object System.Drawing.Size(700, 470)
    $dialog.StartPosition = 'CenterParent'
    $dialog.BackColor = [System.Drawing.Color]::FromArgb(8,11,18)
    $dialog.ForeColor = [System.Drawing.Color]::White
    $dialog.FormBorderStyle = 'FixedDialog'
    $dialog.MaximizeBox = $false
    $dialog.MinimizeBox = $false

    function Add-Field {
        param([string]$LabelText,[string]$DefaultValue,[int]$Y)

        $label = New-Object System.Windows.Forms.Label
        $label.Text = $LabelText
        $label.Location = New-Object System.Drawing.Point(30,$Y)
        $label.AutoSize = $true
        $dialog.Controls.Add($label)

        $box = New-Object System.Windows.Forms.TextBox
        $box.Text = $DefaultValue
        $box.Location = New-Object System.Drawing.Point(300,($Y - 5))
        $box.Size = New-Object System.Drawing.Size(280,30)
        $box.Font = [System.Drawing.Font]::new('Consolas',10)
        $dialog.Controls.Add($box)

        return $box
    }

    $currentKeyboard = Get-DwordValue -Path $KeyboardKey -Name 'KeyboardDataQueueSize'
    $currentMouse = Get-DwordValue -Path $MouseKey -Name 'MouseDataQueueSize'
    $currentWin32 = Get-DwordValue -Path $ControlKey -Name 'Win32PrioritySeparation'

    $keyboardDefault = if ($null -eq $currentKeyboard) { '16' } else { [string][uint32]$currentKeyboard }
    $mouseDefault = if ($null -eq $currentMouse) { '25' } else { [string][uint32]$currentMouse }
    $win32Default = if ($null -eq $currentWin32) { '0x00000000' } else { Format-Hex $currentWin32 }

    $keyboardBox = Add-Field -LabelText 'Keyboard Queue Size' -DefaultValue $keyboardDefault -Y 70
    $mouseBox = Add-Field -LabelText 'Mouse Queue Size' -DefaultValue $mouseDefault -Y 125
    $win32Box = Add-Field -LabelText 'Win32 Priority (HEX)' -DefaultValue $win32Default -Y 180

    $info = New-Object System.Windows.Forms.Label
    $info.Text = "CUSTOM เท่านั้นที่แก้ 3 ค่านี้`r`nRAM อยู่ใน RAM PROFILE และ NORMAL/HIGH จะไม่แตะค่าเหล่านี้"
    $info.Location = New-Object System.Drawing.Point(30,235)
    $info.Size = New-Object System.Drawing.Size(600,55)
    $info.ForeColor = [System.Drawing.Color]::Silver
    $dialog.Controls.Add($info)

    $apply = New-Object System.Windows.Forms.Button
    $apply.Text = 'APPLY CUSTOM'
    $apply.Location = New-Object System.Drawing.Point(30,325)
    $apply.Size = New-Object System.Drawing.Size(250,55)
    $apply.BackColor = [System.Drawing.Color]::FromArgb(17,23,35)
    $apply.ForeColor = [System.Drawing.Color]::White
    $apply.FlatStyle = 'Flat'
    $dialog.Controls.Add($apply)

    $close = New-Object System.Windows.Forms.Button
    $close.Text = 'BACK'
    $close.Location = New-Object System.Drawing.Point(300,325)
    $close.Size = New-Object System.Drawing.Size(180,55)
    $close.BackColor = [System.Drawing.Color]::FromArgb(17,23,35)
    $close.ForeColor = [System.Drawing.Color]::White
    $close.FlatStyle = 'Flat'
    $dialog.Controls.Add($close)

    $close.Add_Click({ $dialog.Close() })

    $apply.Add_Click({
        try {
            $backup = New-LarzoneBackup
            if ($null -eq $backup) {
                return
            }

            [int]$keyboard = 0
            [int]$mouse = 0

            if (-not [int]::TryParse($keyboardBox.Text.Trim(), [ref]$keyboard)) {
                throw 'Keyboard Queue Size ต้องเป็นตัวเลข'
            }
            if (-not [int]::TryParse($mouseBox.Text.Trim(), [ref]$mouse)) {
                throw 'Mouse Queue Size ต้องเป็นตัวเลข'
            }
            if (($keyboard -lt 1) -or ($keyboard -gt 255)) {
                throw 'Keyboard Queue Size ต้องอยู่ระหว่าง 1-255'
            }
            if (($mouse -lt 1) -or ($mouse -gt 255)) {
                throw 'Mouse Queue Size ต้องอยู่ระหว่าง 1-255'
            }

            $hex = $win32Box.Text.Trim()
            if ($hex.StartsWith('0x',[System.StringComparison]::OrdinalIgnoreCase)) {
                $hex = $hex.Substring(2)
            }
            if ($hex -notmatch '^[0-9A-Fa-f]{1,8}$') {
                throw 'Win32 Priority ต้องเป็น HEX เช่น FFF9887'
            }

            [uint32]$win32 = [Convert]::ToUInt32($hex,16)

            Set-DwordValue -Path $KeyboardKey -Name 'KeyboardDataQueueSize' -Value ([uint32]$keyboard)
            Set-DwordValue -Path $MouseKey -Name 'MouseDataQueueSize' -Value ([uint32]$mouse)
            Set-DwordValue -Path $ControlKey -Name 'Win32PrioritySeparation' -Value $win32

            Write-Log "CUSTOM applied: Keyboard=$keyboard Mouse=$mouse Win32=0x$hex"

            Show-Message -Message (
                "CUSTOM สำเร็จ`r`n`r`n" +
                "Keyboard = $keyboard`r`n" +
                "Mouse    = $mouse`r`n" +
                "Win32    = 0x$hex`r`n`r`n" +
                "Backup:`r`n$backup"
            ) -Title "$AppName // CUSTOM"

            $dialog.Close()
        } catch {
            Show-Message -Message $_.Exception.Message -Title "$AppName // CUSTOM" -Icon ([System.Windows.Forms.MessageBoxIcon]::Error)
        }
    })

    [void]$dialog.ShowDialog($form)
}

function Show-RamEditor {
    $dialog = New-Object System.Windows.Forms.Form
    $dialog.Text = "$AppName // RAM PROFILE"
    $dialog.Size = New-Object System.Drawing.Size(600, 380)
    $dialog.StartPosition = 'CenterParent'
    $dialog.BackColor = [System.Drawing.Color]::FromArgb(8,11,18)
    $dialog.ForeColor = [System.Drawing.Color]::White
    $dialog.FormBorderStyle = 'FixedDialog'
    $dialog.MaximizeBox = $false
    $dialog.MinimizeBox = $false

    $combo = New-Object System.Windows.Forms.ComboBox
    $combo.Location = New-Object System.Drawing.Point(30,75)
    $combo.Size = New-Object System.Drawing.Size(330,32)
    $combo.DropDownStyle = 'DropDownList'

    foreach ($key in $RamValues.Keys) {
        [void]$combo.Items.Add($key)
    }

    $actualRam = [math]::Round((Get-CimInstance Win32_ComputerSystem).TotalPhysicalMemory / 1GB)
    if ($RamValues.Contains("$actualRam GB")) {
        $combo.SelectedItem = "$actualRam GB"
    } else {
        $combo.SelectedItem = 'Default'
    }
    $dialog.Controls.Add($combo)

    $label = New-Object System.Windows.Forms.Label
    $label.Text = 'Value'
    $label.Location = New-Object System.Drawing.Point(390,82)
    $label.AutoSize = $true
    $dialog.Controls.Add($label)

    $valueLabel = New-Object System.Windows.Forms.Label
    $valueLabel.Location = New-Object System.Drawing.Point(440,82)
    $valueLabel.AutoSize = $true
    $dialog.Controls.Add($valueLabel)

    $updateValue = {
        $selected = [string]$combo.SelectedItem
        if ($RamValues.Contains($selected)) {
            $valueLabel.Text = Format-Hex $RamValues[$selected]
        }
    }
    $combo.Add_SelectedIndexChanged($updateValue)
    & $updateValue

    $apply = New-Object System.Windows.Forms.Button
    $apply.Text = 'APPLY RAM'
    $apply.Location = New-Object System.Drawing.Point(30,160)
    $apply.Size = New-Object System.Drawing.Size(330,55)
    $apply.BackColor = [System.Drawing.Color]::FromArgb(17,23,35)
    $apply.ForeColor = [System.Drawing.Color]::White
    $apply.FlatStyle = 'Flat'
    $dialog.Controls.Add($apply)

    $close = New-Object System.Windows.Forms.Button
    $close.Text = 'BACK'
    $close.Location = New-Object System.Drawing.Point(380,160)
    $close.Size = New-Object System.Drawing.Size(150,55)
    $close.BackColor = [System.Drawing.Color]::FromArgb(17,23,35)
    $close.ForeColor = [System.Drawing.Color]::White
    $close.FlatStyle = 'Flat'
    $dialog.Controls.Add($close)
    $close.Add_Click({ $dialog.Close() })

    $apply.Add_Click({
        try {
            $backup = New-LarzoneBackup
            if ($null -eq $backup) {
                return
            }

            $selected = [string]$combo.SelectedItem
            if (-not $RamValues.Contains($selected)) {
                throw 'กรุณาเลือก RAM profile'
            }

            [uint32]$value = $RamValues[$selected]
            Set-DwordValue -Path $ControlKey -Name 'SvcHostSplitThresholdInKB' -Value $value
            Write-Log "RAM profile applied: $selected = $(Format-Hex $value)"

            Show-Message -Message (
                "RAM PROFILE สำเร็จ`r`n`r`n" +
                "$selected`r`n" +
                "Value = $(Format-Hex $value)`r`n`r`n" +
                "Backup:`r`n$backup"
            ) -Title "$AppName // RAM"

            $dialog.Close()
        } catch {
            Show-Message -Message $_.Exception.Message -Title "$AppName // RAM" -Icon ([System.Windows.Forms.MessageBoxIcon]::Error)
        }
    })

    [void]$dialog.ShowDialog($form)
}

