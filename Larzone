#requires -version 5.1
<#!
LARZONE DEBLOAT - FiveM / Gaming focused
Safe-first Windows debloat utility with a dark GUI.

Features:
- One-click Debloat (only selected, reversible items)
- Disable optional telemetry/consumer features
- Remove common built-in consumer apps for current user
- Stop/disable selected non-essential services only when found
- Restore defaults from a backup snapshot
- Check Status: shows what this tool has already changed
- Does NOT touch Windows boot processor count, maximum memory, BCD,
  Win32PrioritySeparation, NetworkThrottlingIndex, keyboard/mouse queue sizes,
  or other gaming Registry tweaks.

Run as Administrator.
#>

Add-Type -AssemblyName System.Windows.Forms
Add-Type -AssemblyName System.Drawing
[System.Windows.Forms.Application]::EnableVisualStyles()

# -------------------- Admin --------------------
$id = [Security.Principal.WindowsIdentity]::GetCurrent()
$p = New-Object Security.Principal.WindowsPrincipal($id)
if (-not $p.IsInRole([Security.Principal.WindowsBuiltInRole]::Administrator)) {
    Start-Process powershell.exe "-NoProfile -ExecutionPolicy Bypass -File `"$PSCommandPath`"" -Verb RunAs
    exit
}

# -------------------- Paths --------------------
$Root = Join-Path $env:ProgramData 'LarzoneDebloat'
$Backup = Join-Path $Root 'Backup'
$StateFile = Join-Path $Root 'state.json'
New-Item -ItemType Directory -Force -Path $Root,$Backup | Out-Null

function Load-State {
    if (Test-Path $StateFile) {
        try { return Get-Content $StateFile -Raw | ConvertFrom-Json } catch {}
    }
    return [pscustomobject]@{
        DebloatRun=$false
        AppCleanup=$false
        Privacy=$false
        Services=$false
        LastAction='ยังไม่เคยรัน'
        LastRun=''
        BackupPath=''
    }
}
$script:State = Load-State

function Save-State { $script:State | ConvertTo-Json -Depth 5 | Set-Content $StateFile -Encoding UTF8 }

function Log($Text) {
    if ($script:LogBox) {
        $script:LogBox.AppendText("[$(Get-Date -Format 'HH:mm:ss')] $Text`r`n")
        $script:LogBox.SelectionStart=$script:LogBox.TextLength
        $script:LogBox.ScrollToCaret()
    }
}

# -------------------- Backup --------------------
function Backup-RegistryKey($NativePath,$FileName) {
    $out = Join-Path $Backup $FileName
    reg.exe export $NativePath $out /y 2>$null | Out-Null
}

function New-Backup {
    $stamp = Get-Date -Format 'yyyyMMdd_HHmmss'
    $dir = Join-Path $Backup $stamp
    New-Item -ItemType Directory -Force -Path $dir | Out-Null
    $keys = @(
        @('HKCU\Software\Microsoft\Windows\CurrentVersion\ContentDeliveryManager','ContentDeliveryManager.reg'),
        @('HKCU\Software\Microsoft\Windows\CurrentVersion\Explorer\Advanced','ExplorerAdvanced.reg'),
        @('HKLM\SOFTWARE\Policies\Microsoft\Windows\CloudContent','CloudContent.reg'),
        @('HKLM\SOFTWARE\Policies\Microsoft\Windows\DataCollection','DataCollection.reg'),
        @('HKLM\SOFTWARE\Policies\Microsoft\Windows\OneDrive','OneDrive.reg')
    )
    foreach($k in $keys){
        reg.exe export $k[0] (Join-Path $dir $k[1]) /y 2>$null | Out-Null
    }
    $script:State.BackupPath=$dir
    Save-State
    return $dir
}

function Restore-Backup {
    if (-not $script:State.BackupPath -or -not (Test-Path $script:State.BackupPath)) {
        [System.Windows.Forms.MessageBox]::Show('ยังไม่มี Backup ที่สร้างโดยโปรแกรมนี้','RESTORE',[System.Windows.Forms.MessageBoxButtons]::OK,[System.Windows.Forms.MessageBoxIcon]::Information) | Out-Null
        return
    }
    $yes=[System.Windows.Forms.MessageBox]::Show("Restore จาก:`n$($script:State.BackupPath)`n`nดำเนินการต่อหรือไม่?",'RESTORE',[System.Windows.Forms.MessageBoxButtons]::YesNo,[System.Windows.Forms.MessageBoxIcon]::Warning)
    if($yes -ne [System.Windows.Forms.DialogResult]::Yes){return}
    Get-ChildItem $script:State.BackupPath -Filter *.reg -File -ErrorAction SilentlyContinue | ForEach-Object { reg.exe import $_.FullName 2>$null | Out-Null }
    Log 'Restore Registry เสร็จแล้ว'
    [System.Windows.Forms.MessageBox]::Show('Restore เสร็จแล้ว แนะนำให้ Restart Windows','RESTORE',[System.Windows.Forms.MessageBoxButtons]::OK,[System.Windows.Forms.MessageBoxIcon]::Information) | Out-Null
}

# -------------------- Safe debloat actions --------------------
function Set-Dword($Path,$Name,[uint32]$Value){
    if(-not(Test-Path $Path)){New-Item -Path $Path -Force | Out-Null}
    New-ItemProperty -Path $Path -Name $Name -PropertyType DWord -Value $Value -Force | Out-Null
}

function Apply-Privacy {
    # Consumer content / suggestions
    $cc='HKCU:\Software\Microsoft\Windows\CurrentVersion\ContentDeliveryManager'
    $names=@(
        'ContentDeliveryAllowed','FeatureManagementEnabled','OemPreInstalledAppsEnabled',
        'PreInstalledAppsEnabled','PreInstalledAppsEverEnabled','SilentInstalledAppsEnabled',
        'SystemPaneSuggestionsEnabled','SubscribedContent-338387Enabled','SubscribedContent-338388Enabled',
        'SubscribedContent-353698Enabled','RotatingLockScreenEnabled','RotatingLockScreenOverlayEnabled'
    )
    foreach($n in $names){ Set-Dword $cc $n 0 }

    # Telemetry policy: security/basic level. Does not disable Windows Update.
    Set-Dword 'HKLM:\SOFTWARE\Policies\Microsoft\Windows\DataCollection' 'AllowTelemetry' 1

    $script:State.Privacy=$true
    Log 'Privacy / consumer suggestions applied'
}

function Remove-ConsumerApps {
    $patterns=@(
        'Microsoft.BingNews','Microsoft.BingWeather','Microsoft.GetHelp',
        'Microsoft.Getstarted','Microsoft.MicrosoftSolitaireCollection',
        'Microsoft.People','Microsoft.PowerAutomateDesktop','Microsoft.Todos',
        'Microsoft.WindowsFeedbackHub','Microsoft.XboxApp','Microsoft.XboxGamingOverlay',
        'Microsoft.XboxGameOverlay','Microsoft.XboxIdentityProvider','Microsoft.XboxSpeechToTextOverlay'
    )
    foreach($pat in $patterns){
        Get-AppxPackage -AllUsers -Name $pat -ErrorAction SilentlyContinue | ForEach-Object {
            try { Remove-AppxPackage -Package $_.PackageFullName -AllUsers -ErrorAction Stop; Log "Removed: $($_.Name)" } catch { Log "Skipped: $($_.Name)" }
        }
    }
    $script:State.AppCleanup=$true
    Log 'Consumer app cleanup completed'
}

function Apply-Services {
    # Conservative list: do not touch Windows Update, Defender, Audio, Network, DHCP, DNS, RPC, etc.
    $services=@('DiagTrack','dmwappushservice','MapsBroker','RetailDemo')
    foreach($name in $services){
        $svc=Get-Service -Name $name -ErrorAction SilentlyContinue
        if($svc){
            try{
                if($svc.Status -ne 'Stopped'){ Stop-Service -Name $name -Force -ErrorAction SilentlyContinue }
                Set-Service -Name $name -StartupType Disabled -ErrorAction Stop
                Log "Service disabled: $name"
            }catch{ Log "Service skipped: $name" }
        }
    }
    $script:State.Services=$true
    Log 'Selected non-essential services processed'
}

function Apply-Debloat {
    try {
        $b=New-Backup
        Log "Backup created: $b"
        Apply-Privacy
        Remove-ConsumerApps
        Apply-Services
        $script:State.DebloatRun=$true
        $script:State.LastAction='DEBLOAT'
        $script:State.LastRun=(Get-Date).ToString('s')
        Save-State
        Log 'DEBLOAT completed'
        [System.Windows.Forms.MessageBox]::Show("Debloat เสร็จแล้ว`n`nBackup:`n$b`n`nแนะนำ Restart Windows",'LARZONE DEBLOAT',[System.Windows.Forms.MessageBoxButtons]::OK,[System.Windows.Forms.MessageBoxIcon]::Information) | Out-Null
    } catch {
        Log "ERROR: $($_.Exception.Message)"
        [System.Windows.Forms.MessageBox]::Show($_.Exception.Message,'ERROR',[System.Windows.Forms.MessageBoxButtons]::OK,[System.Windows.Forms.MessageBoxIcon]::Error) | Out-Null
    }
}

# -------------------- Status --------------------
function Show-Status {
    $f=New-Object System.Windows.Forms.Form
