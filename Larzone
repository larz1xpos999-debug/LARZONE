            @(
                @{Id="Priority";Name="Multimedia / Gaming Priority";Desc="ตั้งค่าโปรไฟล์สำหรับงาน multimedia และเกม";Risk="MEDIUM";Default=$true},
                @{Id="GPU";Name="GPU Scheduling Profile";Desc="โปรไฟล์การจัดการงาน GPU";Risk="MEDIUM";Default=$false},
                @{Id="SystemResponsiveness";Name="System Responsiveness";Desc="ปรับการแบ่งทรัพยากรสำหรับงาน foreground";Risk="MEDIUM";Default=$false},
                @{Id="NetworkThrottling";Name="Network Throttling Profile";Desc="ปรับ policy ของ multimedia network";Risk="MEDIUM";Default=$false},
                @{Id="PowerProfile";Name="Power Profile";Desc="เลือกแนวทางประสิทธิภาพของระบบ";Risk="SAFE";Default=$false}
            )
        }
        "KEYBOARD" {
            @(
                @{Id="KeyboardDelay";Name="Keyboard Delay";Desc="ปรับเวลาหน่วงก่อนเริ่มซ้ำปุ่ม";Risk="SAFE";Default=$false},
                @{Id="KeyboardSpeed";Name="Keyboard Repeat Speed";Desc="ปรับความเร็วการกดค้าง";Risk="SAFE";Default=$false},
                @{Id="DisableFilterKeys";Name="Disable Filter Keys";Desc="ลดโอกาสเปิด Filter Keys โดยไม่ตั้งใจ";Risk="SAFE";Default=$true},
                @{Id="RawKeyboard";Name="Raw Keyboard Preference";Desc="เก็บโปรไฟล์อินพุตสำหรับเกม";Risk="MEDIUM";Default=$false}
            )
        }
        "MOUSE" {
            @(
                @{Id="MouseAcceleration";Name="Disable Mouse Acceleration";Desc="ปิด acceleration ของเมาส์";Risk="SAFE";Default=$true},
                @{Id="MouseSpeed";Name="Mouse Speed";Desc="ตั้งความเร็วเมาส์ Windows";Risk="SAFE";Default=$false},
                @{Id="MouseThreshold";Name="Mouse Threshold";Desc="ปรับ threshold ของ pointer acceleration";Risk="SAFE";Default=$false},
                @{Id="MouseEnhance";Name="Enhance Pointer Precision";Desc="เปิด/ปิด Windows pointer precision";Risk="MEDIUM";Default=$false}
            )
        }
    }

    $checks=@{}
    $y=105
    foreach($item in $profiles){
        $cb=New-Object Windows.Forms.CheckBox
        $cb.Text=$item.Name
        $cb.Font=New-Object Drawing.Font("Segoe UI Semibold",11)
        $cb.ForeColor=$RiskColor[$item.Risk]
        $cb.AutoSize=$true
        $cb.Location=New-Object Drawing.Point(45,$y)
        $cb.Checked=[bool]$item.Default
        $f.Controls.Add($cb)
        $checks[$item.Id]=$cb

        $d=New-Object Windows.Forms.Label
        $d.Text=$item.Desc
        $d.Font=New-Object Drawing.Font("Segoe UI",9)
        $d.ForeColor=[Drawing.Color]::Gainsboro
        $d.AutoSize=$true
        $d.Location=New-Object Drawing.Point(70,($y+28))
        $f.Controls.Add($d)
        $y+=75
    }

    Btn $f "DEFAULT" 45 470 165 55 { foreach($i in $profiles){$checks[$i.Id].Checked=[bool]$i.Default} } | Out-Null
    Btn $f "ALL ON" 220 470 165 55 { foreach($c in $checks.Values){$c.Checked=$true} } | Out-Null
    Btn $f "ALL OFF" 395 470 165 55 { foreach($c in $checks.Values){$c.Checked=$false} } | Out-Null
    Btn $f "APPLY" 570 470 165 55 {
        if(-not (Confirm "สร้าง Backup ก่อน Apply โปรไฟล์ $Type หรือไม่?")){return}
        New-Backup $Type
        foreach($id in @($checks.GetEnumerator()|Where-Object {$_.Value.Checked}|ForEach-Object Key)){
            switch($id){
                "MouseAcceleration" {
                    Dword "HKCU:\Control Panel\Mouse" "MouseSpeed" 0
                    Dword "HKCU:\Control Panel\Mouse" "MouseThreshold1" 0
                    Dword "HKCU:\Control Panel\Mouse" "MouseThreshold2" 0
                }
                "KeyboardDelay" { StringValue "HKCU:\Control Panel\Keyboard" "KeyboardDelay" "0" }
                "KeyboardSpeed" { StringValue "HKCU:\Control Panel\Keyboard" "KeyboardSpeed" "31" }
                "DisableFilterKeys" { Dword "HKCU:\Control Panel\Accessibility\Keyboard Response" "Flags" 122 }
                "SystemResponsiveness" { Dword "HKLM:\SOFTWARE\Microsoft\Windows NT\CurrentVersion\Multimedia\SystemProfile" "SystemResponsiveness" 10 }
                "NetworkThrottling" { Dword "HKLM:\SOFTWARE\Microsoft\Windows NT\CurrentVersion\Multimedia\SystemProfile" "NetworkThrottlingIndex" 10 }
                "PowerProfile" { powercfg /setactive SCHEME_MAX | Out-Null }
                "Priority" {
                    Dword "HKLM:\SOFTWARE\Microsoft\Windows NT\CurrentVersion\Multimedia\SystemProfile" "SystemResponsiveness" 10
                    Dword "HKLM:\SOFTWARE\Microsoft\Windows NT\CurrentVersion\Multimedia\SystemProfile\Tasks\Games" "GPU Priority" 8
                    Dword "HKLM:\SOFTWARE\Microsoft\Windows NT\CurrentVersion\Multimedia\SystemProfile\Tasks\Games" "Priority" 6
                }
            }
        }
        Info "$Type Apply แล้ว`r`nBackup ถูกสร้างไว้ก่อน Apply"
    } | Out-Null
    Btn $f "BACK" 745 470 100 55 {$f.Close()} | Out-Null
    [void]$f.ShowDialog()
}

# ---------- System ----------
function Open-System {
    $f = New-Window "LARZONE // SYSTEM" 900 620
    Title $f "SYSTEM"

    $cpu = (Get-CimInstance Win32_Processor | Select-Object -First 1).Name
    $gpu = (Get-CimInstance Win32_VideoController | Select-Object -First 1).Name
    $cs = Get-CimInstance Win32_ComputerSystem
    $actualGB = [math]::Round($cs.TotalPhysicalMemory/1GB,0)

    $infoLabel = New-Object Windows.Forms.Label
    $infoLabel.Text = "CPU : $cpu`r`nGPU : $gpu`r`nRAM : $actualGB GB"
    $infoLabel.Font = New-Object Drawing.Font("Segoe UI",10)
    $infoLabel.AutoSize = $true
    $infoLabel.Location = New-Object Drawing.Point(40,80)
    $f.Controls.Add($infoLabel)

    Btn $f "WIN32" 40 175 190 60 { Open-SystemProfile "WIN32" } | Out-Null
    Btn $f "KEYBOARD" 245 175 190 60 { Open-SystemProfile "KEYBOARD" } | Out-Null
    Btn $f "MOUSE" 450 175 190 60 { Open-SystemProfile "MOUSE" } | Out-Null

    $ramLabel = New-Object Windows.Forms.Label
    $ramLabel.Text = "RAM PROFILE"
    $ramLabel.Font = New-Object Drawing.Font("Segoe UI Semibold",11)
    $ramLabel.AutoSize = $true
    $ramLabel.Location = New-Object Drawing.Point(40,275)
    $f.Controls.Add($ramLabel)

    $ramCombo = New-Object Windows.Forms.ComboBox
    $ramCombo.Font = New-Object Drawing.Font("Segoe UI",11)
    $ramCombo.DropDownStyle = "DropDownList"
    [void]$ramCombo.Items.Add("DEFAULT")
    foreach ($r in @(4,8,12,16,24,32,48,64)) { [void]$ramCombo.Items.Add("$r GB") }
    $ramCombo.SelectedIndex = 0
    $ramCombo.Location = New-Object Drawing.Point(40,310)
    $ramCombo.Size = New-Object Drawing.Size(220,40)
    $f.Controls.Add($ramCombo)

    Btn $f "APPLY RAM" 280 305 180 50 {
        $sel = [string]$ramCombo.SelectedItem
        if ($sel -eq "DEFAULT") {
            Info "RAM = DEFAULT`r`nใช้ค่า Default ของโปรไฟล์เดิม"
        } else {
            Info "RAM profile = $sel`r`nใช้ค่าเดิมของโปรไฟล์ $sel"
        }
    } | Out-Null

    Btn $f "REFRESH" 480 305 180 50 {
        $now = Get-CimInstance Win32_ComputerSystem
        $infoLabel.Text = "CPU : $((Get-CimInstance Win32_Processor | Select -First 1).Name)`r`nGPU : $((Get-CimInstance Win32_VideoController | Select -First 1).Name)`r`nRAM : $([math]::Round($now.TotalPhysicalMemory/1GB,0)) GB"
    } | Out-Null

    $note = New-Object Windows.Forms.Label
    $note.Text = "SYSTEM NOTE`r`n• Gaming NORMAL/HIGH ไม่เปลี่ยน RAM`r`n• RAM Profile ใช้ค่าเดิมของแต่ละโปรไฟล์`r`n• DEFAULT = ใช้ค่าที่ Windows ตรวจพบ/ค่า Default ของ LARZONE`r`n• Refresh ใช้สำหรับอ่านค่าฮาร์ดแวร์ปัจจุบันใหม่"
    $note.Font = New-Object Drawing.Font("Segoe UI",9)
    $note.ForeColor = [Drawing.Color]::LightGray
    $note.AutoSize = $true
    $note.Location = New-Object Drawing.Point(40,390)
    $f.Controls.Add($note)

    Btn $f "BACK" 330 500 200 55 { $f.Close() } | Out-Null
    [void]$f.ShowDialog()
}

# ---------- Backup / Restore ----------
function Open-Backup {
    $f = New-Window "LARZONE // BACKUP / RESTORE" 900 620
    Title $f "BACKUP / RESTORE"

    $list = New-Object Windows.Forms.ListBox
    $list.Font = New-Object Drawing.Font("Segoe UI",10)
    $list.Location = New-Object Drawing.Point(35,90)
    $list.Size = New-Object Drawing.Size(820,300)
    $f.Controls.Add($list)

    function Refresh-List {
        $list.Items.Clear()
        Get-ChildItem $BackupRoot -Directory -EA 0 |
            Sort-Object LastWriteTime -Descending |
            ForEach-Object { [void]$list.Items.Add($_.FullName) }
    }
    Refresh-List

    Btn $f "CREATE BACKUP" 35 425 200 55 {
        [void](New-Backup "MANUAL")
        Refresh-List
        Info "สร้าง Backup แล้ว"
    } | Out-Null

    Btn $f "RESTORE SELECTED" 250 425 220 55 {
        if (-not $list.SelectedItem) { Info "กรุณาเลือก Backup"; return }
        if (Confirm "Import Registry จาก Backup ที่เลือกหรือไม่?") {
            Get-ChildItem ([string]$list.SelectedItem) -Filter "*.reg" -EA 0 |
                ForEach-Object { & reg.exe import $_.FullName | Out-Null }
            Info "Restore เสร็จแล้ว`r`nแนะนำ Restart Windows"
        }
    } | Out-Null

    Btn $f "REFRESH" 485 425 150 55 { Refresh-List } | Out-Null
    Btn $f "BACK" 650 425 150 55 { $f.Close() } | Out-Null

    [void]$f.ShowDialog()
}

