# ---------- Paths ----------
$Root = Join-Path $env:ProgramData "LARZONE\V3.2.5"
$BackupRoot = Join-Path $Root "Backups"
$LogRoot = Join-Path $Root "Logs"
New-Item -ItemType Directory -Force -Path $BackupRoot,$LogRoot | Out-Null
$LogFile = Join-Path $LogRoot ("LARZONE_{0}.log" -f (Get-Date -Format "yyyyMMdd_HHmmss"))

function Log($s) {
    Add-Content -LiteralPath $LogFile -Value ("[{0}] {1}" -f (Get-Date -Format "yyyy-MM-dd HH:mm:ss"),$s)
}

function Dword($Path,$Name,[uint32]$Value) {
    New-Item -Path $Path -Force | Out-Null
    $hex = ('0x{0:X8}' -f $Value)
    $native = ($Path -replace '^HKLM:','HKLM' -replace '^HKCU:','HKCU')
    & reg.exe ADD $native /v $Name /t REG_DWORD /d $hex /f | Out-Null
    if($LASTEXITCODE -ne 0){ throw "Registry write failed: $native\$Name" }
    Log "DWORD $Path\$Name=$hex"
}

function StringValue($Path,$Name,$Value) {
    New-Item -Path $Path -Force | Out-Null
    New-ItemProperty -Path $Path -Name $Name -PropertyType String -Value $Value -Force | Out-Null
    Log "STRING $Path\$Name=$Value"
}

function Backup-Reg($key,$file) {
    & reg.exe export $key $file /y | Out-Null
}

function New-Backup($profile="MANUAL") {
    $dir = Join-Path $BackupRoot ("{0}_{1}" -f (Get-Date -Format "yyyyMMdd_HHmmss"),$profile)
    New-Item -ItemType Directory -Force -Path $dir | Out-Null

    Backup-Reg "HKCU\Software\Microsoft\Windows\CurrentVersion\Explorer" (Join-Path $dir "Explorer.reg")
    Backup-Reg "HKCU\Software\Microsoft\Windows\CurrentVersion\GameDVR" (Join-Path $dir "GameDVR.reg")
    Backup-Reg "HKCU\Software\Microsoft\GameBar" (Join-Path $dir "GameBar.reg")
    Backup-Reg "HKLM\SOFTWARE\Microsoft\Windows NT\CurrentVersion\Multimedia\SystemProfile" (Join-Path $dir "SystemProfile.reg")
    Backup-Reg "HKCU\Control Panel\Mouse" (Join-Path $dir "Mouse.reg")
    Backup-Reg "HKLM\SYSTEM\CurrentControlSet\Services\kbdclass\Parameters" (Join-Path $dir "KeyboardClass.reg")
    Backup-Reg "HKLM\SYSTEM\CurrentControlSet\Services\mouclass\Parameters" (Join-Path $dir "MouseClass.reg")
    Backup-Reg "HKLM\SYSTEM\CurrentControlSet\Control\PriorityControl" (Join-Path $dir "PriorityControl.reg")

    try { powercfg /getactivescheme | Out-File (Join-Path $dir "PowerPlan.txt") -Encoding utf8 } catch {}
    try {
        Get-CimInstance Win32_Service |
            Select-Object Name,StartMode,State |
            Export-Csv (Join-Path $dir "Services.csv") -NoTypeInformation -Encoding UTF8
    } catch {}

    Set-Content (Join-Path $dir "INFO.txt") @"
LARZONE V3.2.5 BACKUP
Profile : $profile
Date    : $(Get-Date)
Computer: $env:COMPUTERNAME
"@ -Encoding UTF8

    Log "BACKUP CREATED $dir"; Add-SystemNote "Backup → Created"
    return $dir
}

function Confirm($text) {
    return ([Windows.Forms.MessageBox]::Show(
        $text,"LARZONE",
        [Windows.Forms.MessageBoxButtons]::YesNo,
        [Windows.Forms.MessageBoxIcon]::Warning
    ) -eq [Windows.Forms.DialogResult]::Yes)
}

function Info($text) {
    [Windows.Forms.MessageBox]::Show(
        $text,"LARZONE",
        [Windows.Forms.MessageBoxButtons]::OK,
        [Windows.Forms.MessageBoxIcon]::Information
    ) | Out-Null
}

function Btn($Form,$Text,$X,$Y,$W,$H,$Action) {
    $b = New-Object Windows.Forms.Button
    $b.Text = $Text
    $b.Font = New-Object Drawing.Font("Segoe UI Semibold",11)
    $b.Location = New-Object Drawing.Point($X,$Y)
    $b.Size = New-Object Drawing.Size($W,$H)
    $b.BackColor = [Drawing.Color]::FromArgb(30,27,48)
    $b.ForeColor = [Drawing.Color]::White
    $b.FlatStyle = "Flat"
    $b.FlatAppearance.BorderColor=[Drawing.Color]::FromArgb(105,85,220)
    $b.FlatAppearance.BorderSize=1
    $b.Add_Click($Action)
    $b.Add_MouseEnter({$this.BackColor=[Drawing.Color]::FromArgb(52,42,85)})
    $b.Add_MouseLeave({$this.BackColor=[Drawing.Color]::FromArgb(30,27,48)})
    $Form.Controls.Add($b)
    return $b
}

function New-Window($Title,$W=900,$H=650) {
    $f = New-Object Windows.Forms.Form
    $f.Text = $Title
    $f.StartPosition = "CenterScreen"
    $f.ClientSize = New-Object Drawing.Size($W,$H)
    $f.BackColor = [Drawing.Color]::FromArgb(11,10,18)
    $f.ForeColor = [Drawing.Color]::White
    $f.FormBorderStyle = "FixedSingle"
    $f.MaximizeBox = $false
    return $f
}

function Title($Form,$Text) {
    $l = New-Object Windows.Forms.Label
    $l.Text = $Text
    $l.Font = New-Object Drawing.Font("Segoe UI Semibold",22)
    $l.ForeColor = [Drawing.Color]::FromArgb(145,120,255)
    $l.AutoSize = $true
    $l.Location = New-Object Drawing.Point(30,25)
    $Form.Controls.Add($l)
}

