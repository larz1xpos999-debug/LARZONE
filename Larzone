function Open-BackupUI {
    $f = New-Window 'LARZONE // BACKUP / RESTORE' 900 620
    Title-UI $f 'BACKUP / RESTORE'

    $list = New-Object Windows.Forms.ListBox
    $list.Font = New-Object Drawing.Font('Segoe UI', 10)
    $list.Location = New-Object Drawing.Point(35, 90)
    $list.Size = New-Object Drawing.Size(820, 300)
    $f.Controls.Add($list)

    function Refresh-List {
        $list.Items.Clear()
        Get-ChildItem $BackupRoot -Directory -ErrorAction SilentlyContinue |
            Sort-Object LastWriteTime -Descending |
            ForEach-Object { [void]$list.Items.Add($_.FullName) }
    }
    Refresh-List

    Btn-UI $f 'CREATE BACKUP' 35 425 200 55 {
        [void](New-Backup 'MANUAL')
        Refresh-List
        Info-UI 'สร้าง Backup แล้ว'
    } | Out-Null

    Btn-UI $f 'RESTORE SELECTED' 250 425 220 55 {
        if (-not $list.SelectedItem) { Info-UI 'กรุณาเลือก Backup'; return }
        if (Confirm-UI 'Import Registry จาก Backup ที่เลือกหรือไม่?') {
            Get-ChildItem ([string]$list.SelectedItem) -Filter '*.reg' -ErrorAction SilentlyContinue |
                ForEach-Object { & reg.exe import $_.FullName | Out-Null }
            Info-UI "Restore เสร็จแล้ว`r`nแนะนำ Restart Windows"
            Add-SystemNote 'Restore → Imported selected backup'
        }
    } | Out-Null

    Btn-UI $f 'REFRESH' 485 425 150 55 { Refresh-List } | Out-Null
    Btn-UI $f 'BACK' 650 425 150 55 { $f.Close() } | Out-Null
    [void]$f.ShowDialog()
}

function Show-SystemNoteUI {
    $f = New-Window 'LARZONE // SYSTEM NOTE' 720 700
    Title-UI $f 'SYSTEM NOTE'

    $box = New-Object Windows.Forms.TextBox
    $box.Multiline = $true
    $box.ReadOnly = $true
    $box.ScrollBars = 'Vertical'
    $box.WordWrap = $false
    $box.Font = New-Object Drawing.Font('Consolas', 10)
    $box.ForeColor = [Drawing.Color]::White
    $box.BackColor = [Drawing.Color]::FromArgb(15, 22, 32)
    $box.Location = New-Object Drawing.Point(30, 85)
    $box.Size = New-Object Drawing.Size(655, 440)
    $f.Controls.Add($box)

    function Refresh-NoteBox {
        $box.Text = (Get-MachineSummary) + "`r`n`r`n" + ((Get-SystemNotes) -join [Environment]::NewLine)
        $box.SelectionStart = $box.TextLength
        $box.ScrollToCaret()
    }
    Refresh-NoteBox

    Btn-UI $f 'REFRESH' 30 530 150 50 { Refresh-NoteBox } | Out-Null
    Btn-UI $f 'CLEAR' 195 530 150 50 {
        if (Confirm-UI 'ล้าง System Note ทั้งหมดหรือไม่?') {
            Clear-Content -LiteralPath $NoteFile -ErrorAction SilentlyContinue
            Refresh-NoteBox
            Add-SystemNote 'SystemNote → Cleared'
        }
    } | Out-Null
    Btn-UI $f 'CLOSE' 435 530 150 50 { $f.Close() } | Out-Null
    [void]$f.ShowDialog()
}

