function Verify-Tweak($Id) {
    switch ($Id) {
        "AdvertisingID" { return ((Get-ItemProperty "HKCU:\Software\Microsoft\Windows\CurrentVersion\AdvertisingInfo" -Name Enabled -EA 0).Enabled -eq 0) }
        "TailoredExperiences" { return ((Get-ItemProperty "HKCU:\Software\Microsoft\Windows\CurrentVersion\Privacy" -Name TailoredExperiencesWithDiagnosticDataEnabled -EA 0).TailoredExperiencesWithDiagnosticDataEnabled -eq 0) }
        "FeedbackRequests" { return ((Get-ItemProperty "HKCU:\Software\Microsoft\Siuf\Rules" -Name NumberOfSIUFInPeriod -EA 0).NumberOfSIUFInPeriod -eq 0) }
        "ActivityHistory" { return ((Get-ItemProperty "HKLM:\SOFTWARE\Policies\Microsoft\Windows\System" -Name EnableActivityFeed -EA 0).EnableActivityFeed -eq 0) }
        "Location" { return ((Get-ItemProperty "HKLM:\SOFTWARE\Policies\Microsoft\Windows\LocationAndSensors" -Name DisableLocation -EA 0).DisableLocation -eq 1) }
        "ConsumerFeatures" { return ((Get-ItemProperty "HKLM:\SOFTWARE\Policies\Microsoft\Windows\CloudContent" -Name DisableWindowsConsumerFeatures -EA 0).DisableWindowsConsumerFeatures -eq 1) }
        "Suggestions" { return ((Get-ItemProperty "HKCU:\Software\Microsoft\Windows\CurrentVersion\ContentDeliveryManager" -Name SystemPaneSuggestionsEnabled -EA 0).SystemPaneSuggestionsEnabled -eq 0) }
        "Widgets" { return ((Get-ItemProperty "HKLM:\SOFTWARE\Policies\Microsoft\Dsh" -Name AllowNewsAndInterests -EA 0).AllowNewsAndInterests -eq 0) }
        "Copilot" { return ((Get-ItemProperty "HKCU:\Software\Policies\Microsoft\Windows\WindowsCopilot" -Name TurnOffWindowsCopilot -EA 0).TurnOffWindowsCopilot -eq 1) }
        "Transparency" { return ((Get-ItemProperty "HKCU:\Software\Microsoft\Windows\CurrentVersion\Themes\Personalize" -Name EnableTransparency -EA 0).EnableTransparency -eq 0) }
        "TaskbarAnimations" { return ((Get-ItemProperty "HKCU:\Software\Microsoft\Windows\CurrentVersion\Explorer\Advanced" -Name TaskbarAnimations -EA 0).TaskbarAnimations -eq 0) }
        "VisualFX" { return ((Get-ItemProperty "HKCU:\Software\Microsoft\Windows\CurrentVersion\Explorer\VisualEffects" -Name VisualFXSetting -EA 0).VisualFXSetting -eq 2) }
        "SearchHighlights" { return ((Get-ItemProperty "HKCU:\Software\Microsoft\Windows\CurrentVersion\SearchSettings" -Name IsDynamicSearchBoxEnabled -EA 0).IsDynamicSearchBoxEnabled -eq 0) }
        "BackgroundApps" { return ((Get-ItemProperty "HKCU:\Software\Microsoft\Windows\CurrentVersion\BackgroundAccessApplications" -Name GlobalUserDisabled -EA 0).GlobalUserDisabled -eq 1) }
        "StartupSuggestions" { return ((Get-ItemProperty "HKCU:\Software\Microsoft\Windows\CurrentVersion\ContentDeliveryManager" -Name SubscribedContent-338393Enabled -EA 0).'SubscribedContent-338393Enabled' -eq 0) }
        "GameDVR" { return ((Get-ItemProperty "HKCU:\System\GameConfigStore" -Name GameDVR_Enabled -EA 0).GameDVR_Enabled -eq 0) }
        "GameCapture" { return ((Get-ItemProperty "HKCU:\SOFTWARE\Microsoft\Windows\CurrentVersion\GameDVR" -Name AppCaptureEnabled -EA 0).AppCaptureEnabled -eq 0) }
        "GameBar" { return ((Get-ItemProperty "HKCU:\Software\Microsoft\GameBar" -Name UseNexusForGameBarEnabled -EA 0).UseNexusForGameBarEnabled -eq 0) }
        default { return $true }
    }
}

function Apply-Selected($selectedIds) {
    if (-not $selectedIds -or $selectedIds.Count -eq 0) {
        Info "ยังไม่ได้เลือกค่า"
        return
    }

    if (-not (Confirm "LARZONE จะสร้าง Backup ก่อน Apply และตรวจสอบผลหลัง Apply`r`n`r`nดำเนินการต่อหรือไม่?")) { return }

    $backup = New-Backup "CUSTOM"
    $results = @()

    foreach ($id in $selectedIds) {
        try {
            Apply-Tweak $id
            $ok = Verify-Tweak $id
            $results += [pscustomobject]@{Id=$id;OK=$ok}
        } catch {
            Log "ERROR $id : $($_.Exception.Message)"
            $results += [pscustomobject]@{Id=$id;OK=$false}
        }
    }

    $okCount = @($results | Where-Object OK).Count
    $badCount = @($results | Where-Object { -not $_.OK }).Count
    Add-SystemNote ("Custom/Debloat → Applied {0}, Verified {1}, Failed {2}" -f $selectedIds.Count,$okCount,$badCount); Info "Apply เสร็จ`r`n`r`nสำเร็จ: $okCount`r`nไม่ผ่าน/ตรวจสอบไม่ได้: $badCount`r`n`r`nBackup: $backup"
}

# ---------- Category UI ----------
function Open-Category($Category) {
    $items = @($Tweaks[$Category])
    $f = New-Window "LARZONE // $Category" 980 720
    Title $f $Category

    $legend = New-Object Windows.Forms.Label
    $legend.Text = "🟢 SAFE     🟡 MEDIUM     🔴 RISKY"
    $legend.Font = New-Object Drawing.Font("Segoe UI",10)
    $legend.AutoSize = $true
    $legend.Location = New-Object Drawing.Point(35,70)
    $f.Controls.Add($legend)

    # Scroll area: mouse wheel + scrollbar work here.
    $panel = New-Object Windows.Forms.Panel
    $panel.AutoScroll = $true
    $panel.VerticalScroll.SmallChange = 25
    $panel.VerticalScroll.LargeChange = 120
    $panel.Location = New-Object Drawing.Point(25,105)
    $panel.Size = New-Object Drawing.Size(930,485)
    $panel.BorderStyle = "FixedSingle"
    $f.Controls.Add($panel)

    $checks=@{}
    $y=15
    foreach($item in $items){
        $cb=New-Object Windows.Forms.CheckBox
        $cb.Text=$item.Name
        $cb.Font=New-Object Drawing.Font("Segoe UI Semibold",11)
        $cb.ForeColor=$RiskColor[$item.Risk]
        $cb.AutoSize=$true
        $cb.Location=New-Object Drawing.Point(20,$y)
        $cb.Checked=[bool]$item.Default
        $panel.Controls.Add($cb)
        $checks[$item.Id]=$cb

        $desc=New-Object Windows.Forms.Label
        $desc.Text=$item.Desc
        $desc.Font=New-Object Drawing.Font("Segoe UI",9)
        $desc.ForeColor=[Drawing.Color]::Gainsboro
        $desc.AutoSize=$true
        $desc.Location=New-Object Drawing.Point(45,($y+28))
        $panel.Controls.Add($desc)
        $y+=68
    }

    # Keep action buttons fixed while only the list scrolls.
    Btn $f "DEFAULT" 35 610 165 50 {foreach($item in $items){$checks[$item.Id].Checked=[bool]$item.Default}} | Out-Null
    Btn $f "ALL ON" 215 610 165 50 {foreach($c in $checks.Values){$c.Checked=$true}} | Out-Null
    Btn $f "ALL OFF" 395 610 165 50 {foreach($c in $checks.Values){$c.Checked=$false}} | Out-Null
    Btn $f "APPLY" 575 610 165 50 {
        $selected=@($checks.GetEnumerator()|Where-Object {$_.Value.Checked}|ForEach-Object Key)
        Apply-Selected $selected
        Add-SystemNote ("$Category → Applied {0} tweaks" -f $selected.Count)
    } | Out-Null
    Btn $f "BACK" 755 610 165 50 {$f.Close()} | Out-Null
    [void]$f.ShowDialog()
}

# ---------- Custom/Debloat ----------
function Open-Custom {
    $f = New-Window "LARZONE // CUSTOM / DEBLOAT" 900 650
    Title $f "CUSTOM / DEBLOAT"

    $desc = New-Object Windows.Forms.Label
    $desc.Text = "DEFAULT = ชุดแนะนำ | CUSTOM = เลือกแต่ละค่าเอง"
    $desc.Font = New-Object Drawing.Font("Segoe UI",11)
    $desc.AutoSize = $true
    $desc.Location = New-Object Drawing.Point(35,75)
    $f.Controls.Add($desc)

    $categories = @($Tweaks.Keys)
    $y = 125

    foreach ($cat in $categories) {
        $risk = if ($cat -eq "OPTIONAL / AGGRESSIVE") { "🔴" } else { "•" }
        Btn $f "$risk  $cat  >" 35 $y 830 48 {
            param($sender,$event)
            $catName = $sender.Text -replace "^[^A-Z]*","" -replace "\s+>$",""
            Open-Category $catName
        } | Out-Null
        $y += 55
    }

    Btn $f "DEFAULT ALL" 35 520 180 55 {
        Info "Default ของแต่ละหมวดถูกฟิกไว้ในรายการย่อยแล้ว`r`nเข้าแต่ละหมวดเพื่อดู/ปรับค่า"
    } | Out-Null

    Btn $f "BACK" 700 520 165 55 { $f.Close() } | Out-Null
    [void]$f.ShowDialog()
}

