function Remove-App($Name) {
    $pkg = $Apps[$Name]
    if (-not $pkg) { return }
    Get-AppxPackage -AllUsers -Name $pkg | ForEach-Object {
        try {
            Remove-AppxPackage -Package $_.PackageFullName -AllUsers
            Write-Log "REMOVED APP $Name"
        } catch {}
    }
}

function Apply-Debloat($Selected) {
    New-Backup "DEBLOAT"
    foreach ($n in $Selected) { Remove-App $n }
}

