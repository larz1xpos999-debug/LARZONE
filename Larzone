function Parse-Uint32([string]$Text) {
    $t = ([string]$Text).Trim()
    if ($t -match '^(0x)?[0-9a-fA-F]{1,8}$' -and ($t -match '[a-fA-F]' -or $t.StartsWith('0x'))) {
        return [uint32]([Convert]::ToUInt64(($t -replace '^0x', ''), 16))
    }
    $n = 0L
    if ([long]::TryParse($t, [ref]$n) -and $n -ge 0 -and $n -le 4294967295) { return [uint32]$n }
    throw 'Invalid number'
}

# ----------------------- UI Helpers -----------------------
function New-Window([string]$Title, [int]$W = 900, [int]$H = 650) {
    $f = New-Object Windows.Forms.Form
    $f.Text = $Title
    $f.StartPosition = 'CenterScreen'
    $f.ClientSize = New-Object Drawing.Size($W, $H)
    $f.BackColor = [Drawing.Color]::FromArgb(11, 10, 18)
    $f.ForeColor = [Drawing.Color]::White
    $f.FormBorderStyle = 'FixedSingle'
    $f.MaximizeBox = $false
    return $f
}

function Title-UI($Form, [string]$Text) {
    $l = New-Object Windows.Forms.Label
    $l.Text = $Text
    $l.Font = New-Object Drawing.Font('Segoe UI Semibold', 22)
    $l.ForeColor = [Drawing.Color]::FromArgb(145, 120, 255)
    $l.AutoSize = $true
    $l.Location = New-Object Drawing.Point(30, 25)
    $Form.Controls.Add($l)
}

function Btn-UI($Form, [string]$Text, [int]$X, [int]$Y, [int]$W, [int]$H, $Action) {
    $b = New-Object Windows.Forms.Button
    $b.Text = $Text
    $b.Font = New-Object Drawing.Font('Segoe UI Semibold', 11)
    $b.Location = New-Object Drawing.Point($X, $Y)
    $b.Size = New-Object Drawing.Size($W, $H)
    $b.BackColor = [Drawing.Color]::FromArgb(30, 27, 48)
    $b.ForeColor = [Drawing.Color]::White
    $b.FlatStyle = 'Flat'
    $b.FlatAppearance.BorderColor = [Drawing.Color]::FromArgb(105, 85, 220)
    $b.FlatAppearance.BorderSize = 1
    $b.Add_Click($Action)
    $b.Add_MouseEnter({ $this.BackColor = [Drawing.Color]::FromArgb(52, 42, 85) })
    $b.Add_MouseLeave({ $this.BackColor = [Drawing.Color]::FromArgb(30, 27, 48) })
    $Form.Controls.Add($b)
    return $b
}

function Wire-MouseWheel($control, $panel) {
    $control.Add_MouseWheel({
        param($sender, $e)
        $max = [Math]::Max($panel.VerticalScroll.Minimum, $panel.VerticalScroll.Maximum - $panel.VerticalScroll.LargeChange + 1)
        $new = [Math]::Max($panel.VerticalScroll.Minimum, [Math]::Min($max, $panel.VerticalScroll.Value - [int]$e.Delta))
        $panel.VerticalScroll.Value = $new
        $panel.PerformLayout()
    })
    foreach ($child in @($control.Controls)) { Wire-MouseWheel $child $panel }
}

function Open-CategoryUI([string]$Category) {
    $items = @($Tweaks[$Category])
    $f = New-Window "LARZONE // $Category" 980 720
    Title-UI $f $Category

    $legend = New-Object Windows.Forms.Label
    $legend.Text = '🟢 SAFE     🟡 MEDIUM     🔴 RISKY'
    $legend.Font = New-Object Drawing.Font('Segoe UI', 10)
    $legend.AutoSize = $true
    $legend.Location = New-Object Drawing.Point(35, 70)
    $f.Controls.Add($legend)

    $panel = New-Object Windows.Forms.Panel
    $panel.AutoScroll = $true
    $panel.VerticalScroll.SmallChange = 35
    $panel.VerticalScroll.LargeChange = 140
    $panel.Location = New-Object Drawing.Point(25, 105)
    $panel.Size = New-Object Drawing.Size(930, 485)
    $panel.BorderStyle = 'FixedSingle'
    $panel.TabStop = $true
    $f.Controls.Add($panel)
    $panel.Add_MouseEnter({ $panel.Focus() })

    $checks = @{}
    $y = 15
    foreach ($item in $items) {
        $cb = New-Object Windows.Forms.CheckBox
        $cb.Text = $item.Name
        $cb.Font = New-Object Drawing.Font('Segoe UI Semibold', 11)
        $cb.ForeColor = $RiskColor[$item.Risk]
        $cb.AutoSize = $true
        $cb.Location = New-Object Drawing.Point(20, $y)
        $cb.Checked = [bool]$item.Default
        $panel.Controls.Add($cb)
        $checks[$item.Id] = $cb

        $desc = New-Object Windows.Forms.Label
        $desc.Text = $item.Desc
        $desc.Font = New-Object Drawing.Font('Segoe UI', 9)
        $desc.ForeColor = [Drawing.Color]::Gainsboro
        $desc.AutoSize = $true
        $desc.Location = New-Object Drawing.Point(45, ($y + 28))
        $panel.Controls.Add($desc)
        $y += 68
    }
    $panel.AutoScrollMinSize = New-Object Drawing.Size(0, ($y + 20))
    Wire-MouseWheel $panel $panel

    Btn-UI $f 'DEFAULT' 35 610 165 50 { foreach ($item in $items) { $checks[$item.Id].Checked = [bool]$item.Default } } | Out-Null
    Btn-UI $f 'ALL ON' 215 610 165 50 { foreach ($c in $checks.Values) { $c.Checked = $true } } | Out-Null
    Btn-UI $f 'ALL OFF' 395 610 165 50 { foreach ($c in $checks.Values) { $c.Checked = $false } } | Out-Null
    Btn-UI $f 'APPLY' 575 610 165 50 {
        $selected = @($checks.GetEnumerator() | Where-Object { $_.Value.Checked } | ForEach-Object Key)
        if (-not $selected -or $selected.Count -eq 0) { Info-UI 'ยังไม่ได้เลือกค่า'; return }
        if (-not (Confirm-UI "LARZONE จะสร้าง Backup ก่อน Apply และตรวจสอบผลหลัง Apply`r`n`r`nดำเนินการต่อหรือไม่?")) { return }

        $results = Invoke-ApplySelected $selected 'CUSTOM'
        $okCount = @($results | Where-Object OK).Count
        $badCount = @($results | Where-Object { -not $_.OK }).Count
        Info-UI "Apply เสร็จ`r`n`r`nสำเร็จ: $okCount`r`nไม่ผ่าน/ตรวจสอบไม่ได้: $badCount`r`n`r`nLog: $LogFile"
    } | Out-Null
    Btn-UI $f 'BACK' 755 610 165 50 { $f.Close() } | Out-Null

    [void]$f.ShowDialog()
}

function Open-CustomUI {
    $f = New-Window 'LARZONE // CUSTOM / DEBLOAT' 900 650
    Title-UI $f 'CUSTOM / DEBLOAT'

    $desc = New-Object Windows.Forms.Label
    $desc.Text = 'เลือกหมวดเพื่อปรับทีละค่า  •  🟢 SAFE  🟡 MEDIUM  🔴 RISKY'
    $desc.Font = New-Object Drawing.Font('Segoe UI', 10)
    $desc.AutoSize = $true
    $desc.Location = New-Object Drawing.Point(35, 75)
    $f.Controls.Add($desc)

    $panel = New-Object Windows.Forms.Panel
    $panel.AutoScroll = $true
    $panel.VerticalScroll.SmallChange = 35
    $panel.VerticalScroll.LargeChange = 140
    $panel.TabStop = $true
    $panel.Location = New-Object Drawing.Point(25, 105)
    $panel.Size = New-Object Drawing.Size(850, 455)
    $panel.BorderStyle = 'FixedSingle'
    $f.Controls.Add($panel)
    $panel.Add_MouseEnter({ $panel.Focus() })

    $categories = @($Tweaks.Keys)
    $y = 15
    foreach ($cat in $categories) {
        $risk = if ($cat -eq 'OPTIONAL / AGGRESSIVE') { '🔴' } else { '🟢' }
        $b = New-Object Windows.Forms.Button
        $b.Text = "$risk  $cat  >"
        $b.Font = New-Object Drawing.Font('Segoe UI Semibold', 11)
        $b.Location = New-Object Drawing.Point(15, $y)
        $b.Size = New-Object Drawing.Size(790, 48)
        $b.BackColor = [Drawing.Color]::FromArgb(30, 27, 48)
        $b.ForeColor = [Drawing.Color]::White
        $b.FlatStyle = 'Flat'
        $b.FlatAppearance.BorderColor = [Drawing.Color]::FromArgb(105, 85, 220)
        $b.Tag = $cat
        $b.Add_Click({ Open-CategoryUI ([string]$this.Tag) })
        $panel.Controls.Add($b)
        $y += 56
    }
    $panel.AutoScrollMinSize = New-Object Drawing.Size(0, ($y + 20))
    Wire-MouseWheel $panel $panel

    Btn-UI $f 'DEFAULT' 35 580 165 50 { Info-UI 'Default ถูกกำหนดไว้ในแต่ละหมวดแล้ว`r`nเข้าไปในหมวดเพื่อดูและปรับค่า' } | Out-Null
    Btn-UI $f 'BACK' 700 580 165 50 { $f.Close() } | Out-Null
    [void]$f.ShowDialog()
}

