function Remove-AppSafe($PackageName) {
    Get-AppxPackage -AllUsers -Name $PackageName | ForEach-Object {
        try {
            Remove-AppxPackage -Package $_.PackageFullName -AllUsers
            Log "APP REMOVED: $PackageName"
        } catch { Log "APP FAILED: $PackageName" }
    }
}

function Apply-Debloat($Names) {
    New-LarzoneBackup "DEBLOAT"
    foreach ($n in $Names) {
        $pkg = $DebloatMap.GetEnumerator() | Where-Object { $_.Value -eq $n } | Select-Object -First 1
        if ($pkg) { Remove-AppSafe $pkg.Key }
    }
}

