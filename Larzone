# ---------- System Profiles ----------
function Open-SystemProfile($Type) {
    if($Type -eq "KEYBOARD"){
        $f=New-Window "LARZONE // KEYBOARD" 560 380
        Title $f "KEYBOARD"
        $l=New-Object Windows.Forms.Label; $l.Text="Keyboard"; $l.AutoSize=$true
        $l.Font=New-Object Drawing.Font("Segoe UI Semibold",12); $l.ForeColor=[Drawing.Color]::White
        $l.Location=New-Object Drawing.Point(45,90); $f.Controls.Add($l)
        $box=New-Object Windows.Forms.TextBox; $box.Text="16"; $box.Font=New-Object Drawing.Font("Segoe UI",12)
        $box.Location=New-Object Drawing.Point(45,125); $box.Size=New-Object Drawing.Size(300,38); $f.Controls.Add($box)
        Btn $f "DEFAULT" 45 200 135 50 {$box.Text="16"} | Out-Null
        Btn $f "APPLY" 195 200 135 50 {
            $n=0
            if(-not [int]::TryParse($box.Text,[ref]$n) -or $n -lt 0){Info "ใส่ตัวเลข 0 ขึ้นไป";return}
            New-Backup "KEYBOARD"
            Dword "HKLM:\SYSTEM\CurrentControlSet\Services\kbdclass\Parameters" "KeyboardDataQueueSize" $n
            Add-SystemNote "Keyboard → $n"
            Info "Keyboard → $n"
        } | Out-Null
        Btn $f "BACK" 345 200 135 50 {$f.Close()} | Out-Null
        [void]$f.ShowDialog()
        return
    }
    if($Type -eq "MOUSE"){
        $f=New-Window "LARZONE // MOUSE" 560 380
        Title $f "MOUSE"
        $l=New-Object Windows.Forms.Label; $l.Text="Mouse"; $l.AutoSize=$true
        $l.Font=New-Object Drawing.Font("Segoe UI Semibold",12); $l.ForeColor=[Drawing.Color]::White
        $l.Location=New-Object Drawing.Point(45,90); $f.Controls.Add($l)
        $box=New-Object Windows.Forms.TextBox; $box.Text="25"; $box.Font=New-Object Drawing.Font("Segoe UI",12)
        $box.Location=New-Object Drawing.Point(45,125); $box.Size=New-Object Drawing.Size(300,38); $f.Controls.Add($box)
        Btn $f "DEFAULT" 45 200 135 50 {$box.Text="25"} | Out-Null
        Btn $f "APPLY" 195 200 135 50 {
            $n=0
            if(-not [int]::TryParse($box.Text,[ref]$n) -or $n -lt 0){Info "ใส่ตัวเลข 0 ขึ้นไป";return}
            New-Backup "MOUSE"
            Dword "HKLM:\SYSTEM\CurrentControlSet\Services\mouclass\Parameters" "MouseDataQueueSize" $n
            Add-SystemNote "Mouse → $n"
            Info "Mouse → $n"
        } | Out-Null
        Btn $f "BACK" 345 200 135 50 {$f.Close()} | Out-Null
        [void]$f.ShowDialog()
        return
    }

    # Win32: editable numeric values, no registry paths shown in UI.
    $f=New-Window "LARZONE // WIN32" 700 560
    Title $f "WIN32"
    $defs=@(
      @{Name="SystemResponsiveness";Default=10},
      @{Name="NetworkThrottlingIndex";Default=10},
      @{Name="GPU Priority";Default=8},
      @{Name="Priority";Default=6}
    )
    $boxes=@{}; $y=85
    foreach($x in $defs){
        $l=New-Object Windows.Forms.Label; $l.Text=$x.Name; $l.AutoSize=$true
        $l.Font=New-Object Drawing.Font("Segoe UI Semibold",11); $l.ForeColor=[Drawing.Color]::White
        $l.Location=New-Object Drawing.Point(45,$y); $f.Controls.Add($l)
        $b=New-Object Windows.Forms.TextBox; $b.Text=[string]$x.Default; $b.Font=New-Object Drawing.Font("Segoe UI",11)
        $b.Location=New-Object Drawing.Point(280,$y-5); $b.Size=New-Object Drawing.Size(180,35); $f.Controls.Add($b)
        $boxes[$x.Name]=$b; $y+=75
    }
    Btn $f "DEFAULT" 45 410 145 50 {foreach($x in $defs){$boxes[$x.Name].Text=[string]$x.Default}} | Out-Null
    Btn $f "APPLY" 205 410 145 50 {
        $v=@{}
        foreach($x in $defs){
            $n=0
            if(-not [int]::TryParse($boxes[$x.Name].Text,[ref]$n) -or $n -lt 0){Info "ค่า $($x.Name) ไม่ถูกต้อง";return}
            $v[$x.Name]=$n
        }
        New-Backup "WIN32"
        Dword "HKLM:\SOFTWARE\Microsoft\Windows NT\CurrentVersion\Multimedia\SystemProfile" "SystemResponsiveness" $v["SystemResponsiveness"]
        Dword "HKLM:\SOFTWARE\Microsoft\Windows NT\CurrentVersion\Multimedia\SystemProfile" "NetworkThrottlingIndex" $v["NetworkThrottlingIndex"]
        Dword "HKLM:\SOFTWARE\Microsoft\Windows NT\CurrentVersion\Multimedia\SystemProfile\Tasks\Games" "GPU Priority" $v["GPU Priority"]
        Dword "HKLM:\SOFTWARE\Microsoft\Windows NT\CurrentVersion\Multimedia\SystemProfile\Tasks\Games" "Priority" $v["Priority"]
        Add-SystemNote "Win32 → Applied"
        Info "Win32 Apply สำเร็จ"
    } | Out-Null
    Btn $f "BACK" 365 410 145 50 {$f.Close()} | Out-Null
    [void]$f.ShowDialog()
}

