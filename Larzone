  $x=(Read-Host "เลือก").ToUpper();if($x-eq"B"){return};if($x-eq"0"){exit}
  switch($x){
   "1"{netsh int tcp set global autotuninglevel=normal|Out-Null;Write-Host "✓ TCP Auto-Tuning = Normal" -f Green;P}
